---
import Analytics from '@vercel/analytics/astro';
import GlobalNav from '../components/GlobalNav.astro';

const title = 'Where GTM work is going — Kyle Findlay';
const description = 'A verified-source map of where go-to-market work is going, across three waves: documented, in motion, and predicted. Federal, university, and industry data; every claim dated and graded. Second deep-dive cluster of the Workforce Transformation Index.';

const badgeClass = (k: string) => (({
  'FEDERAL': 'solid', 'UNIVERSITY': 'solid', 'INTL ORG': 'solid',
  'INDUSTRY': 'outline', 'PRESS': 'outline',
  'COMPANY-REPORTED': 'dashed', 'OWN-AGENT DATA': 'dashed',
} as Record<string, string>)[k] || 'outline');

const leftNodes = ['SDR / BDR', 'Junior demand gen', 'Sales ops (reporting)', 'Reactive customer success'];
const rightNodes = ['GTM Engineer', 'Account Executive', 'RevOps architect', 'Forward deployed / implementation', 'AI-enablement marketing'];

// ══ WAVE 1 · Documented ══
const wave1 = [
  { id: 1, from: 'SDR', to: 'GTM Engineer', li: 0, ri: 0, w: 1.0,
    takeaway: 'Junior sending compresses; system-builders absorb.',
    chip: { num: '−3.8%/yr', cap: '22–25 in AI-exposed jobs · Stanford ADP' },
    why: `ADP payroll data covering millions of records, analyzed by Stanford's Digital Economy Lab, shows workers 22–25 in the most AI-exposed occupations shrinking at 3.8% per year as of April 2026 — while the least-exposed jobs for the same age group grow at 2% annually. Across all ages, the most-exposed occupations contracted just 0.2%: the org reshapes more than it shrinks. Indeed's postings data shows the same shape from a different angle — 71% of the past year's growth in software-development postings came from senior roles, and 37% from jobs with AI in the title. And in Emergence Capital's survey of 560+ B2B software companies, 36% cut SDR/BDR headcount in the past year — the highest reduction of any sales role — while only 19% grew.`,
    caveat: `Not all of it is AI: industry analyses note the SDR cuts concentrated where teams overbuilt in 2021–22, and Indeed notes exposed-occupation posting declines began before ChatGPT.`,
    crossing: `Proof you can build the machine, not just work inside it: a working Clay table, an agent, an automated pipeline with real output.`,
    read: `Your future GTM Engineer bench is sitting in today's SDR pools — the firms that build it first own the fees.`,
    sources: [
      { text: 'Stanford Digital Economy Lab, ADP payroll series (2026 update)', badge: 'UNIVERSITY' },
      { text: 'Indeed Hiring Lab, July 2026', badge: 'INDUSTRY' },
      { text: 'Emergence Capital survey of 560+ B2B software companies', badge: 'INDUSTRY' },
    ],
    /* RESTORE (pending verification): append to sources — { text: 'Forrester — AI SDR adoption >55% at 500+ employee firms', badge: 'INDUSTRY' } */ },
  { id: 2, from: 'SDR', to: 'Account Executive', li: 0, ri: 1, w: 0.34,
    takeaway: 'The path narrows; seniority wins the backfills.',
    chip: { num: '71%', cap: 'of posting growth is senior · Indeed' },
    why: `Still real, but narrowing. As AI absorbs top-of-funnel volume, fewer AE backfills open up, and the seniority shift shows up in the hiring data: where postings are growing again, senior roles are doing almost all of the work.`,
    crossing: `Consecutive quarters at quota and documented pipeline dollars, not activity counts.`,
    read: `Tenure and quota history predict AE success better than interview polish — screen on the record, not the performance.`,
    sources: [{ text: 'Indeed Hiring Lab, July 2026', badge: 'INDUSTRY' }],
    /* RESTORE (pending Bridge Group verification): append to why — Bridge Group promotion-timeline statistics (18–24 month median; sub-11-month promotions fail 55%) + source { text: 'Bridge Group promotion-timeline report', badge: 'INDUSTRY' } */ },
  { id: 3, from: 'Sales ops (reporting)', to: 'RevOps architect', li: 2, ri: 2, w: 0.22,
    takeaway: 'Reporting fades; system design pays.',
    why: `The remaining work is designing the revenue system: routing, territories, comp logic, tool selection. The same seniority shift visible in postings data — senior and system-design roles growing while junior execution roles compress — is the RevOps story in miniature.`,
    crossing: `Evidence of system design — a workflow you architected end to end, not reports you maintained.`,
    read: `RevOps searches are rising while the candidate pool with real system-design proof stays thin — a seller's market for whoever sources it.`,
    sources: [{ text: 'Indeed Hiring Lab, July 2026', badge: 'INDUSTRY' }, { text: 'Stanford 2026 AI Index', badge: 'UNIVERSITY' }] },
  { id: 4, from: 'Junior demand gen', to: 'AI-enablement marketing', li: 1, ri: 4, w: 0.42,
    takeaway: 'Generation is cheap; judgment gets paid.',
    chip: { num: '14–26%', cap: 'productivity gains, support & software · Stanford Index' },
    why: `Generation is cheap; judgment is not. Stanford's 2026 AI Index finds measured productivity gains of 14–26% concentrate in exactly the functions where entry-level employment is declining — the returns go to whoever directs the machine, not whoever it replaced.`,
    crossing: `A campaign where you directed AI production and can show the decisions you made.`,
    read: `Marketing leaders will pay for judgment layered on AI production — screen for candidates who can show the decisions, not the output.`,
    sources: [{ text: 'Stanford 2026 AI Index', badge: 'UNIVERSITY' }],
    /* RESTORE (pending mckinsey.com verification): append to why — " McKinsey's Global AI Survey puts AI content drafting at roughly 3.2x ROI — the highest-returning use case in the marketing stack — but returns concentrate where AI accelerates a human-led editorial process."; add source { text: 'McKinsey Global AI Survey', badge: 'INDUSTRY' } */ },
  { id: 5, from: 'Reactive CS', to: 'Forward deployed / implementation', li: 3, ri: 3, w: 0.6,
    caseChip: 'CASE STUDY · 2024→2025',
    takeaway: 'The routine layer moved; the human seat went upstream.',
    chip: { num: '2.3M', cap: 'AI conversations, month one · company-reported' },
    whyHtml: `Stanford's 2026 AI Index shows the customer-service pattern directly: entry-level employment falling while senior headcount grows. Klarna is the named arc inside that data. Its AI assistant handled 2.3 million conversations in its first month — work the company said equaled roughly 700 full-time agents <span class="mig-badge mig-badge--dashed">COMPANY-REPORTED</span>. Workforce fell from about 5,000 to 3,500, largely through attrition. Fifteen months later, CEO Sebastian Siemiatkowski told Bloomberg the company went too far — “We focused too much on cost. The result was lower quality” — and began rehiring humans in a hybrid model. The routine layer moved; the human seat went upstream.`,
    crossing: `An implementation you owned — a customer whose workflow you personally rebuilt.`,
    read: `Post-AI support orgs need forward-deployed hires that classic CS resumes don't surface — screen for owned implementations.`,
    sources: [{ text: 'Stanford 2026 AI Index', badge: 'UNIVERSITY' }, { text: 'Klarna announcement, Feb 2024', badge: 'COMPANY-REPORTED' }, { text: 'Siemiatkowski, Bloomberg, May 2025', badge: 'PRESS' }] },
];
const w1Disagreement = `Yale's Budget Lab, tracking CPS data through June 2026, finds no clear economy-wide AI footprint in the labor market. The Economic Innovation Group finds unemployment rose LESS for the most AI-exposed workers (+0.30pp) than the least (+0.94pp) from 2022 to early 2025. The surgical entry-level effect and the flat aggregate are both true — which is why this page maps seats, not the economy.`;
const w1DisagreementBadges = ['UNIVERSITY', 'INDUSTRY'];

// ══ WAVE 2 · In motion ══
const wave2MapL = ['Support & CS pools', 'SDR / junior GTM pools', 'Junior software', 'Marketing execution'];
const wave2MapR = ['Forward deployed / implementation', 'GTM Engineer / agent operations', 'Senior + AI-fluent engineering', 'AI-enablement marketing'];
const wave2 = [
  { id: 'm1', title: 'Agent capability crossing the line', takeaway: 'Agents crossed the capability line.',
    chip: { num: '66%', cap: 'of real-world computer tasks · Stanford Index' },
    body: `18 months ago, AI agents failed 88% of real-world computer tasks. As of March 2026, the best models complete 66% — within six points of human performance. The work that compresses next is whatever those agents can now finish.`,
    sources: [{ text: 'Stanford 2026 AI Index', badge: 'UNIVERSITY' }] },
  { id: 'm2', title: 'Firm adoption and stated intent', takeaway: 'Adoption is real, narrow, and accelerating.',
    chip: { num: '18%→22%', cap: 'firm AI use, next six months · Census BTOS' },
    body: `Census Bureau surveys of ~1.2 million businesses put AI use at 18% of firms in the Nov 2025–Feb 2026 supplement — 32% employment-weighted — with adoption expected to reach 22% within six months. Stanford's Index adds that executives expect entry-level headcount reductions to accelerate, with planned cuts outpacing recent ones.`,
    sources: [{ text: 'Census Bureau BTOS AI supplement, 2026', badge: 'FEDERAL' }, { text: 'Stanford 2026 AI Index', badge: 'UNIVERSITY' }] },
  { id: 'm3', title: 'Transitions don’t happen on their own', takeaway: 'Transitions don’t happen on their own.',
    body: `OECD's Employment Outlook 2026 finds that when technology shocks hit local labor markets, adjustment happens mostly through transitions into joblessness and openings filled by newcomers — not workers moving across sectors — leaving lasting scars for the displaced. The routing layer between compressing seats and absorbing seats does not build itself.`,
    sources: [{ text: 'OECD Employment Outlook 2026, July 2026', badge: 'INTL ORG' }] },
  { id: 'm4', title: 'Net-new seats: agent deployment, forward deployed, AI-enablement', takeaway: 'The signal shows up before the job post.',
    whatMoved: `Nothing yet — these seats are appearing, not absorbing.`,
    why: `Deploying agents inside a customer's workflow is high-touch work no existing title covers.`,
    crossing: `An owned implementation — a workflow you personally wired into a real organization.`,
    read: `These roles have no LinkedIn title history to source against. Screen for owned implementations, not titles.`,
    sourceHtml: `Surfaced by <a href="/radar-v2">GTM Radar v2</a> before they were posted: AI Agent Deployment Lead (Glean), Forward-Deployed Engineer EMEA (Sierra), Detection-to-GTM Liaison (Abnormal Security). Detected by the agent, dated, published.`,
    sourceBadge: 'OWN-AGENT DATA' },
];
const w2Disagreement = `Census data cuts both ways: most AI-adopting businesses report no change in worker numbers, and adoption remains narrow — 17–20% of firms through May 2026. The migration is real where it's real, and absent where it isn't.`;
const w2DisagreementBadges = ['FEDERAL'];

// ══ WAVE 3 · Predicted (ghost cards) ══
const seats = ['GTM Engineer', 'Mid-funnel seller', 'Account Executive', 'Agency recruiter', 'Support & CS pools', 'Junior software pools'];
const ghosts = [
  { id: 'g1', name: 'Revenue-systems owner?', takeaway: 'The seats that absorbed Wave 1 compress next.',
    why: `The seats that absorbed Wave 1 compress next. As agent fleets spread, the scarce hire becomes whoever makes them actually produce — the constraint won't be tools, it will be org design.`,
    crossing: `Run a fleet: own an agent system's output end to end, with numbers.`,
    change: `If by end of 2028, postings for GTM-engineering and agent-operations roles at AI-native startups aren't outnumbering SDR postings, this call was wrong.` },
  { id: 'g2', name: 'Agent-facing GTM?', takeaway: 'As buying agents proliferate, machine-legibility becomes a funded function.',
    why: `As buying agents proliferate, making your company legible to machines — machine-readable pricing, agent-ready product data, citation authority — becomes a funded function. Selling to machines becomes a job.`,
    crossing: `Ship one agent-legible surface for a real company and measure what changed.`,
    change: `If by 2028 no funded companies are posting agent-facing GTM or machine-readable-sales roles, kill this card.` },
  { id: 'g3', name: 'Proof-based placement?', takeaway: 'Referral networks hold the executive layer, where trust is the product.',
    why: `Referral networks hold the executive layer, where trust is the product. The volume layer shifts to whoever can verify capability — matching proof portfolios to problems, not titles to titles.`,
    crossing: `A portfolio of shipped work a recruiter can check in five minutes.`,
    change: `If title-based postings still dominate hiring volume through 2028 and proof-portfolio screening stays niche, this was my bias, not a trend.`,
    conflict: `Full disclosure: this is also Proofworks' bet. I'm talking my book — and saying so.` },
  { id: 'g4', name: 'Trust & accountability seats?', takeaway: 'The seats that stay human are the ones buyers already reserve for humans.',
    why: `The seats that stay human are the ones buyers already reserve for humans: accountability, trust, and system design. Klarna's reversal was the early sketch of this boundary.`,
    crossing: `A track record of owning outcomes a company would not hand to a machine.`,
    change: `If AE headcount at AI-native companies shrinks 2026–28 at the rate SDR headcount did in 2024–26, the human-seat thesis fails.` },
  { id: 'g5', name: 'Forward-deployed / AI implementation?', takeaway: 'Every AI-adopting company needs someone who rebuilds real workflows around the tools.',
    why: `Every AI-adopting company — in every industry, not just tech — needs someone who rebuilds real workflows around the tools. The Klarna pattern generalizes: the routine layer automates, and a human implementation seat opens upstream of it.`,
    crossing: `Owned implementations with before/after numbers, at companies that aren't software companies.`,
    change: `If by 2028 AI-implementation and forward-deployed roles aren't a standard posting category at non-tech companies adopting AI, this generalization failed.` },
  { id: 'g6', name: 'Agent operations?', takeaway: 'Stanford’s 2026 Index has agents completing 66% of real-world computer tasks.',
    why: `Stanford's 2026 Index has agents completing 66% of real-world computer tasks, within six points of human performance. Fleets of near-human agents create a new seat: the person who runs them — QA, escalation, throughput, cost — across support, sales, and back office at once.`,
    crossing: `Run an agent system in production and own its numbers.`,
    change: `If agent-operations / AI-operations titles aren't appearing across support, sales, AND back-office postings by 2028, the seat stayed hypothetical.` },
];
const w3Disagreement = `The counter-case: Apollo's Torsten Slok and Google economists attribute entry-level weakness to interest rates and a low-hire, low-fire market, not AI. If they're right, several of these ghosts never materialize. The data will decide, and this page will update either way.`;

// methodology legend
const legendChips = [
  { badge: 'FEDERAL', label: 'Census Bureau data' },
  { badge: 'UNIVERSITY', label: 'Stanford, Yale' },
  { badge: 'INTL ORG', label: 'OECD' },
  { badge: 'INDUSTRY', label: 'surveys & postings' },
  { badge: 'COMPANY-REPORTED', label: 'their numbers, flagged' },
];
const legendLines = [
  '2+ independent sources per claim, on different data types.',
  'Every claim dated. Every source named.',
  'Disagreement displayed, not buried.',
  'Predictions carry the condition that would kill them.',
];

// hero emitter / destination sets
const heroEmit = ['SDR / BDR', 'Junior demand gen', 'Sales ops', 'Reactive CS', 'Junior software'];
const heroDest = ['GTM Engineer', 'RevOps architect', 'Forward deployed', 'AI-enablement marketing'];

/* ═══ RESTORE BLOCK — pending Kyle's primary-source verification (source-only, non-rendering) ═══
   • Card 4 `why` append McKinsey 3.2x ROI + source McKinsey Global AI Survey [INDUSTRY]
   • Card 2 `why` append Bridge Group promotion-timeline (18–24mo median; sub-11-mo fail 55%) + source [INDUSTRY]
   • Card 1 `sources` append Forrester AI SDR adoption >55% [INDUSTRY]
   • Wave 3 optional "What the field forecasts" sub-block (Gartner / Forrester items), each pending verification
   ═══════════════════════════════════════════════════════════════════════════════════════════ */

// map geometry
const VB = { w: 1000, h: 520 };
const LX = 330, RX = 670, MIDX = 500;
const leftY = (i: number) => +(120 + i * ((VB.h - 170) / (leftNodes.length - 1))).toFixed(1);
const rightY = (j: number) => +(110 + j * ((VB.h - 170) / (rightNodes.length - 1))).toFixed(1);
const pathOf = (f: { li: number; ri: number }) => `M ${LX},${leftY(f.li)} C ${MIDX},${leftY(f.li)} ${MIDX},${rightY(f.ri)} ${RX},${rightY(f.ri)}`;
const y4 = (i: number) => +(130 + i * ((VB.h - 200) / 3)).toFixed(1);        // 4 nodes (wave 2 map)
const p4 = (i: number) => `M ${LX},${y4(i)} C ${MIDX},${y4(i)} ${MIDX},${y4(i)} ${RX},${y4(i)}`;
const y6 = (i: number) => +(100 + i * ((VB.h - 150) / 5)).toFixed(1);        // 6 nodes (wave 3 ghost map)
const p6 = (i: number) => `M ${LX},${y6(i)} C ${MIDX},${y6(i)} ${MIDX},${y6(i)} ${RX},${y6(i)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/gtm-migration" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-gtm-migration.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GTM Migration — Today's seats → Where did they go? A predicted map of where go-to-market work is going." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-gtm-migration.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root { --ink: #17223f; --navy: #0f1834; --mut: #58637f; --line: rgba(24,40,88,0.12); --blue: #4c7ef5; }
      html { scroll-behavior: smooth; scroll-padding-top: 70px; -webkit-text-size-adjust: 100%; }
      body { margin: 0; color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        background: linear-gradient(180deg, #eef4fd 0%, #e9eefb 60%, #ecebf9 100%); overflow-x: hidden; }
      a { color: inherit; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; margin: 0; color: var(--navy); }
      .col { max-width: 1000px; margin: 0 auto; padding: 0 24px; width: 100%; }

      .mig-top { padding: 48px 0 4px; }
      .mig-h1 { font-size: clamp(2rem, 4.6vw, 3.1rem); line-height: 1.05; }
      .mig-stamp { font-family: 'JetBrains Mono', monospace; font-size: clamp(11px, 1.2vw, 12.5px); line-height: 1.5; color: var(--mut); margin: 12px 0 0; max-width: 70ch; }
      .mig-sub { font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.45; color: var(--mut); font-weight: 500; margin: 12px 0 0; max-width: 46ch; }
      .mig { padding-bottom: 90px; }

      /* ── HERO: the migration current (emitters/destinations live INSIDE the canvas box) ── */
      .mig-hero { position: relative; height: clamp(212px, 27vh, 262px); margin: 20px 0 0; border-radius: 16px; overflow: hidden;
        background: radial-gradient(60% 90% at 50% 46%, rgba(123,108,240,0.09), transparent 72%); border: 1px solid var(--line); }
      #mig-field { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
      .mig-ruler { position: absolute; top: 8px; left: 15%; right: 15%; z-index: 1; display: flex; pointer-events: none; }
      .mig-ruler-seg { flex: 1; text-align: center; font-family: 'JetBrains Mono', monospace; font-size: clamp(9.5px, 1.05vw, 11.5px); letter-spacing: .1em; color: rgba(15,24,52,0.72); }
      .mig-emit { position: absolute; left: 16px; top: 34px; bottom: 26px; z-index: 1; display: flex; flex-direction: column; justify-content: space-around; align-items: flex-start; }
      .mig-emit span { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(10px, 1.1vw, 12.5px); color: var(--ink); white-space: nowrap; }
      .mig-dest { position: absolute; right: 16px; top: 34px; bottom: 26px; z-index: 1; display: flex; flex-direction: column; justify-content: space-around; align-items: flex-end; text-align: right; }
      .mig-dest span { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(10px, 1.1vw, 12.5px); color: var(--navy); white-space: nowrap; }
      .mig-dest .gh { color: rgba(88,99,127,0.55); font-weight: 500; }
      .mig-stall { position: absolute; right: 16px; bottom: 6px; z-index: 1; font-family: 'JetBrains Mono', monospace; font-size: clamp(8.5px, 0.95vw, 10px); color: rgba(88,99,127,0.72); max-width: 58%; text-align: right; line-height: 1.3; }
      @media (max-width: 620px) { .mig-emit span.mig-emit-hide, .mig-dest span.mig-dest-hide { display: none; } }

      /* ── source badges ── */
      .mig-badge { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 9.5px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; padding: 2px 6px; border-radius: 5px; line-height: 1.35; vertical-align: 1px; white-space: nowrap; }
      .mig-badge--solid { background: var(--navy); color: #fff; border: 1px solid var(--navy); }
      .mig-badge--outline { background: transparent; color: var(--navy); border: 1px solid rgba(24,40,88,0.38); }
      .mig-badge--dashed { background: transparent; color: var(--mut); border: 1px dashed rgba(24,40,88,0.42); }
      .mig-casechip { margin-left: 10px; vertical-align: 2px; }

      /* ── tabs ── */
      .mig-tabs { display: flex; gap: 6px; margin: 24px 0 0; }
      .mig-tab { flex: 1 1 0; min-width: 0; cursor: pointer; font: inherit; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 2px;
        background: rgba(255,255,255,0.5); border: 1px solid var(--line); border-radius: 12px; padding: 11px 8px; transition: border-color .16s ease, background-color .16s ease; }
      .mig-tab-yr { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(13px, 1.7vw, 15.5px); letter-spacing: -0.01em; color: var(--navy); white-space: nowrap; }
      .mig-tab-ep { font-family: 'JetBrains Mono', monospace; font-size: clamp(10.5px, 1.3vw, 12px); letter-spacing: .02em; color: var(--mut); line-height: 1.25; }
      .mig-tab[aria-selected='true'] { border-color: var(--blue); background: rgba(76,126,245,0.10); }
      .mig-tab[aria-selected='true'] .mig-tab-ep { color: var(--blue); }
      .mig-tab:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

      .mig-wave[hidden] { display: none; }
      .mig-wave-h { font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.08; margin: 34px 0 0; }
      .mig-wave-intro { font-size: clamp(1.02rem, 1.5vw, 1.2rem); line-height: 1.5; color: var(--ink); font-weight: 500; margin: 14px 0 0; max-width: 62ch; }

      /* ── node map ── */
      .mig-map { display: none; margin: 30px 0 8px; }
      .mig-svg { width: 100%; max-width: 940px; height: auto; display: block; margin: 0 auto; overflow: visible; }
      .mig-colh { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; fill: var(--mut); }
      .mig-link { fill: none; stroke: rgba(76,126,245,0.30); stroke-width: var(--sw); stroke-linecap: round; transition: stroke .18s ease; }
      .mig-link.on { stroke: rgba(76,126,245,0.9); }
      .mig-hit { fill: none; stroke: transparent; stroke-width: 26; cursor: pointer; }
      .mig-dot { fill: #7ea0f5; } .mig-dot.r { fill: #8b6cf0; }
      .mig-node { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; fill: var(--ink); }
      .mig-node.ghost { fill: var(--mut); }
      .mig-w2dash { fill: none; stroke: rgba(76,126,245,0.5); stroke-width: 3; stroke-dasharray: 5 6; stroke-linecap: round; }
      .mig-w2solid { fill: none; stroke: rgba(76,126,245,0.85); stroke-width: 3; stroke-linecap: round; }
      .mig-ghostlink { fill: none; stroke: rgba(88,99,127,0.5); stroke-width: 2; stroke-dasharray: 5 6; stroke-linecap: round; }
      .mig-dot.g { fill: none; stroke: var(--mut); stroke-width: 1.4; stroke-dasharray: 3 3; }
      .mig-maphint { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--mut); text-align: center; margin: 10px 0 0; }
      .mig-mapcap { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.55; color: var(--mut); text-align: center; margin: 10px auto 0; max-width: 66ch; }

      /* ── cards (scannable collapsed state) ── */
      .mig-recruit { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(14px, 1.5vw, 16px); color: var(--navy); margin: 26px 0 0; max-width: 68ch; }
      .mig-list { margin: 22px 0 0; display: flex; flex-direction: column; gap: 12px; }
      .mig-flow { border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,0.58); overflow: hidden; }
      .mig-flow.open { border-color: rgba(76,126,245,0.5); }
      .mig-flow.ghost { border-style: dashed; border-color: rgba(88,99,127,0.45); background: rgba(255,255,255,0.4); }
      .mig-flow.ghost.open { border-color: rgba(88,99,127,0.7); }
      .mig-head { display: block; width: 100%; background: none; border: 0; cursor: pointer; text-align: left; padding: 16px 20px; font: inherit; color: var(--ink); }
      .mig-head-top { display: flex; align-items: center; gap: 14px; }
      .mig-ft { flex: 1 1 auto; min-width: 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(15px, 2.1vw, 18px); letter-spacing: -0.01em; color: var(--navy); }
      .mig-ft .mig-arw { color: var(--blue); margin: 0 4px; font-weight: 500; }
      .mig-ghost .mig-ft { color: var(--mut); }
      .mig-wt { flex: 0 0 auto; width: clamp(48px, 16vw, 110px); height: 6px; border-radius: 999px; background: rgba(24,40,88,0.09); overflow: hidden; }
      .mig-wt-bar { display: block; height: 100%; width: calc(var(--w) * 1%); border-radius: 999px; background: var(--blue); }
      .mig-chev { flex: 0 0 auto; font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 22px; line-height: 1; color: var(--mut); transition: transform .2s ease; }
      .mig-flow.open .mig-chev { transform: rotate(45deg); }
      .mig-takeaway { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(15px, 1.6vw, 17px); line-height: 1.35; color: var(--navy); margin: 8px 0 0; max-width: 56ch; }
      .mig-chip { display: inline-flex; flex-direction: column; margin: 12px 0 0; }
      .mig-chip-num { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(22px, 3vw, 30px); line-height: 1; letter-spacing: -0.02em; color: var(--navy); }
      .mig-chip-cap { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .02em; color: var(--mut); margin-top: 5px; }
      .mig-detail { padding: 4px 20px 22px; }
      .mig-detail[hidden] { display: none; }
      .mig-field { margin: 16px 0 0; }
      .mig-lbl { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--navy); margin: 0 0 5px; }
      .mig-txt { font-size: clamp(15px, 1.4vw, 16.5px); line-height: 1.55; color: var(--ink); margin: 0; max-width: 66ch; }
      .mig-read { font-weight: 600; color: var(--navy); }
      .mig-caveat-line { font-size: 14px; line-height: 1.5; color: var(--ink); opacity: 0.9; margin: 8px 0 0; max-width: 66ch; }
      .mig-txt a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
      .mig-conflict { font-size: 14px; line-height: 1.5; color: var(--ink); opacity: 0.9; margin: 14px 0 0; max-width: 66ch; padding-left: 12px; border-left: 2px solid rgba(88,99,127,0.45); }
      .mig-cred { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: .04em; color: var(--mut); margin: 16px 0 0; }
      .mig-src { font-size: 12px; line-height: 1.9; color: var(--ink); margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--line); }
      .mig-src .mig-src-lbl { font-family: 'JetBrains Mono', monospace; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; font-size: 10.5px; color: var(--navy); margin-right: 4px; }
      .mig-src a { color: var(--blue); text-decoration: underline; text-underline-offset: 2px; }
      .mig-src-sep { color: rgba(24,40,88,0.3); }

      .mig-advance { display: inline-block; margin: 28px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; color: var(--blue); text-decoration: none; }
      .mig-advance:hover { text-decoration: underline; text-underline-offset: 3px; }

      .mig-dissent { margin: 26px 0 0; border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,0.4); }
      .mig-dissent > summary { list-style: none; cursor: pointer; padding: 14px 18px; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14.5px; color: var(--navy); display: flex; align-items: center; gap: 8px; }
      .mig-dissent > summary::-webkit-details-marker { display: none; }
      .mig-dissent > summary::before { content: '+'; color: var(--mut); font-size: 18px; line-height: 1; }
      .mig-dissent[open] > summary::before { content: '–'; }
      .mig-dissent-body { padding: 0 18px 18px; font-size: 14.5px; line-height: 1.55; color: var(--ink); max-width: 70ch; }

      .mig-weightcap { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.6; color: var(--mut); margin: 24px 0 0; }

      /* ── methodology legend + stamp ── */
      .mig-method { margin: 54px 0 0; padding-top: 40px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 34px; align-items: start; }
      .mig-method-h { font-size: clamp(1.3rem, 2.2vw, 1.75rem); line-height: 1.1; }
      .mig-legend-chips { display: flex; flex-wrap: wrap; gap: 10px 16px; margin: 18px 0 0; }
      .mig-legend-chip { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--ink); }
      .mig-legend-lines { margin: 20px 0 0; display: flex; flex-direction: column; gap: 8px; }
      .mig-legend-line { display: flex; align-items: baseline; gap: 10px; font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(14px, 1.4vw, 15.5px); color: var(--navy); }
      .mig-legend-line::before { content: '·'; color: var(--blue); font-weight: 700; }
      .mig-stampmark { justify-self: end; align-self: center; transform: rotate(-4.5deg); border: 2px solid var(--navy); border-radius: 8px; padding: 10px 16px; text-align: center; color: var(--navy); }
      .mig-stampmark-1 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(20px, 2.6vw, 30px); letter-spacing: .02em; line-height: 1; }
      .mig-stampmark-2 { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; letter-spacing: .04em; color: var(--mut); margin-top: 6px; }
      .mig-foot { grid-column: 1 / -1; margin: 30px 0 0; font-size: clamp(1rem, 1.4vw, 1.1rem); line-height: 1.55; color: var(--mut); font-weight: 500; max-width: 62ch; }
      @media (max-width: 720px) { .mig-method { grid-template-columns: 1fr; gap: 24px; } .mig-stampmark { justify-self: start; } }

      @media (min-width: 760px) { .mig-map { display: block; } }
      @media (prefers-reduced-motion: reduce) { .mig-chev, .mig-link, .mig-tab { transition: none; } html { scroll-behavior: auto; } }
    </style>
    <Analytics />
  </head>
  <body>
    <GlobalNav />

    <main class="mig">
      <header class="mig-top col">
        <h1 class="mig-h1">Where GTM work is going.</h1>
        <p class="mig-stamp">Updated July 2026 · Federal, university, and industry sources · every claim dated and graded · human-verified before publish</p>
        <p class="mig-sub">Job titles are lagging indicators — twice. Where GTM work went, where it’s going, and what’s left for humans when it does.</p>
      </header>

      <div class="col">
        <!-- HERO: the migration current -->
        <div class="mig-hero">
          <canvas id="mig-field"></canvas>
          <div class="mig-ruler" aria-hidden="true">
            <span class="mig-ruler-seg">2024–26</span>
            <span class="mig-ruler-seg">2026–28</span>
            <span class="mig-ruler-seg">2028–30</span>
          </div>
          <div class="mig-emit">
            {heroEmit.map((w, i) => (<span class={i === 1 || i === 2 ? 'mig-emit-hide' : ''}>{w}</span>))}
          </div>
          <div class="mig-dest">
            {heroDest.map((d, i) => (<span class={i >= 2 ? 'mig-dest-hide' : ''}>{d}</span>))}
            <span class="gh">?</span><span class="gh mig-dest-hide">?</span>
          </div>
          <p class="mig-stall">stalled — transitions don’t happen on their own · OECD 2026</p>
        </div>

        <!-- WAVE TOGGLE -->
        <div class="mig-tabs" role="tablist" aria-label="Migration waves">
          <button class="mig-tab" role="tab" data-wave="w1" aria-selected="true"><span class="mig-tab-yr">2024–26</span><span class="mig-tab-ep">· Documented</span></button>
          <button class="mig-tab" role="tab" data-wave="w2" aria-selected="false"><span class="mig-tab-yr">2026–28</span><span class="mig-tab-ep">· In motion</span></button>
          <button class="mig-tab" role="tab" data-wave="w3" aria-selected="false"><span class="mig-tab-yr">2028–30</span><span class="mig-tab-ep">· Predicted</span></button>
        </div>

        <!-- ══ WAVE 1 ══ -->
        <section class="mig-wave" data-wave="w1" role="tabpanel">
          <h2 class="mig-wave-h">2024–26 · Documented</h2>
          <p class="mig-wave-intro">This wave already happened. It’s documented here because a map you can check is the only kind worth trusting forward.</p>

          <div class="mig-map">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Migration flows from compressing roles to absorbing roles">
              <text class="mig-colh" x={LX - 16} y="44" text-anchor="end">Compressing</text>
              <text class="mig-colh" x={RX + 16} y="44" text-anchor="start">Absorbing</text>
              {wave1.map((f) => (<path class="mig-link" data-flow={f.id} style={`--sw:${(f.w * 16).toFixed(1)}`} d={pathOf(f)} />))}
              {wave1.map((f) => (<path class="mig-hit" data-flow={f.id} d={pathOf(f)} aria-label={`${f.from} to ${f.to}`} />))}
              {leftNodes.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={leftY(i)} r="4" /><text class="mig-node" x={LX - 14} y={leftY(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {rightNodes.map((n, j) => (<><circle class="mig-dot r" cx={RX} cy={rightY(j)} r="4" /><text class="mig-node" x={RX + 14} y={rightY(j)} text-anchor="start" dominant-baseline="central">{n}</text></>))}
            </svg>
            <p class="mig-maphint">Click a flow to open its detail below · thicker line = bigger shift</p>
          </div>

          <div class="mig-list">
            {wave1.map((f) => (
              <article class="mig-flow" data-flow={f.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w1-${f.id}`}>
                  <span class="mig-head-top">
                    <span class="mig-ft"><b>{f.from}</b> <span class="mig-arw" aria-hidden="true">→</span> <b>{f.to}</b>{f.caseChip && <span class="mig-badge mig-badge--outline mig-casechip">{f.caseChip}</span>}</span>
                    <span class="mig-wt" aria-hidden="true"><span class="mig-wt-bar" style={`--w:${Math.round(f.w * 100)}`}></span></span>
                    <span class="mig-chev" aria-hidden="true">+</span>
                  </span>
                  <span class="mig-takeaway">{f.takeaway}</span>
                  {f.chip && <span class="mig-chip"><span class="mig-chip-num">{f.chip.num}</span><span class="mig-chip-cap">{f.chip.cap}</span></span>}
                </button>
                <div class="mig-detail" id={`w1-${f.id}`} hidden>
                  <div class="mig-field"><p class="mig-lbl">Why</p>{f.whyHtml ? <p class="mig-txt" set:html={f.whyHtml} /> : <p class="mig-txt">{f.why}</p>}{f.caveat && <p class="mig-caveat-line">{f.caveat}</p>}</div>
                  <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{f.crossing}</p></div>
                  <div class="mig-field"><p class="mig-lbl">Recruiter read</p><p class="mig-txt mig-read">{f.read}</p></div>
                  <p class="mig-src"><span class="mig-src-lbl">Sources:</span>{f.sources.map((s, i) => (<>{i > 0 && <span class="mig-src-sep"> · </span>}{s.text} <span class={`mig-badge mig-badge--${badgeClass(s.badge)}`}>{s.badge}</span></>))}</p>
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w1Disagreement} {w1DisagreementBadges.map((b) => (<span class={`mig-badge mig-badge--${badgeClass(b)}`}>{b}</span>))}</div></details>
          <p class="mig-weightcap">Flow weight = sourced judgment about magnitude and direction — not measured headcount.</p>
          <a class="mig-advance" href="#" data-goto="w2">What compresses next →</a>
        </section>

        <!-- ══ WAVE 2 ══ -->
        <section class="mig-wave" data-wave="w2" role="tabpanel" hidden>
          <h2 class="mig-wave-h">2026–28 · In motion</h2>
          <p class="mig-wave-intro">The absorbing seats compress next. Agent platforms productize the GTM Engineer build; agentic selling absorbs SMB deal work. Judgment concentrates in fewer, more senior seats.</p>

          <div class="mig-map">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="In-motion flows, solid at origin dissolving to dashed">
              <text class="mig-colh" x={LX - 16} y="60" text-anchor="end">Compressing next</text>
              <text class="mig-colh" x={RX + 16} y="60" text-anchor="start">Absorbing</text>
              {wave2.map((c, i) => (<><path class="mig-w2dash" d={p4(i)} /><path class="mig-w2solid" d={p4(i)} pathLength="100" style="stroke-dasharray: 50 100" /></>))}
              {wave2.map((c, i) => (<path class="mig-hit" data-flow={c.id} d={p4(i)} />))}
              {wave2MapL.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={y4(i)} r="4" /><text class="mig-node" x={LX - 14} y={y4(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {wave2MapR.map((n, i) => (<><circle class="mig-dot r" cx={RX} cy={y4(i)} r="4" /><text class="mig-node" x={RX + 14} y={y4(i)} text-anchor="start" dominant-baseline="central">{n}</text></>))}
            </svg>
            <p class="mig-mapcap">In motion: solid where it starts, dashed where it’s heading. No weights — direction is documented, magnitude isn’t yet.</p>
          </div>

          <div class="mig-list">
            {wave2.map((c) => (
              <article class="mig-flow" data-flow={c.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w2-${c.id}`}>
                  <span class="mig-head-top"><span class="mig-ft">{c.title}</span><span class="mig-chev" aria-hidden="true">+</span></span>
                  <span class="mig-takeaway">{c.takeaway}</span>
                  {c.chip && <span class="mig-chip"><span class="mig-chip-num">{c.chip.num}</span><span class="mig-chip-cap">{c.chip.cap}</span></span>}
                </button>
                <div class="mig-detail" id={`w2-${c.id}`} hidden>
                  {c.body ? (<p class="mig-txt">{c.body}</p>) : (<>
                    <div class="mig-field"><p class="mig-lbl">What moved</p><p class="mig-txt">{c.whatMoved}</p></div>
                    <div class="mig-field"><p class="mig-lbl">Why</p><p class="mig-txt">{c.why}</p></div>
                    <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{c.crossing}</p></div>
                    <div class="mig-field"><p class="mig-lbl">Recruiter read</p><p class="mig-txt mig-read">{c.read}</p></div>
                  </>)}
                  {c.sources && <p class="mig-src"><span class="mig-src-lbl">Sources:</span>{c.sources.map((s, i) => (<>{i > 0 && <span class="mig-src-sep"> · </span>}{s.text} <span class={`mig-badge mig-badge--${badgeClass(s.badge)}`}>{s.badge}</span></>))}</p>}
                  {c.sourceHtml && <p class="mig-src"><span class="mig-src-lbl">Sources:</span><span set:html={c.sourceHtml} /> <span class={`mig-badge mig-badge--${badgeClass(c.sourceBadge)}`}>{c.sourceBadge}</span></p>}
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w2Disagreement} {w2DisagreementBadges.map((b) => (<span class={`mig-badge mig-badge--${badgeClass(b)}`}>{b}</span>))}</div></details>
          <a class="mig-advance" href="#" data-goto="w3">Where it ends up →</a>
        </section>

        <!-- ══ WAVE 3 · ghost cards ══ -->
        <section class="mig-wave" data-wave="w3" role="tabpanel" hidden>
          <h2 class="mig-wave-h">2028–30 · Predicted</h2>

          <div class="mig-map">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Predicted destinations for today's seats">
              <text class="mig-colh" x={LX - 16} y="62" text-anchor="end">Today’s seats</text>
              <text class="mig-colh" x={RX + 16} y="62" text-anchor="start">Where they go?</text>
              {ghosts.map((g, i) => (<path class="mig-ghostlink" d={p6(i)} />))}
              {seats.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={y6(i)} r="4" /><text class="mig-node" x={LX - 14} y={y6(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {ghosts.map((g, i) => (<><circle class="mig-dot g" cx={RX} cy={y6(i)} r="4.5" /><text class="mig-node ghost" x={RX + 14} y={y6(i)} text-anchor="start" dominant-baseline="central">{g.name}</text></>))}
            </svg>
            <p class="mig-mapcap">Direction, not magnitude. The compressing seats are known. The destinations are categories, not titles.</p>
          </div>

          <p class="mig-recruit">For a recruiting firm, every ghost card is a future placement category — this is a map of where the fees migrate.</p>

          <div class="mig-list">
            {ghosts.map((g) => (
              <article class="mig-flow ghost" data-flow={g.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w3-${g.id}`}>
                  <span class="mig-head-top"><span class="mig-ft">{g.name}</span><span class="mig-chev" aria-hidden="true">+</span></span>
                  <span class="mig-takeaway">{g.takeaway}</span>
                </button>
                <div class="mig-detail" id={`w3-${g.id}`} hidden>
                  <div class="mig-field"><p class="mig-lbl">Why I expect this</p><p class="mig-txt">{g.why}</p></div>
                  <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{g.crossing}</p></div>
                  <div class="mig-field"><p class="mig-lbl">What would change my mind</p><p class="mig-txt">{g.change}</p></div>
                  {g.conflict && <p class="mig-conflict">{g.conflict}</p>}
                  <p class="mig-cred">Prediction · Kyle Findlay · July 2026</p>
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w3Disagreement}</div></details>
          <a class="mig-advance" href="#" data-goto="w1">Back to what’s documented →</a>
        </section>

        <!-- ALWAYS VISIBLE — methodology legend + slop-free stamp -->
        <section class="mig-method">
          <div>
            <h2 class="mig-method-h">Sourced. Graded. Checkable.</h2>
            <div class="mig-legend-chips">
              {legendChips.map((c) => (<span class="mig-legend-chip"><span class={`mig-badge mig-badge--${badgeClass(c.badge)}`}>{c.badge}</span>{c.label}</span>))}
            </div>
            <div class="mig-legend-lines">
              {legendLines.map((l) => (<span class="mig-legend-line">{l}</span>))}
            </div>
          </div>
          <div class="mig-stampmark" aria-hidden="true">
            <div class="mig-stampmark-1">AI-SLOP-FREE</div>
            <div class="mig-stampmark-2">every claim named, dated, human-checked</div>
          </div>
          <p class="mig-foot">This map is the second deep-dive cluster of the Workforce Transformation Index. The method: public signals, sourced claims, human judgment — the same way I'd run it for a client.</p>
        </section>
      </div>
    </main>

    <script>
      (() => {
        const root = document.querySelector('.mig');
        if (!root) return;
        // ── wave toggle ──
        const tabs = [...root.querySelectorAll('.mig-tab')];
        const waves = [...root.querySelectorAll('.mig-wave')];
        function showWave(id) {
          tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.wave === id ? 'true' : 'false'));
          waves.forEach((w) => { w.hidden = w.dataset.wave !== id; });
        }
        tabs.forEach((t) => t.addEventListener('click', () => showWave(t.dataset.wave)));
        root.querySelectorAll('.mig-advance').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); showWave(a.dataset.goto); }));
        // ── card expand + map click ──
        const cards = [...root.querySelectorAll('.mig-flow')];
        const links = [...root.querySelectorAll('.mig-link')];
        const setActive = (id) => links.forEach((l) => l.classList.toggle('on', l.dataset.flow === String(id)));
        function toggle(card, force) {
          const head = card.querySelector('.mig-head');
          const det = card.querySelector('.mig-detail');
          const open = force !== undefined ? force : det.hidden;
          det.hidden = !open;
          head.setAttribute('aria-expanded', open ? 'true' : 'false');
          card.classList.toggle('open', open);
          if (open) setActive(card.dataset.flow);
        }
        cards.forEach((card) => card.querySelector('.mig-head').addEventListener('click', () => toggle(card)));
        [...root.querySelectorAll('.mig-hit')].forEach((h) => {
          h.addEventListener('mouseenter', () => setActive(h.dataset.flow));
          h.addEventListener('click', () => {
            const card = cards.find((c) => c.dataset.flow === h.dataset.flow);
            if (!card) return; toggle(card, true); card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      })();

      // ── HERO: "the migration current" (word-anchored emitters → zones → destinations + stall pool) ──
      (() => {
        const cv = document.getElementById('mig-field');
        if (!(cv instanceof HTMLCanvasElement)) return;
        const ctx = cv.getContext('2d');
        if (!ctx) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let W = 0, H = 0, DPR = 1, emit = [], dest = [], stall = { x: 0, y: 0 }, zoneX = [0, 0], fieldTop = 30, fieldBot = 0, parts = [], raf = 0;
        function rectIn(el) { const r = el.getBoundingClientRect(), h = cv.getBoundingClientRect(); return { x: r.right - h.left, y: r.top + r.height / 2 - h.top, l: r.left - h.left }; }
        function measure() {
          // emitter origin = the RIGHT EDGE of each role word (words live inside the hero box)
          const es = [...document.querySelectorAll('.mig-emit span')].filter((e) => e.offsetParent !== null);
          emit = es.map((e) => { const b = rectIn(e); return { x: b.x + 3, y: b.y }; });
          if (!emit.length) emit = [{ x: W * 0.14, y: H * 0.45 }];
          // destinations = LEFT edge of each destination + ghost mark
          const ds = [...document.querySelectorAll('.mig-dest span')].filter((e) => e.offsetParent !== null);
          dest = ds.map((e) => { const b = rectIn(e); return { x: b.l - 4, y: b.y, ghost: e.classList.contains('gh') }; });
          if (!dest.length) dest = [{ x: W * 0.82, y: H * 0.45, ghost: false }];
          const st = document.querySelector('.mig-stall'); if (st) { const b = rectIn(st); stall = { x: b.l + 24, y: b.y }; } else stall = { x: W * 0.82, y: H * 0.9 };
          // zone boundaries align with the top ruler (15%…85%, thirds)
          zoneX = [W * 0.15 + (W * 0.70) / 3, W * 0.15 + (W * 0.70) * 2 / 3];
          fieldTop = 30; fieldBot = H - 20;
        }
        function reset(p, seed) {
          const e = emit[(Math.random() * emit.length) | 0];
          p.x = e.x + Math.random() * 2;
          p.y = e.y + (Math.random() - 0.5) * 8;
          const d = dest[(Math.random() * dest.length) | 0];
          p.tx = d.x; p.ty = d.y;
          p.sp = 0.5 + Math.random() * 0.7;
          p.s = 1.4 + Math.random() * 1.6;
          p.stall = Math.random() < 0.2;
          p.stalled = false; p.molt = 0; p.slow = 0; p.a = 0;
          if (seed) { p.x = e.x + Math.random() * (d.x - e.x); p.molt = p.x >= zoneX[1] ? 2 : p.x >= zoneX[0] ? 1 : 0; }
        }
        function build() {
          const total = W < 620 ? 90 : 150;
          parts = [];
          for (let i = 0; i < total; i++) { const p = {}; reset(p, true); parts.push(p); }
        }
        function draw(now) {
          now = now || performance.now();
          ctx.clearRect(0, 0, W, H);
          // zone tick lines dropping through the field
          ctx.strokeStyle = 'rgba(15,24,52,0.10)'; ctx.lineWidth = 1;
          for (const zx of zoneX) { ctx.beginPath(); ctx.moveTo(zx, fieldTop); ctx.lineTo(zx, fieldBot); ctx.stroke(); }
          for (const p of parts) {
            if (!reduce) {
              // molt at each tick boundary with a ~300ms drift-slowdown (not a hard stop)
              if (p.molt === 0 && p.x >= zoneX[0]) { p.molt = 1; p.slow = now + 300; }
              else if (p.molt === 1 && p.x >= zoneX[1]) { p.molt = 2; p.slow = now + 300; }
              const slowF = now < p.slow ? 0.28 : 1;
              if (p.stall && !p.stalled && p.x > zoneX[0] + Math.random() * 30) p.stalled = true;
              if (p.stalled) {
                p.x += (stall.x - p.x) * 0.03; p.y += (stall.y - p.y) * 0.05 + 0.3; p.a += 0.02;
                if (p.a > 1.3) reset(p, false);
              } else {
                p.x += p.sp * slowF; p.y += (p.ty - p.y) * 0.03;
                if (p.x > p.tx + 6) reset(p, false);
              }
            }
            const mode = p.stalled ? 3 : p.molt;
            const base = 0.16 + (p.s - 1.4) * 0.14;
            if (mode === 0) { ctx.fillStyle = `rgba(60,112,236,${Math.min(0.72, 0.44 + base)})`; ctx.fillRect(p.x, p.y, p.s, p.s); }
            else if (mode === 1) { ctx.strokeStyle = 'rgba(82,84,228,0.5)'; ctx.lineWidth = 1; ctx.strokeRect(p.x, p.y, p.s + 0.5, p.s + 0.5); }
            else if (mode === 2) { ctx.strokeStyle = 'rgba(140,106,243,0.3)'; ctx.lineWidth = 1; ctx.strokeRect(p.x, p.y, p.s + 0.5, p.s + 0.5); }
            else { ctx.fillStyle = `rgba(88,99,127,${Math.max(0, 0.35 * (1 - p.a / 1.3))})`; ctx.fillRect(p.x, p.y, p.s, p.s); }
          }
          if (!reduce) raf = requestAnimationFrame(draw);
        }
        function resize() {
          DPR = Math.min(window.devicePixelRatio || 1, 2);
          W = cv.clientWidth; H = cv.clientHeight;
          cv.width = Math.max(1, W * DPR); cv.height = Math.max(1, H * DPR);
          ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
          measure(); build();
        }
        resize();
        window.addEventListener('resize', () => { cancelAnimationFrame(raf); resize(); if (!reduce) raf = requestAnimationFrame(draw); });
        window.addEventListener('load', () => { measure(); build(); });
        if (reduce) draw(); else raf = requestAnimationFrame(draw);
      })();
    </script>
  </body>
</html>
