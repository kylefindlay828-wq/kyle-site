    <meta property="og:image:alt" content="Where GTM work is going — a sourced, graded, checkable map of where go-to-market work is heading. kylefindlay.xyz/gtm-migration" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-migration.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
