---
import Analytics from '@vercel/analytics/astro';
import GlobalNav from '../components/GlobalNav.astro';

const title = 'Where GTM work is going — Kyle Findlay';
const description = 'A migration map of go-to-market roles: which seats AI is compressing, which are absorbing the judgment that remains, and what it takes to cross. Second deep-dive cluster of the Workforce Transformation Index.';

const leftNodes = ['SDR / BDR', 'Junior demand gen', 'Sales ops (reporting)', 'Reactive customer success'];
const rightNodes = ['GTM Engineer', 'Account Executive', 'RevOps architect', 'Forward deployed / implementation', 'AI-enablement marketing'];

const flows = [
  {
    id: 1, from: 'SDR', to: 'GTM Engineer', li: 0, ri: 0, w: 1.0,
    whatMoved: 'List building, enrichment, sequencing, and first-touch personalization — now run by AI outbound tooling.',
    why: 'Companies deploying AI outbound need fewer people sending and more people designing, tuning, and QA-ing the system. Net SDR headcount in US B2B SaaS fell 18% year over year — but junior roles fell 31% while senior and sender-ops roles grew. The org reshapes more than it shrinks.',
    crossing: 'Proof you can build the machine, not just work inside it: a working Clay table, an agent, an automated pipeline with real output.',
    read: 'Your future GTM Engineer bench is sitting in today\'s SDR pools — the firms that build it first own the fees.',
    sourced: '[CITE — Bridge Group SDR Metrics 2026 (18% / 31% figures); Emergence Capital survey of 560+ B2B software companies (36% cut SDR/BDR headcount, only 19% grew); Forrester B2B Sales Automation Landscape Q1 2026 (AI SDR adoption past 55% at 500+ employee companies)]',
  },
  {
    id: 2, from: 'SDR', to: 'Account Executive', li: 0, ri: 1, w: 0.55,
    whatMoved: 'The classic promotion path. Qualification and discovery skills carry over; closing is learned in-seat.',
    why: 'Still real, but narrowing — fewer AE backfills and more external AE candidates have stretched the median timeline toward 18 months. Promotions before 11 months of tenure fail over half the time; internal moves outperform external jumps.',
    crossing: 'Consecutive quarters at quota and documented pipeline dollars, not activity counts.',
    read: 'The internal-promotion data is a screening tool: tenure and quota history predict AE success better than interview polish.',
    sourced: '[CITE — Bridge Group promotion-timeline data (18–24 month median, 12–15 top quartile) and Bridge Group study of ~205 promoted reps (26% internal vs 41% external failure; sub-11-month promotions fail 55%)]',
  },
  {
    id: 3, from: 'Sales ops (reporting)', to: 'RevOps architect', li: 2, ri: 2, w: 0.5,
    whatMoved: 'Dashboarding, forecast roll-ups, and CRM hygiene — increasingly automated at AI-adopting companies. Look at what they post instead.',
    why: 'The remaining work is designing the revenue system: routing, territories, comp logic, tool selection. The same headcount data that shows junior SDR roles shrinking shows RevOps and sender-ops roles growing.',
    crossing: 'Evidence of system design — a workflow you architected end to end, not reports you maintained.',
    read: 'RevOps searches are rising while the candidate pool with real system-design proof stays thin — a seller\'s market for whoever sources it.',
    sourced: '[CITE — Bridge Group SDR Metrics 2026 (RevOps/sender-ops role growth); 2–3 live job postings for GTM-operations / agent-development-type roles, quoted and linked — I will supply these]',
  },
  {
    id: 4, from: 'Junior demand gen', to: 'AI-enablement marketing', li: 1, ri: 4, w: 0.62,
    whatMoved: 'Copy variants, A/B execution, campaign assembly — the production layer.',
    why: 'Generation is cheap; judgment is not. 87% of marketers now use generative AI in at least one workflow, and content creation is the top use case — but returns concentrate where AI accelerates a human-led editorial process, and platforms down-rank pure AI production.',
    crossing: 'A campaign where you directed AI production and can show the decisions you made.',
    read: 'Marketing leaders will pay for judgment layered on AI production — screen for candidates who can show the decisions, not the output.',
    sourced: '[CITE — Salesforce State of Marketing 2026 (87%, up from 51% in 2024); McKinsey Global AI Survey (≈3.2x ROI on AI content drafting within human-led process)]',
  },
  {
    id: 5, from: 'Reactive CS', to: 'Forward deployed / implementation', li: 3, ri: 3, w: 0.82,
    whatMoved: 'Ticket triage and first-line answers — absorbed by AI support at scale.',
    why: 'Klarna reported its AI assistant handled 2.3M conversations in its first month — two-thirds of support chats, the equivalent of ~700 agents by its own estimate. Fifteen months later its CEO said the cost-cutting went too far and rehired humans for what requires judgment. The routine layer moved; the human seat went upstream.',
    crossing: 'An implementation you owned — a customer whose workflow you personally rebuilt.',
    read: 'Post-AI support orgs need forward-deployed hires that classic CS resumes don\'t surface — screen for owned implementations.',
    sourced: '[CITE — Klarna / OpenAI announcement, February 2024; Siemiatkowski interview, Bloomberg, May 2025. Note in citation: the 700-agent figure is company-reported, and headcount decline came largely through attrition]',
  },
];

const predictions = [
  'By mid-2027, the median seed-stage B2B company will run outbound with two or fewer humans in the loop.',
  'By end of 2027, GTM Engineer and RevOps-architect postings will outnumber SDR postings at AI-native startups.',
  'The fastest-promoted GTM hires of 2026–27 won’t be the best callers — they’ll be the ones who arrive with a working system as their resume.',
];

// ── desktop map geometry (fixed viewBox; scales as a unit) ──
const VB = { w: 1000, h: 520 };
const LX = 330, RX = 670, MIDX = 500;
const leftY = (i: number) => +(120 + i * ((VB.h - 170) / (leftNodes.length - 1))).toFixed(1);
const rightY = (j: number) => +(110 + j * ((VB.h - 170) / (rightNodes.length - 1))).toFixed(1);
const pathOf = (f: { li: number; ri: number }) => `M ${LX},${leftY(f.li)} C ${MIDX},${leftY(f.li)} ${MIDX},${rightY(f.ri)} ${RX},${rightY(f.ri)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/gtm-migration" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root { --ink: #17223f; --navy: #0f1834; --mut: #58637f; --line: rgba(24,40,88,0.12); --blue: #4c7ef5; }
      html { scroll-behavior: smooth; scroll-padding-top: 70px; -webkit-text-size-adjust: 100%; }
      body { margin: 0; color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        background: linear-gradient(180deg, #eef4fd 0%, #e9eefb 60%, #ecebf9 100%); overflow-x: hidden; }
      a { color: inherit; }
      h1, h2 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; margin: 0; color: var(--navy); }
      .col { max-width: 1000px; margin: 0 auto; padding: 0 24px; width: 100%; }

      .mig-top { padding: 60px 0 8px; }
      .mig-h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.05; }
      .mig-sub { font-size: clamp(1.05rem, 1.7vw, 1.35rem); line-height: 1.5; color: var(--mut); font-weight: 500; margin: 18px 0 0; max-width: 40ch; }

      .mig { padding-bottom: 90px; }

      /* ── desktop node map (hidden on mobile) ── */
      .mig-map { display: none; margin: 44px 0 8px; }
      .mig-svg { width: 100%; max-width: 940px; height: auto; display: block; margin: 0 auto; overflow: visible; }
      .mig-colh { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; fill: var(--mut); }
      .mig-link { fill: none; stroke: rgba(76,126,245,0.26); stroke-width: var(--sw); stroke-linecap: round; transition: stroke .18s ease; }
      .mig-link.on { stroke: rgba(76,126,245,0.9); }
      .mig-hit { fill: none; stroke: transparent; stroke-width: 26; cursor: pointer; }
      .mig-dot { fill: #7ea0f5; }
      .mig-dot.r { fill: #8b6cf0; }
      .mig-node { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 15px; fill: var(--ink); }
      .mig-maphint { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--mut); text-align: center; margin: 10px 0 0; }

      /* ── flow cards (mobile-first; also the detail area on desktop) ── */
      .mig-list { margin: 40px 0 0; display: flex; flex-direction: column; gap: 12px; }
      .mig-flow { border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,0.55); overflow: hidden; }
      .mig-flow.open { border-color: rgba(76,126,245,0.5); }
      .mig-head { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 14px; width: 100%;
        background: none; border: 0; cursor: pointer; text-align: left; padding: 18px 20px; font: inherit; color: var(--ink); }
      .mig-ft { font-family: 'Space Grotesk', sans-serif; font-size: clamp(15px, 2.2vw, 18px); letter-spacing: -0.01em; }
      .mig-ft b { font-weight: 600; }
      .mig-arw { color: var(--blue); margin: 0 4px; }
      .mig-wt { width: clamp(56px, 18vw, 120px); height: 6px; border-radius: 999px; background: rgba(24,40,88,0.09); overflow: hidden; }
      .mig-wt-bar { display: block; height: 100%; width: calc(var(--w) * 1%); border-radius: 999px; background: var(--blue); }
      .mig-chev { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: 22px; line-height: 1; color: var(--mut); transition: transform .2s ease; }
      .mig-flow.open .mig-chev { transform: rotate(45deg); }
      .mig-detail { padding: 0 20px 22px; }
      .mig-detail[hidden] { display: none; }
      .mig-field { margin: 16px 0 0; }
      .mig-lbl { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--blue); margin: 0 0 5px; }
      .mig-txt { font-size: clamp(15px, 1.4vw, 16.5px); line-height: 1.55; color: var(--ink); margin: 0; max-width: 66ch; }
      .mig-read { font-weight: 500; color: var(--navy); }
      .mig-sourced { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; line-height: 1.6; color: var(--mut); margin: 18px 0 0;
        padding-top: 14px; border-top: 1px solid var(--line); overflow-wrap: anywhere; }

      /* ── on the record ── */
      .mig-otr { margin: 66px 0 0; padding-top: 40px; border-top: 1px solid var(--line); }
      .mig-h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); line-height: 1.06; }
      .mig-otr-intro { font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.5; color: var(--mut); font-weight: 500; margin: 16px 0 0; max-width: 52ch; }
      .mig-preds { margin: 30px 0 0; display: flex; flex-direction: column; gap: 22px; }
      .mig-pred { border-left: 2px solid var(--blue); padding-left: 18px; }
      .mig-pred-t { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.28; letter-spacing: -0.02em; color: var(--navy); margin: 0; max-width: 40ch; }
      .mig-cred { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: .04em; color: var(--mut); margin: 8px 0 0; }

      .mig-foot { margin: 60px 0 0; padding-top: 26px; border-top: 1px solid var(--line);
        font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.55; color: var(--mut); font-weight: 500; max-width: 62ch; }

      @media (min-width: 760px) {
        .mig-map { display: block; }
      }
      @media (prefers-reduced-motion: reduce) {
        .mig-chev, .mig-link { transition: none; }
        html { scroll-behavior: auto; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <GlobalNav />

    <main class="mig">
      <header class="mig-top col">
        <h1 class="mig-h1">Where GTM work is going.</h1>
        <p class="mig-sub">Job titles are lagging indicators. This is the work in motion — which seats AI is compressing, and which seats are absorbing the judgment that remains.</p>
      </header>

      <div class="col">
        <!-- DESKTOP MAP -->
        <div class="mig-map">
          <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Migration flows from compressing roles to absorbing roles">
            <text class="mig-colh" x={LX - 16} y="44" text-anchor="end">Compressing</text>
            <text class="mig-colh" x={RX + 16} y="44" text-anchor="start">Absorbing</text>
            {flows.map((f) => (<path class="mig-link" data-flow={f.id} style={`--sw:${(2 + f.w * 9).toFixed(1)}`} d={pathOf(f)} />))}
            {flows.map((f) => (<path class="mig-hit" data-flow={f.id} d={pathOf(f)} aria-label={`${f.from} to ${f.to}`} />))}
            {leftNodes.map((n, i) => (
              <>
                <circle class="mig-dot" cx={LX} cy={leftY(i)} r="4" />
                <text class="mig-node" x={LX - 14} y={leftY(i)} text-anchor="end" dominant-baseline="central">{n}</text>
              </>
            ))}
            {rightNodes.map((n, j) => (
              <>
                <circle class="mig-dot r" cx={RX} cy={rightY(j)} r="4" />
                <text class="mig-node" x={RX + 14} y={rightY(j)} text-anchor="start" dominant-baseline="central">{n}</text>
              </>
            ))}
          </svg>
          <p class="mig-maphint">Click a flow to open its detail below · thicker line = bigger shift</p>
        </div>

        <!-- FLOW CARDS -->
        <div class="mig-list">
          {flows.map((f) => (
            <article class="mig-flow" data-flow={f.id}>
              <button class="mig-head" type="button" aria-expanded="false" aria-controls={`mig-d-${f.id}`}>
                <span class="mig-ft"><b>{f.from}</b> <span class="mig-arw" aria-hidden="true">→</span> <b>{f.to}</b></span>
                <span class="mig-wt" aria-hidden="true"><span class="mig-wt-bar" style={`--w:${Math.round(f.w * 100)}`}></span></span>
                <span class="mig-chev" aria-hidden="true">+</span>
              </button>
              <div class="mig-detail" id={`mig-d-${f.id}`} hidden>
                <div class="mig-field"><p class="mig-lbl">What moved</p><p class="mig-txt">{f.whatMoved}</p></div>
                <div class="mig-field"><p class="mig-lbl">Why</p><p class="mig-txt">{f.why}</p></div>
                <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{f.crossing}</p></div>
                <div class="mig-field"><p class="mig-lbl">Recruiter read</p><p class="mig-txt mig-read">{f.read}</p></div>
                <p class="mig-sourced">{f.sourced}</p>
              </div>
            </article>
          ))}
        </div>

        <!-- ON THE RECORD -->
        <section class="mig-otr">
          <h2 class="mig-h2">On the record.</h2>
          <p class="mig-otr-intro">Maps age. So here are three dated predictions this map implies — check me.</p>
          <div class="mig-preds">
            {predictions.map((p) => (
              <div class="mig-pred">
                <p class="mig-pred-t">{p}</p>
                <p class="mig-cred">Prediction · Kyle Findlay · July 2026</p>
              </div>
            ))}
          </div>
        </section>

        <p class="mig-foot">This map is the second deep-dive cluster of the Workforce Transformation Index. The method: public signals, sourced claims, human judgment — the same way I'd run it for a client.</p>
      </div>
    </main>

    <script>
      (() => {
        const root = document.querySelector('.mig');
        if (!root) return;
        const cards = [...root.querySelectorAll('.mig-flow')];
        const links = [...root.querySelectorAll('.mig-link')];
        const hits = [...root.querySelectorAll('.mig-hit')];
        const setActive = (id) => links.forEach((l) => l.classList.toggle('on', l.dataset.flow === String(id)));
        function toggle(card, force) {
          const head = card.querySelector('.mig-head');
          const det = card.querySelector('.mig-detail');
          const open = force !== undefined ? force : det.hidden;
          det.hidden = !open;
          head.setAttribute('aria-expanded', open ? 'true' : 'false');
          card.classList.toggle('open', open);
          if (open) setActive(card.dataset.flow);
        }
        cards.forEach((card) => card.querySelector('.mig-head').addEventListener('click', () => toggle(card)));
        hits.forEach((h) => {
          h.addEventListener('mouseenter', () => setActive(h.dataset.flow));
          h.addEventListener('click', () => {
            const card = cards.find((c) => c.dataset.flow === h.dataset.flow);
            if (!card) return;
            toggle(card, true);
            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      })();
    </script>
  </body>
</html>
