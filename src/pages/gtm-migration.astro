  <body>
    <GlobalNav />

    <main class="mig">
      <header class="mig-top col">
        <h1 class="mig-h1">Where GTM work is going.</h1>
        <p class="mig-stamp">Updated July 2026 · Federal, university, and industry sources · every claim dated and graded · human-verified before publish</p>
        <p class="mig-sub">Job titles are lagging indicators — twice. Where GTM work went, where it’s going, and what’s left for humans when it does.</p>
        <p class="mig-lens"><strong>GTM is the lens, not the limit</strong> — this maps one cluster of a migration running across tech.</p>
      </header>

      <div class="col">
        <!-- HERO: the migration current -->
        <div class="mig-hero">
          <canvas id="mig-field"></canvas>
          <div class="mig-ruler" aria-hidden="true">
            <span class="mig-ruler-seg">2024–26</span>
            <span class="mig-ruler-seg">2026–28</span>
            <span class="mig-ruler-seg">2028–30</span>
          </div>
          <div class="mig-band mig-b1">
            {heroBand1.map((n) => (<span class={n.m ? '' : 'mig-hide-m'}>{n.t}</span>))}
          </div>
          <div class="mig-band mig-b2">
            {heroBand2.map((n) => (<span class={n.m ? '' : 'mig-hide-m'}>{n.t}</span>))}
          </div>
          <div class="mig-band mig-b3">
            {heroBand3.map((n) => (<span class={`gh ${n.m ? '' : 'mig-hide-m'}`}>{n.t}</span>))}
          </div>
        </div>

        <!-- WAVE TOGGLE (sticky) -->
        <div class="mig-sticky-sentinel" aria-hidden="true"></div>
        <div class="mig-tabs" role="tablist" aria-label="Migration waves">
          <button class="mig-tab" role="tab" data-wave="w1" aria-selected="true"><span class="mig-tab-yr">2024–26</span><span class="mig-tab-ep">· Documented</span></button>
          <button class="mig-tab" role="tab" data-wave="w2" aria-selected="false"><span class="mig-tab-yr">2026–28</span><span class="mig-tab-ep">· In motion</span></button>
          <button class="mig-tab" role="tab" data-wave="w3" aria-selected="false"><span class="mig-tab-yr">2028–30</span><span class="mig-tab-ep">· Predicted</span></button>
        </div>

        <!-- PERSISTENT WAVE MAP — one component, three states that crossfade on tab switch (desktop) -->
        <div class="mig-mapstack">
          <div class="mig-mapstate" data-wave="w1" data-on="true">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Migration flows from compressing roles to absorbing roles">
              <text class="mig-colh" x={LX - 16} y="44" text-anchor="end">Compressing</text>
              <text class="mig-colh" x={RX + 16} y="44" text-anchor="start">Absorbing</text>
              {wave1.map((f) => (<path class="mig-link" data-flow={f.id} style={`--sw:${(f.w * 16).toFixed(1)}`} d={pathOf(f)} />))}
              {wave1.map((f) => (<path class="mig-hit" data-flow={f.id} d={pathOf(f)} aria-label={`${f.from} to ${f.to}`} />))}
              {leftNodes.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={leftY(i)} r="4" /><text class="mig-node" x={LX - 14} y={leftY(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {rightNodes.map((n, j) => (<><circle class="mig-dot r" cx={RX} cy={rightY(j)} r="4" /><text class="mig-node" x={RX + 14} y={rightY(j)} text-anchor="start" dominant-baseline="central">{n}</text></>))}
            </svg>
            <p class="mig-maphint">Click a flow to open its detail below · thicker line = bigger shift</p>
          </div>
          <div class="mig-mapstate" data-wave="w2" data-on="false">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="In-motion flows, solid at origin dissolving to dashed">
              <text class="mig-colh" x={LX - 16} y="60" text-anchor="end">Compressing next</text>
              <text class="mig-colh" x={RX + 16} y="60" text-anchor="start">Absorbing</text>
              {wave2.map((c, i) => (<><path class="mig-w2dash" d={p4(i)} /><path class="mig-w2solid" d={p4(i)} pathLength="100" style="stroke-dasharray: 50 100" /></>))}
              {wave2.map((c, i) => (<path class="mig-hit" data-flow={c.id} d={p4(i)} />))}
              {wave2MapL.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={y4(i)} r="4" /><text class="mig-node" x={LX - 14} y={y4(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {wave2MapR.map((n, i) => (<><circle class="mig-dot r" cx={RX} cy={y4(i)} r="4" /><text class="mig-node" x={RX + 14} y={y4(i)} text-anchor="start" dominant-baseline="central">{n}</text></>))}
            </svg>
            <p class="mig-mapcap">In motion: solid where it starts, dashed where it’s heading. No weights — direction is documented, magnitude isn’t yet.</p>
          </div>
          <div class="mig-mapstate" data-wave="w3" data-on="false">
            <svg class="mig-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="group" aria-label="Predicted destinations for today's seats">
              <text class="mig-colh" x={LX - 16} y="62" text-anchor="end">Today’s seats</text>
              <text class="mig-colh" x={RX + 16} y="62" text-anchor="start">Where they go?</text>
              {ghosts.map((g, i) => (<path class="mig-ghostlink" d={p6(i)} />))}
              {seats.map((n, i) => (<><circle class="mig-dot" cx={LX} cy={y6(i)} r="4" /><text class="mig-node" x={LX - 14} y={y6(i)} text-anchor="end" dominant-baseline="central">{n}</text></>))}
              {ghosts.map((g, i) => (<><circle class="mig-dot g" cx={RX} cy={y6(i)} r="4.5" /><text class="mig-node ghost" x={RX + 14} y={y6(i)} text-anchor="start" dominant-baseline="central">{g.name}</text></>))}
            </svg>
            <p class="mig-mapcap">Direction, not magnitude. The compressing seats are known. The destinations are categories, not titles.</p>
          </div>
        </div>

        <!-- ══ WAVE 1 ══ -->
        <section class="mig-wave" data-wave="w1" role="tabpanel">
          <h2 class="mig-wave-h">2024–26 · Documented</h2>
          <p class="mig-wave-intro">This wave already happened. It’s documented here because a map you can check is the only kind worth trusting forward.</p>

          <div class="mig-list">
            {wave1.map((f) => (
              <article class="mig-flow" data-flow={f.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w1-${f.id}`}>
                  <span class="mig-head-top">
                    <span class="mig-ft"><b>{f.from}</b> <span class="mig-arw" aria-hidden="true">→</span> <b>{f.to}</b>{f.caseChip && <span class="mig-badge mig-badge--outline mig-casechip">{f.caseChip}</span>}</span>
                    <span class="mig-wt" aria-hidden="true"><span class="mig-wt-bar" style={`--w:${Math.round(f.w * 100)}`}></span></span>
                    <span class="mig-chev" aria-hidden="true">+</span>
                  </span>
                  <span class="mig-takeaway">{f.takeaway}</span>
                  {f.chip && <span class="mig-chip"><span class="mig-chip-num">{f.chip.num}</span><span class="mig-chip-cap">{f.chip.cap}</span></span>}
                </button>
                <div class="mig-detail" id={`w1-${f.id}`} hidden>
                  <div class="mig-field"><p class="mig-lbl">Why</p>{f.whyHtml ? <div class="mig-txt" set:html={f.whyHtml} /> : SKIM[String(f.id)] ? <div class="mig-txt" set:html={skimHTML(f.why, SKIM[String(f.id)].split, SKIM[String(f.id)].bold)} /> : <p class="mig-txt">{f.why}</p>}{f.caveat && <p class="mig-caveat-line">{f.caveat}</p>}</div>
                  <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{f.crossing}</p></div>
                  <div class="mig-field"><p class="mig-lbl">Recruiter read</p><p class="mig-txt mig-read">{f.read}</p></div>
                  <p class="mig-src"><span class="mig-src-lbl">Sources:</span>{f.sources.map((s, i) => (<>{i > 0 && <span class="mig-src-sep"> · </span>}{SRC_URLS[s.text] ? <a class="mig-src-link" href={SRC_URLS[s.text]} target="_blank" rel="noopener">{s.text} <span class="mig-src-ext" aria-hidden="true">↗</span></a> : s.text} <span class={`mig-badge mig-badge--${badgeClass(s.badge)}`}>{s.badge}</span></>))}{f.srcNote && <><span class="mig-src-sep"> · </span><span class="mig-src-note">{f.srcNote}</span></>}</p>
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w1Disagreement} {w1DisagreementBadges.map((b) => (<span class={`mig-badge mig-badge--${badgeClass(b)}`}>{b}</span>))}</div></details>
          <p class="mig-weightcap">Flow weight = sourced judgment about magnitude and direction — not measured headcount.</p>
          <a class="mig-advance" href="#" data-goto="w2">What compresses next →</a>
        </section>

        <!-- ══ WAVE 2 ══ -->
        <section class="mig-wave" data-wave="w2" role="tabpanel" hidden>
          <h2 class="mig-wave-h">2026–28 · In motion</h2>
          <p class="mig-wave-intro">The absorbing seats compress next. Agent platforms productize the GTM Engineer build; agentic selling absorbs SMB deal work. Judgment concentrates in fewer, more senior seats.</p>

          <div class="mig-list">
            {wave2.map((c) => (
              <article class="mig-flow" data-flow={c.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w2-${c.id}`}>
                  <span class="mig-head-top"><span class="mig-ft">{c.title}</span><span class="mig-chev" aria-hidden="true">+</span></span>
                  <span class="mig-takeaway">{c.takeaway}</span>
                  {c.chip && <span class="mig-chip"><span class="mig-chip-num">{c.chip.num}</span><span class="mig-chip-cap">{c.chip.cap}</span></span>}
                </button>
                <div class="mig-detail" id={`w2-${c.id}`} hidden>
                  {c.body ? (SKIM[c.id] ? <div class="mig-txt" set:html={skimHTML(c.body, SKIM[c.id].split, SKIM[c.id].bold)} /> : <p class="mig-txt">{c.body}</p>) : (<>
                    <div class="mig-field"><p class="mig-lbl">What moved</p><p class="mig-txt">{c.whatMoved}</p></div>
                    <div class="mig-field"><p class="mig-lbl">Why</p><p class="mig-txt">{c.why}</p></div>
                    <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{c.crossing}</p></div>
                    <div class="mig-field"><p class="mig-lbl">Recruiter read</p><p class="mig-txt mig-read">{c.read}</p></div>
                  </>)}
                  {c.sources && <p class="mig-src"><span class="mig-src-lbl">Sources:</span>{c.sources.map((s, i) => (<>{i > 0 && <span class="mig-src-sep"> · </span>}{SRC_URLS[s.text] ? <a class="mig-src-link" href={SRC_URLS[s.text]} target="_blank" rel="noopener">{s.text} <span class="mig-src-ext" aria-hidden="true">↗</span></a> : s.text} <span class={`mig-badge mig-badge--${badgeClass(s.badge)}`}>{s.badge}</span></>))}</p>}
                  {c.sourceHtml && <p class="mig-src"><span class="mig-src-lbl">Sources:</span><span set:html={c.sourceHtml} /> <span class={`mig-badge mig-badge--${badgeClass(c.sourceBadge)}`}>{c.sourceBadge}</span></p>}
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w2Disagreement} {w2DisagreementBadges.map((b) => (<span class={`mig-badge mig-badge--${badgeClass(b)}`}>{b}</span>))}</div></details>
          <a class="mig-advance" href="#" data-goto="w3">Where it ends up →</a>
        </section>

        <!-- ══ WAVE 3 · ghost cards ══ -->
        <section class="mig-wave" data-wave="w3" role="tabpanel" hidden>
          <h2 class="mig-wave-h">2028–30 · Predicted</h2>

          <p class="mig-recruit">For a recruiting firm, every ghost card is a future placement category — this is a map of where the fees migrate.</p>

          <div class="mig-list">
            {ghosts.map((g) => (
              <article class="mig-flow ghost" data-flow={g.id}>
                <button class="mig-head" type="button" aria-expanded="false" aria-controls={`w3-${g.id}`}>
                  <span class="mig-head-top"><span class="mig-ft">{g.name}</span><span class="mig-chev" aria-hidden="true">+</span></span>
                  <span class="mig-takeaway">{g.takeaway}</span>
                </button>
                <div class="mig-detail" id={`w3-${g.id}`} hidden>
                  <div class="mig-field"><p class="mig-lbl">Why I expect this</p><p class="mig-txt">{g.why}</p></div>
                  <div class="mig-field"><p class="mig-lbl">What crossing takes</p><p class="mig-txt">{g.crossing}</p></div>
                  <div class="mig-field"><p class="mig-lbl mig-lbl--kill">What would change my mind</p><p class="mig-txt">{g.change}</p></div>
                  {g.conflict && <p class="mig-conflict">{g.conflict}</p>}
                  {g.sources && <p class="mig-src"><span class="mig-src-lbl">Sources:</span>{g.sources.map((s, i) => (<>{i > 0 && <span class="mig-src-sep"> · </span>}{SRC_URLS[s.text] ? <a class="mig-src-link" href={SRC_URLS[s.text]} target="_blank" rel="noopener">{s.text} <span class="mig-src-ext" aria-hidden="true">↗</span></a> : s.text} <span class={`mig-badge mig-badge--${badgeClass(s.badge)}`}>{s.badge}</span></>))}</p>}
                  <p class="mig-cred">Prediction · Kyle Findlay · July 2026</p>
                </div>
              </article>
            ))}
          </div>

          <details class="mig-dissent"><summary>Read the disagreement</summary><div class="mig-dissent-body">{w3Disagreement}</div></details>
          <a class="mig-advance" href="#" data-goto="w1">Back to what’s documented →</a>
        </section>

        <!-- ALWAYS VISIBLE — methodology legend + slop-free stamp -->
        <section class="mig-method">
          <div>
            <h2 class="mig-method-h">Sourced. Graded. Checkable.</h2>
            <div class="mig-legend-chips">
              {legendChips.map((c) => (<span class="mig-legend-chip"><span class={`mig-badge mig-badge--${badgeClass(c.badge)}`}>{c.badge}</span>{c.label}</span>))}
            </div>
            <div class="mig-legend-lines">
              {legendLines.map((l) => (<span class="mig-legend-line">{l}</span>))}
            </div>
          </div>
          <div class="mig-stampmark" aria-hidden="true">
            <div class="mig-stampmark-1">AI-SLOP-FREE</div>
            <div class="mig-stampmark-2">every claim named, dated, human-checked</div>
          </div>
          <p class="mig-foot">This map is the second deep-dive cluster of the Workforce Transformation Index. The method: public signals, sourced claims, human judgment — the same way I'd run it for a client.</p>
          <div class="mig-author">
            <span class="mig-author-name">Mapped and built by Kyle Findlay</span>
            <span class="mig-author-sep" aria-hidden="true">·</span>
            <span>Operator &amp; AI systems builder · SF / CA</span>
            <span class="mig-author-sep" aria-hidden="true">·</span>
            <a class="mig-author-link" href="mailto:kylefindlay828@gmail.com?subject=GTM%20Migration">Email</a>
            <span class="mig-author-sep" aria-hidden="true">·</span>
            <a class="mig-author-link" href="https://www.linkedin.com/in/kylefindlay828" target="_blank" rel="noopener">LinkedIn</a>
            <span class="mig-author-sep" aria-hidden="true">·</span>
            <a class="mig-author-link" href="/">About →</a>
          </div>
        </section>
      </div>
    </main>

    <script>
      (() => {
        const root = document.querySelector('.mig');
        if (!root) return;
        // ── wave toggle ──
        const tabs = [...root.querySelectorAll('.mig-tab')];
        const waves = [...root.querySelectorAll('.mig-wave')];
        const mapStates = [...root.querySelectorAll('.mig-mapstate')];
        const tabsEl = root.querySelector('.mig-tabs');
        const sentinel = root.querySelector('.mig-sticky-sentinel');
        const NAV = 58;
        function showWave(id) {
          tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.wave === id ? 'true' : 'false'));
          waves.forEach((w) => { w.hidden = w.dataset.wave !== id; });
          mapStates.forEach((m) => m.setAttribute('data-on', m.dataset.wave === id ? 'true' : 'false'));
        }
        function docTop(el) { let y = 0; while (el) { y += el.offsetTop; el = el.offsetParent; } return y; }
        function goWave(id) {
          showWave(id);
          // pin the sticky tabs just under the nav → the top of the wave content sits right below
          window.scrollTo({ top: Math.max(0, docTop(tabsEl) - NAV), behavior: 'smooth' });
        }
        tabs.forEach((t) => t.addEventListener('click', () => goWave(t.dataset.wave)));
        root.querySelectorAll('.mig-advance').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); goWave(a.dataset.goto); }));
        // compact "stuck" bar once the tabs pin under the nav
        if (sentinel && tabsEl && 'IntersectionObserver' in window) {
          new IntersectionObserver(([e]) => tabsEl.classList.toggle('stuck', !e.isIntersecting), { rootMargin: `-${NAV}px 0px 0px 0px`, threshold: 0 }).observe(sentinel);
        }
        // ── card expand + map click ──
        const cards = [...root.querySelectorAll('.mig-flow')];
        const links = [...root.querySelectorAll('.mig-link')];
        const setActive = (id) => links.forEach((l) => l.classList.toggle('on', l.dataset.flow === String(id)));
        function toggle(card, force) {
          const head = card.querySelector('.mig-head');
          const det = card.querySelector('.mig-detail');
          const open = force !== undefined ? force : det.hidden;
          det.hidden = !open;
          head.setAttribute('aria-expanded', open ? 'true' : 'false');
          card.classList.toggle('open', open);
          if (open) setActive(card.dataset.flow);
        }
        cards.forEach((card) => card.querySelector('.mig-head').addEventListener('click', () => toggle(card)));
        [...root.querySelectorAll('.mig-hit')].forEach((h) => {
          h.addEventListener('mouseenter', () => setActive(h.dataset.flow));
          h.addEventListener('click', () => {
            const card = cards.find((c) => c.dataset.flow === h.dataset.flow);
            if (!card) return; toggle(card, true); card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      })();

      // ── HERO v2: two chained emitter stages across three time bands (+ stall pool) ──
      // Stage 1: left band → middle band (solid → dashed). Stage 2: middle band → right band
      // (dashed → ghost). Middle labels are both destination and origin — two independent
      // particle sets that read as one continuous current. No per-dot end-to-end routing.
      (() => {
        const cv = document.getElementById('mig-field');
        if (!(cv instanceof HTMLCanvasElement)) return;
        const ctx = cv.getContext('2d');
        if (!ctx) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let W = 0, H = 0, DPR = 1, e1 = [], d1 = [], e2 = [], d2 = [], stall = { x: 0, y: 0 }, zoneX = [0, 0], fieldTop = 30, fieldBot = 0, parts = [], raf = 0;
        function rectIn(el) { const r = el.getBoundingClientRect(), h = cv.getBoundingClientRect(); return { x: r.right - h.left, y: r.top + r.height / 2 - h.top, l: r.left - h.left }; }
        function edges(sel, side) {
          return [...document.querySelectorAll(sel)].filter((e) => e.offsetParent !== null)
            .map((e) => { const b = rectIn(e); return { x: side === 'r' ? b.x + 3 : b.l - 4, y: b.y }; });
        }
        function measure() {
          // origins born within a few px of each label edge (acceptance rule holds for all bands)
          e1 = edges('.mig-b1 span', 'r');   // stage 1 origins: left band, right edge
          d1 = edges('.mig-b2 span', 'l');   // stage 1 targets: middle band, left edge
          e2 = edges('.mig-b2 span', 'r');   // stage 2 origins: middle band, right edge
          d2 = edges('.mig-b3 span', 'l');   // stage 2 targets: right band, left edge
          if (!e1.length) e1 = [{ x: W * 0.10, y: H * 0.5 }];
          if (!d1.length) d1 = [{ x: W * 0.48, y: H * 0.5 }];
          if (!e2.length) e2 = [{ x: W * 0.52, y: H * 0.5 }];
          if (!d2.length) d2 = [{ x: W * 0.88, y: H * 0.5 }];
          const st = document.querySelector('.mig-stall'); if (st) { const b = rectIn(st); stall = { x: b.l + 20, y: b.y }; } else stall = { x: W * 0.82, y: H * 0.92 };
          // zone boundaries align with the ruler (8%…92%, thirds)
          zoneX = [W * 0.08 + (W * 0.84) / 3, W * 0.08 + (W * 0.84) * 2 / 3];
          fieldTop = 30; fieldBot = H - 20;
        }
        function reset(p, seed) {
          p.stage = Math.random() < 0.5 ? 1 : 2;
          const E = p.stage === 1 ? e1 : e2, D = p.stage === 1 ? d1 : d2;
          const e = E[(Math.random() * E.length) | 0], d = D[(Math.random() * D.length) | 0];
          p.x = e.x + Math.random() * 2;
          p.y = e.y + (Math.random() - 0.5) * 8;
          p.tx = d.x; p.ty = d.y;
          p.sp = 0.5 + Math.random() * 0.7;
          p.s = 1.4 + Math.random() * 1.6;
          p.stall = Math.random() < 0.16;
          p.stalled = false; p.slow = 0; p.a = 0;
          p.molt = p.stage === 1 ? 0 : 1;   // stage1 begins solid; stage2 begins dashed
          if (seed) {
            p.x = e.x + Math.random() * (d.x - e.x);
            p.molt = p.stage === 1 ? (p.x >= zoneX[0] ? 1 : 0) : (p.x >= zoneX[1] ? 2 : 1);
          }
        }
        function build() {
          const total = W < 620 ? 130 : 160;
          parts = [];
          for (let i = 0; i < total; i++) { const p = {}; reset(p, true); parts.push(p); }
        }
        function draw(now) {
          now = now || performance.now();
          ctx.clearRect(0, 0, W, H);
          // zone tick lines dropping through the field
          ctx.strokeStyle = 'rgba(15,24,52,0.10)'; ctx.lineWidth = 1;
          for (const zx of zoneX) { ctx.beginPath(); ctx.moveTo(zx, fieldTop); ctx.lineTo(zx, fieldBot); ctx.stroke(); }
          for (const p of parts) {
            if (!reduce) {
              // molt across this stage's boundary with a ~300ms drift-slowdown (not a hard stop)
              if (p.stage === 1) { if (p.molt === 0 && p.x >= zoneX[0]) { p.molt = 1; p.slow = now + 300; } }
              else { if (p.molt === 1 && p.x >= zoneX[1]) { p.molt = 2; p.slow = now + 300; } }
              const slowF = now < p.slow ? 0.28 : 1;
              if (p.stall && !p.stalled && p.x > zoneX[0] + Math.random() * 30) p.stalled = true;
              if (p.stalled) {
                p.x += (stall.x - p.x) * 0.03; p.y += (stall.y - p.y) * 0.05 + 0.3; p.a += 0.02;
                if (p.a > 1.3) reset(p, false);
              } else {
                p.x += p.sp * slowF; p.y += (p.ty - p.y) * 0.03;
                if (p.x > p.tx + 6) reset(p, false);
              }
            }
            const mode = p.stalled ? 3 : p.molt;
            const base = 0.16 + (p.s - 1.4) * 0.14;
            if (mode === 0) { ctx.fillStyle = `rgba(60,112,236,${Math.min(0.72, 0.44 + base)})`; ctx.fillRect(p.x, p.y, p.s, p.s); }
            else if (mode === 1) { ctx.strokeStyle = 'rgba(82,84,228,0.5)'; ctx.lineWidth = 1; ctx.strokeRect(p.x, p.y, p.s + 0.5, p.s + 0.5); }
            else if (mode === 2) { ctx.strokeStyle = 'rgba(140,106,243,0.3)'; ctx.lineWidth = 1; ctx.strokeRect(p.x, p.y, p.s + 0.5, p.s + 0.5); }
            else { ctx.fillStyle = `rgba(88,99,127,${Math.max(0, 0.35 * (1 - p.a / 1.3))})`; ctx.fillRect(p.x, p.y, p.s, p.s); }
          }
          if (!reduce) raf = requestAnimationFrame(draw);
        }
        function resize() {
          DPR = Math.min(window.devicePixelRatio || 1, 2);
          W = cv.clientWidth; H = cv.clientHeight;
          cv.width = Math.max(1, W * DPR); cv.height = Math.max(1, H * DPR);
          ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
          measure(); build();
        }
        resize();
        window.addEventListener('resize', () => { cancelAnimationFrame(raf); resize(); if (!reduce) raf = requestAnimationFrame(draw); });
        window.addEventListener('load', () => { measure(); build(); });
        if (reduce) draw(); else raf = requestAnimationFrame(draw);
      })();
    </script>
  </body>
</html>
