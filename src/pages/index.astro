---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Home from '../components/tabs/Home.astro';
import GtmRadar from '../components/tabs/GtmRadar.astro';
import WhereIFit from '../components/tabs/WhereIFit.astro';
import Work from '../components/tabs/Work.astro';
import Contact from '../components/tabs/Contact.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kyle Findlay</title>
    <meta name="description" content="Customer Success, Partnerships, and GTM for early-stage tech." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="Kyle Findlay" />
    <meta property="og:description" content="Customer Success, Partnerships, and GTM for early-stage tech." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <style>
      html { scroll-behavior: smooth; scroll-padding-top: 80px; }
    </style>
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <Nav />
    <main class="max-w-content mx-auto px-6 py-12">
      <section><Home /></section>
      <section id="gtm-radar" class="mt-20"><GtmRadar /></section>
      <section id="where-i-fit" class="mt-20"><WhereIFit /></section>
      <section id="experience" class="mt-20"><Work /></section>
      <section id="contact" class="mt-20"><Contact /></section>
    </main>
  </body>
</html>
