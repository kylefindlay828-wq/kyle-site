---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Home from '../components/tabs/Home.astro';
import Work from '../components/tabs/Work.astro';
import OffTheRecord from '../components/tabs/OffTheRecord.astro';
import GtmRadar from '../components/tabs/GtmRadar.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kyle Findlay</title>
    <meta name="description" content="Customer Success, Partnerships, and GTM for early-stage tech." />
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <Nav />
    <main class="max-w-content mx-auto px-6 py-12">
      <section data-section="home"><Home /></section>
      <section data-section="work"><Work /></section>
      <section data-section="off-the-record"><OffTheRecord /></section>
      <section data-section="gtm-radar"><GtmRadar /></section>
      <section data-section="contact"><h2>Contact</h2></section>
    </main>
  </body>
</html>
