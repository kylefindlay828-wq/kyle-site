---
import '../styles/global.css';
import AboutNav from '../components/AboutNav.astro';
import About from '../components/About.astro';
import FinalCta from '../components/FinalCta.astro';
import Analytics from '@vercel/analytics/astro';

const title = 'Kyle Findlay — Early-stage operations · Marketplaces · Workforce infrastructure';
const description = 'Kyle Findlay is an operator moving deeper into early-stage technology, marketplaces, and AI-enabled workforce systems — turning ambiguous work into systems people can run.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-about.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kyle Findlay — operator in early-stage tech, marketplaces, and AI-enabled workforce systems. kylefindlay.xyz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-about.png" />
    <style>
      html { scroll-behavior: smooth; scroll-padding-top: 72px; }
    </style>
    <Analytics />
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <AboutNav />
    <main class="max-w-content mx-auto px-6">
      <About />
      <FinalCta />
    </main>

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
        els.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>
