---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Home from '../components/tabs/Home.astro';
import GtmRadar from '../components/tabs/GtmRadar.astro';
import WhereIFit from '../components/tabs/WhereIFit.astro';
import Contact from '../components/tabs/Contact.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GTM Radar · Kyle Findlay</title>
    <meta name="description" content="GTM Radar — weekly intelligence briefing on AI-reshaped hiring. Built by Kyle Findlay." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="GTM Radar · Kyle Findlay" />
    <meta property="og:description" content="Weekly intelligence briefing on AI-reshaped hiring — built for GTM recruiters." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <style>
      html { scroll-behavior: smooth; scroll-padding-top: 80px; }
    </style>
  </head>
  <body class="bg-paper text-ink min-h-screen">
    <Nav />
    <main class="max-w-content mx-auto px-6 py-12">
      <section data-section="gtm-radar"><GtmRadar /></section>
      <section data-section="profile">
        <Home />
        <div class="mt-16"><WhereIFit /></div>
        <div class="mt-16"><Contact /></div>
      </section>
    </main>
  </body>
</html>
