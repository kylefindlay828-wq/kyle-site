---
// OG share image for /supply (link previews). Cool gtm-migration palette.
// Rendered at 2x (1200×630 → 2400×1260) to /public/og-supply.png. Unlisted route.
const funnel = [
  { w: 420, label: 'contacts' },
  { w: 300, label: 'applied' },
  { w: 196, label: 'vetted' },
  { w: 118, label: 'active experts' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { background: #eef4fd; }
      .og { position: relative; width: 1200px; height: 630px; overflow: hidden; font-family: 'Space Grotesk', sans-serif; color: #17223f;
        background:
          radial-gradient(58% 82% at 82% 30%, rgba(76,126,245,0.13), transparent 62%),
          radial-gradient(52% 74% at 14% 78%, rgba(123,108,240,0.12), transparent 64%),
          linear-gradient(180deg, #eef4fd 0%, #e9eefb 60%, #ecebf9 100%); }

      .kick { position: absolute; top: 60px; left: 72px; font-family: 'JetBrains Mono', monospace; font-size: 17px; letter-spacing: .18em; text-transform: uppercase; color: #2f6fd0; }
      .h1 { position: absolute; left: 72px; top: 150px; max-width: 620px; font-weight: 700; font-size: 64px; line-height: 1.02; letter-spacing: -0.035em; color: #0f1834; }
      .sub { position: absolute; left: 74px; top: 396px; max-width: 560px; font-family: 'JetBrains Mono', monospace; font-size: 18px; line-height: 1.5; color: #58637f; }
      .url { position: absolute; left: 74px; bottom: 48px; font-family: 'JetBrains Mono', monospace; font-size: 16px; letter-spacing: .02em; color: #2f6fd0; }
      .tag { position: absolute; right: 72px; bottom: 48px; font-family: 'JetBrains Mono', monospace; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; color: rgba(88,99,127,0.75); }

      .funnel { position: absolute; right: 84px; top: 176px; display: flex; flex-direction: column; gap: 20px; align-items: flex-end; }
      .bar { height: 46px; border-radius: 8px; display: flex; align-items: center; justify-content: flex-start; padding-left: 16px;
        font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .04em; color: #0f1834; }
      .b0 { background: rgba(60,112,236,0.85); color: #fff; }
      .b1 { background: rgba(76,126,245,0.55); }
      .b2 { background: rgba(123,108,240,0.45); }
      .b3 { background: rgba(124,58,237,0.85); color: #fff; }
    </style>
  </head>
  <body>
    <div class="og">
      <div class="kick">Supply map · AI training data</div>
      <div class="h1">Where the next 400,000 experts are</div>
      <div class="sub">AI training-data companies are capped by expert supply, not demand.</div>

      <div class="funnel">
        {funnel.map((f, i) => (<div class={`bar b${i}`} style={`width:${f.w}px`}>{f.label}</div>))}
      </div>

      <div class="url">kylefindlay.xyz/supply</div>
      <div class="tag">Outside analysis · public sources</div>
    </div>
  </body>
</html>
