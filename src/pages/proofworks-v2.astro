---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import WorkforceTransformationIndex from '../components/WorkforceTransformationIndexFinal.astro';
import Analytics from '@vercel/analytics/astro';

const title = 'Proofworks V2 — Kyle Findlay';
const description = 'An independent research project mapping what companies should develop, redesign, automate, or hire for next — built around an interactive Workforce Transformation Index.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';

const indexNote = 'Working hypothesis. The clusters represent types of work—not entire industries. Positions and opportunity sizes are directional until supported by employment, wage, AI-adoption, and employer-spending data.';

const steps = [
  { n: '01', k: 'Source', t: 'Labor, task, hiring, product, investment, and adoption signals.' },
  { n: '02', k: 'Structure', t: 'Normalize roles, tasks, industries, and patterns of change.' },
  { n: '03', k: 'Validate', t: 'Attach sources, review uncertainty, and inspect edge cases.' },
  { n: '04', k: 'Map', t: 'Turn the evidence into testable workforce decisions.' },
];
const decisions = [
  { h: 'Develop the people.', s: 'Preserve valuable judgment and operating context.' },
  { h: 'Redesign the work.', s: 'Compress repetitive tasks and rebuild weak processes.' },
  { h: 'Hire what is missing.', s: 'Add outside capability where the internal gap is real.' },
];
const metrics = [
  { n: '$3.1M+', l: 'owned annually' },
  { n: '$5–6M', l: 'supported' },
  { n: '30–40', l: 'programs / year' },
  { n: '12+', l: 'national brands' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks-v2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      .pw { --bg: #f4f2eb; --ink: #24221d; --mut: #6f6a5f; --rule: #e3ddd0; --card: #fbfaf5;
        --acc: #2f6fd0; --acc2: #1f5aa6;
        --sans: 'Hanken Grotesk', system-ui, sans-serif; --disp: 'Space Grotesk', sans-serif; --mono: 'JetBrains Mono', monospace;
        background: var(--bg); color: var(--ink); font-family: var(--sans); position: relative; overflow-x: hidden; }
      .pw * { box-sizing: border-box; }
      .pw::before { content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background-image: linear-gradient(rgba(47,111,208,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(47,111,208,0.05) 1px, transparent 1px);
        background-size: 40px 40px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 68%);
        mask-image: radial-gradient(ellipse at 50% 0%, #000 20%, transparent 68%); }
      .pw a { text-decoration: none; color: inherit; }
      .pw :focus-visible { outline: 2px solid var(--acc); outline-offset: 3px; border-radius: 4px; }
      .pw main { position: relative; z-index: 1; }
      .col { max-width: 1080px; margin: 0 auto; padding: 0 28px; }
      .sec { padding: 60px 0; }

      /* three type scales */
      .label { font-family: var(--mono); font-size: 12px; letter-spacing: .15em; text-transform: uppercase; color: var(--acc2); margin: 0 0 18px; }
      .thesis { font-family: var(--disp); font-weight: 600; font-size: clamp(40px, 8vw, 84px); line-height: 0.98; letter-spacing: -0.035em; color: var(--ink); margin: 0; }
      .statement { font-family: var(--disp); font-weight: 600; font-size: clamp(28px, 4.4vw, 44px); line-height: 1.06; letter-spacing: -0.028em; color: var(--ink); margin: 0; }
      .support { font-size: clamp(15px, 1.7vw, 18px); line-height: 1.55; color: #4a463f; }

      /* hero */
      .hero { padding: 88px 0 58px; }
      .hero-support { margin: 26px 0 0; max-width: 34em; }
      .hero-links { display: flex; gap: 26px; flex-wrap: wrap; margin-top: 32px; }
      .tlink { font-family: var(--mono); font-size: 14px; color: var(--acc2); border-bottom: 1px solid rgba(31,90,166,0.4); padding-bottom: 3px; transition: color .18s, border-color .18s; }
      .tlink:hover { color: var(--acc); border-color: var(--acc); }

      .idx-intro { padding-bottom: 6px; }
      .idx-intro .statement { margin-top: 4px; }

      /* research workflow — off-white treatment */
      .workflow { position: relative; isolation: isolate; background: #eceae3; color: #23262b;
        padding: 74px 0 80px; margin: 30px 0; overflow: hidden; border-top: 1px solid #ddd9cd; border-bottom: 1px solid #ddd9cd; }
      .workflow::before { content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .9;
        background-image: linear-gradient(rgba(47,111,208,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(47,111,208,0.07) 1px, transparent 1px);
        background-size: 44px 44px;
        -webkit-mask-image: radial-gradient(130% 100% at 50% 0%, #000 30%, transparent 80%);
        mask-image: radial-gradient(130% 100% at 50% 0%, #000 30%, transparent 80%); }
      .wf-bglines { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; pointer-events: none; opacity: .5; }
      .wf-in { position: relative; z-index: 1; max-width: 1080px; margin: 0 auto; padding: 0 28px; }
      .wf-h { color: #1a1d22; margin-top: 4px; }
      .wf-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 42px; }
      .wf-step { position: relative; }
      .wf-n { font-family: var(--mono); font-size: 13px; font-weight: 600; color: var(--acc); }
      .wf-k { display: block; font-family: var(--disp); font-weight: 600; font-size: 18px; letter-spacing: -0.01em; color: #1c1f24; margin: 7px 0 8px; }
      .wf-step p { font-size: 14px; line-height: 1.45; color: #4c5057; margin: 0; max-width: 26ch; }
      .wf-step:not(:last-child)::after { content: '→'; position: absolute; right: -12px; top: -2px; color: var(--acc); font-weight: 700; }
      .wf-close { font-family: var(--disp); font-weight: 600; font-size: clamp(20px, 2.7vw, 31px); line-height: 1.12; letter-spacing: -0.02em; color: #1a1d22; margin: 44px 0 0; max-width: 24ch; }

      /* three decisions */
      .dec { padding: 30px 0; border-top: 1px solid var(--rule); }
      .dec:first-of-type { border-top: 0; padding-top: 8px; }
      .dec-h { font-family: var(--disp); font-weight: 600; font-size: clamp(30px, 5vw, 52px); line-height: 1.0; letter-spacing: -0.03em; color: var(--ink); margin: 0; }
      .dec-s { margin: 12px 0 0; max-width: 44ch; color: #56514a; }

      /* founder strip */
      .founder-lead { font-family: var(--disp); font-weight: 500; font-size: clamp(17px, 2vw, 21px); line-height: 1.35; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 30px; max-width: 40ch; }
      .strip { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
      .metric { padding: 24px 22px; border-right: 1px solid var(--rule); }
      .metric:last-child { border-right: 0; }
      .mnum { display: block; font-family: var(--disp); font-weight: 600; font-size: clamp(28px, 3.4vw, 40px); line-height: 1; letter-spacing: -0.02em; color: var(--acc2); }
      .mlbl { display: block; font-family: var(--mono); font-size: 12px; color: var(--mut); margin-top: 9px; }
      .founder-quiet { font-family: var(--mono); font-size: 12.5px; color: var(--mut); margin: 22px 0 0; }

      /* contact */
      .contact-q { font-family: var(--disp); font-weight: 500; font-size: clamp(18px, 2.2vw, 24px); line-height: 1.3; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 24px; max-width: 30ch; }
      .contact-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 14px; background: var(--acc); color: #fff; padding: 11px 20px; border-radius: 999px; border: 0; cursor: pointer; transition: opacity .18s; }
      .btn:hover { opacity: .9; }
      .clink { font-family: var(--mono); font-size: 14px; color: var(--acc2); border-bottom: 1px solid rgba(31,90,166,0.35); padding-bottom: 2px; }
      .clink:hover { color: var(--acc); border-color: var(--acc); }
      .foot { display: flex; gap: 20px; flex-wrap: wrap; padding: 30px 0 56px; }
      .foot a, .foot span { font-family: var(--mono); font-size: 13px; color: var(--mut); }
      .foot a:hover { color: var(--acc); }

      [data-rev] { opacity: 0; transform: translateY(20px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); }
      [data-rev].in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { [data-rev] { opacity: 1 !important; transform: none !important; transition: none !important; } }

      @media (max-width: 860px) {
        .wf-steps { grid-template-columns: 1fr 1fr; gap: 22px 16px; }
        .wf-step:not(:last-child)::after { content: none; }
      }
      @media (max-width: 560px) {
        .hero { padding: 66px 0 44px; }
        .wf-steps { grid-template-columns: 1fr; }
        .strip { grid-template-columns: 1fr 1fr; }
        .metric:nth-child(2) { border-right: 0; }
        .metric:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
      }
    </style>
    <Analytics />
  </head>
  <body class="pw">
    <SiteHeader />
    <main>
      <!-- 1 · HERO -->
      <section class="hero">
        <div class="col">
          <p class="label" data-rev>Proofworks</p>
          <h1 class="thesis" data-rev style="transition-delay:.05s">Work is changing faster<br />than job titles.</h1>
          <p class="support hero-support" data-rev style="transition-delay:.1s">An independent research project mapping what companies should develop, redesign, automate, or hire for next.</p>
          <div class="hero-links" data-rev style="transition-delay:.15s">
            <a href="#index" class="tlink">Explore the index →</a>
            <a href="#workflow" class="tlink">See the workflow ↓</a>
          </div>
        </div>
      </section>

      <!-- 2 · WORKFORCE TRANSFORMATION INDEX -->
      <section class="sec idx-intro">
        <div class="col">
          <p class="label" data-rev>The Workforce Transformation Index</p>
          <h2 class="statement" data-rev style="transition-delay:.05s">Where should companies develop people—<br />and where should the work itself change?</h2>
        </div>
      </section>
      <WorkforceTransformationIndex noteBrief="Working hypothesis. Work clusters—not entire industries." note={indexNote} showFilter={false} />

      <!-- 3 · RESEARCH WORKFLOW -->
      <section class="workflow" id="workflow" aria-label="How the research works">
        <svg class="wf-bglines" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path d="M-40,140 C 260,80 440,210 720,140 S 1160,80 1260,160" fill="none" stroke="#2f6fd0" stroke-width="1" opacity="0.22" />
          <path d="M-40,300 C 300,240 520,360 800,290 S 1160,250 1260,320" fill="none" stroke="#1f5aa6" stroke-width="1" opacity="0.16" />
        </svg>
        <div class="wf-in">
          <p class="label" data-rev>How the research works</p>
          <h2 class="statement wf-h" data-rev style="transition-delay:.05s">From scattered signals<br />to workforce decisions.</h2>
          <div class="wf-steps">
            {steps.map((s, i) => (
              <div class="wf-step" data-rev style={`transition-delay:${0.05 + i * 0.05}s`}>
                <span class="wf-n">{s.n}</span>
                <span class="wf-k">{s.k}</span>
                <p>{s.t}</p>
              </div>
            ))}
          </div>
          <p class="wf-close" data-rev>One standard: real workflows and demonstrated judgment.</p>
        </div>
      </section>

      <!-- 4 · THREE DECISIONS -->
      <section class="sec">
        <div class="col">
          {decisions.map((d) => (
            <div class="dec" data-rev>
              <h2 class="dec-h">{d.h}</h2>
              <p class="support dec-s">{d.s}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 5 · FOUNDER STRIP -->
      <section class="sec">
        <div class="col">
          <p class="founder-lead" data-rev>Running complex customer programs showed me that formal roles often miss who can actually improve the work.</p>
          <div class="strip" data-rev>
            {metrics.map((m) => (
              <div class="metric"><span class="mnum">{m.n}</span><span class="mlbl">{m.l}</span></div>
            ))}
          </div>
          <p class="founder-quiet" data-rev>Built independently by Kyle Findlay.</p>
        </div>
      </section>

      <!-- 6 · CONTACT -->
      <section class="sec" id="contact">
        <div class="col">
          <p class="contact-q" data-rev>Interested in workforce change, implementation talent, or the research behind the Index?</p>
          <div class="contact-actions" data-rev>
            <button id="copy-email" class="btn" data-email={email} type="button"><span class="ce">Copy email</span> ⧉</button>
            <a href={`mailto:${email}`} class="clink">{email}</a>
            <a href={linkedin} target="_blank" rel="noopener" class="clink">LinkedIn ↗</a>
          </div>
          <div class="foot">
            <span>© Kyle Findlay</span>
            <a href="/">About</a>
            <a href="/proofworks">Proofworks V1</a>
          </div>
        </div>
      </section>
    </main>

    <script>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('[data-rev], [data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
        } else {
          const obs = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          els.forEach((el) => obs.observe(el));
        }
        const btn = document.getElementById('copy-email');
        const label = btn?.querySelector('.ce');
        const original = label?.textContent ?? '';
        btn?.addEventListener('click', async () => {
          const em = btn.getAttribute('data-email') ?? '';
          try { await navigator.clipboard.writeText(em); }
          catch { const t = document.createElement('textarea'); t.value = em; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); }
          if (label) { label.textContent = 'Copied ✓'; setTimeout(() => { label.textContent = original; }, 1700); }
        });
      })();
    </script>
  </body>
</html>
