---
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Proofworks V2 — Recruiter-ready operators';
const description = 'Proofworks identifies candidates with strong adjacent experience, evaluates them through role-specific work, and packages the evidence recruiters need to submit them confidently.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
const roleMailto = 'mailto:kylefindlay828@gmail.com?subject=Proofworks%20%E2%80%94%20send%20us%20a%20role';
const hardRoleMailto = 'mailto:kylefindlay828@gmail.com?subject=Proofworks%20%E2%80%94%20a%20difficult%20role';
const candidateMailto = 'mailto:kylefindlay828@gmail.com?subject=Proofworks%20%E2%80%94%20join%20the%20first%20candidate%20group';

const proofRows = [
  'Role-specific work sample',
  'Decision-making rationale',
  'Structured interview findings',
  'Response to feedback',
  'Transferable experience',
  'Availability and compensation',
  'Strengths and risk flags',
];
const floatLabels = [
  { t: 'Work verified', c: 'fl-tl' },
  { t: 'Candidate interested', c: 'fl-tr' },
  { t: 'Role aligned', c: 'fl-bl' },
  { t: 'Recruiter ready', c: 'fl-br' },
];
const findings = [
  '“Adaptable operator” is a selection thesis—not a job title.',
  'Training candidates from scratch turns Proofworks into a school.',
  'Recruiters already possess employer relationships and live hiring demand.',
  'Candidates need a better way to demonstrate ability beyond their résumé.',
  'Recruiters need candidates they can confidently submit.',
  'Short, role-specific work can reveal more than another credential.',
  'Proofworks evaluates one defined role at a time.',
  'The first objective is a successful placement—not a marketplace.',
];
const candidateWhy = [
  'Access to real opportunities',
  'A better way to demonstrate their ability',
  'Exposure to relevant recruiters',
  'Less dependence on résumé keywords',
];
const recruiterWhy = [
  'Candidates aligned to a live role',
  'Work evidence already prepared',
  'Interest and availability confirmed',
  'Structured information that saves screening time',
  'Candidates they may not otherwise discover',
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks-v2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root { --acc: #4c9dff; --bg: #0a0b0f; --ink: #eef1f4; --mut: #9aa3ad; --pane: rgba(255,255,255,0.04); --line: rgba(255,255,255,0.09); }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif;
        -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { text-decoration: none; color: inherit; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; margin: 0; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      .col { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
      ::selection { background: rgba(76,157,255,0.26); }

      /* ambient background glow (restrained) */
      .glow { position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background:
          radial-gradient(60% 50% at 78% 18%, rgba(76,157,255,0.16), transparent 70%),
          radial-gradient(50% 45% at 15% 82%, rgba(76,157,255,0.08), transparent 70%); }
      .wrap { position: relative; z-index: 1; }

      /* hero */
      .hero { min-height: calc(100vh - 58px); display: flex; align-items: center; padding: 48px 0 64px; }
      .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 54px; align-items: center; width: 100%; }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--acc); margin: 0 0 22px; }
      .hero-h { font-size: clamp(38px, 5.4vw, 68px); line-height: 1.02; color: #fff; max-width: 15ch; }
      .hero-d { font-size: clamp(16px, 1.5vw, 19px); line-height: 1.5; color: var(--mut); margin: 24px 0 0; max-width: 46ch; }
      .cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
      .btn { font-family: 'JetBrains Mono', monospace; font-size: 14px; padding: 13px 22px; border-radius: 12px; cursor: pointer; transition: transform .15s ease, opacity .15s ease, border-color .18s ease, background-color .18s ease; display: inline-block; }
      .btn-p { background: var(--acc); color: #04101f; border: 1px solid var(--acc); }
      .btn-p:hover { opacity: .92; transform: translateY(-1px); }
      .btn-s { background: transparent; color: var(--ink); border: 1px solid var(--line); }
      .btn-s:hover { border-color: rgba(255,255,255,0.4); transform: translateY(-1px); }

      /* proof package */
      .pkg-stage { position: relative; }
      .pkg { position: relative; z-index: 2; background: linear-gradient(180deg, rgba(22,26,34,0.9), rgba(14,17,23,0.92));
        border: 1px solid var(--line); border-radius: 20px; padding: 20px; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
        box-shadow: 0 40px 90px -50px rgba(0,0,0,0.9), 0 0 0 1px rgba(76,157,255,0.06); }
      .pkg-head { display: flex; align-items: center; justify-content: space-between; padding: 4px 6px 16px; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
      .pkg-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; }
      .pkg-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 12px var(--acc); }
      .pkg-tag { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mut); letter-spacing: .06em; }
      .row { display: flex; align-items: center; gap: 12px; padding: 12px 8px; border-radius: 12px; }
      .row + .row { border-top: 1px solid rgba(255,255,255,0.05); }
      .row .chk { width: 22px; height: 22px; border-radius: 7px; flex-shrink: 0; display: grid; place-items: center;
        background: rgba(76,157,255,0.14); border: 1px solid rgba(76,157,255,0.4); color: var(--acc); font-size: 12px; }
      .row .rl { font-size: 14.5px; color: #dbe1e8; flex: 1; }
      .row .rs { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: .06em; color: var(--acc); text-transform: uppercase; opacity: .8; }

      /* floating labels */
      .fl { position: absolute; z-index: 3; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--ink);
        background: rgba(16,20,27,0.86); border: 1px solid var(--line); border-radius: 999px; padding: 8px 14px; white-space: nowrap;
        backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: 0 16px 40px -22px rgba(0,0,0,0.9); }
      .fl::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--acc); margin-right: 8px; vertical-align: middle; box-shadow: 0 0 8px var(--acc); }
      .fl-tl { top: -18px; left: -26px; }
      .fl-tr { top: 40px; right: -30px; }
      .fl-bl { bottom: 46px; left: -34px; }
      .fl-br { bottom: -16px; right: -18px; }

      /* screen two */
      .s2 { padding: 96px 0 40px; }
      .lbl { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--acc); margin: 0 0 20px; }
      .s2-h { font-size: clamp(28px, 3.8vw, 46px); line-height: 1.05; color: #fff; max-width: 18ch; }
      .findings { list-style: none; margin: 44px 0 0; padding: 0; display: grid; gap: 2px; max-width: 940px; }
      .findings li { display: flex; gap: 16px; align-items: baseline; padding: 16px 4px; border-top: 1px solid var(--line); font-size: clamp(16px, 1.7vw, 20px); line-height: 1.4; color: #d3d9e0; }
      .findings li .fn { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--acc); flex-shrink: 0; width: 28px; }

      /* two column */
      .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 64px; }
      .card { background: var(--pane); border: 1px solid var(--line); border-radius: 20px; padding: 30px 28px; }
      .card h3 { font-size: 22px; color: #fff; margin-bottom: 18px; }
      .card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
      .card li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.4; color: #c3cbd4; }
      .card li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); margin-top: 8px; flex-shrink: 0; }

      /* closing */
      .closing { margin-top: 72px; padding: 48px 0 8px; border-top: 1px solid var(--line); }
      .closing h2 { font-size: clamp(26px, 3.4vw, 42px); line-height: 1.1; color: #fff; max-width: 20ch; }
      .closing h2 b { color: var(--acc); font-weight: 600; }

      /* footer */
      .foot { margin-top: 90px; border-top: 1px solid var(--line); }
      .foot-in { max-width: 1180px; margin: 0 auto; padding: 40px 28px 56px; display: flex; justify-content: space-between; gap: 30px; flex-wrap: wrap; align-items: flex-end; }
      .foot-brand { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 20px; }
      .foot-tag { color: var(--mut); font-size: 14px; margin-top: 6px; }
      .foot-links { display: flex; gap: 22px; flex-wrap: wrap; }
      .foot-links a, .foot-links span { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--mut); transition: color .18s ease; }
      .foot-links a:hover { color: var(--acc); }

      /* ── entrance animations ── */
      .rise { opacity: 0; transform: translateY(22px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      .rise.in { opacity: 1; transform: none; }
      @keyframes rowIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
      @keyframes floatY { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
      .row { opacity: 0; animation: rowIn .6s cubic-bezier(.22,1,.36,1) forwards; }
      .pkg.go .row:nth-child(1) { animation-delay: .10s; } .pkg.go .row:nth-child(2) { animation-delay: .19s; }
      .pkg.go .row:nth-child(3) { animation-delay: .28s; } .pkg.go .row:nth-child(4) { animation-delay: .37s; }
      .pkg.go .row:nth-child(5) { animation-delay: .46s; } .pkg.go .row:nth-child(6) { animation-delay: .55s; }
      .pkg.go .row:nth-child(7) { animation-delay: .64s; }
      .row:not(.pkg.go .row) { }
      .fl { opacity: 0; transform: translateY(8px); transition: opacity .6s ease, transform .6s ease; }
      .pkg-stage.go .fl { opacity: 1; transform: none; animation: floatY 6s ease-in-out infinite; }
      .pkg-stage.go .fl-tl { animation-delay: .2s; } .pkg-stage.go .fl-tr { animation-delay: 1.4s; }
      .pkg-stage.go .fl-bl { animation-delay: .8s; } .pkg-stage.go .fl-br { animation-delay: 2.0s; }

      @media (max-width: 900px) {
        .hero-grid { grid-template-columns: 1fr; gap: 60px; }
        .pkg-stage { margin: 0 8px; }
        .cols { grid-template-columns: 1fr; }
        .fl-tl { left: 4px; } .fl-tr { right: 4px; } .fl-bl { left: 4px; } .fl-br { right: 4px; }
      }
      @media (max-width: 620px) {
        .hero { min-height: auto; padding: 34px 0 54px; }
        .pkg-stage { margin: 0 6px; }
        .fl { font-size: 10.5px; padding: 6px 11px; }
        .fl-tl { top: -14px; left: 2px; right: auto; }
        .fl-tr { top: -14px; right: 2px; left: auto; }
        .fl-bl { bottom: 24px; left: 2px; right: auto; }
        .fl-br { bottom: -12px; right: 2px; left: auto; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rise, .row, .fl { opacity: 1 !important; transform: none !important; transition: none !important; animation: none !important; }
        .pkg-stage.go .fl { animation: none !important; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <div class="glow"></div>
    <div class="wrap">
      <SiteHeader />

      <!-- SCREEN ONE -->
      <header class="hero">
        <div class="col hero-grid">
          <div class="hero-copy">
            <p class="eyebrow rise">Proofworks V2</p>
            <h1 class="hero-h rise" style="transition-delay:.06s">Recruiter-ready operators, validated through real work.</h1>
            <p class="hero-d rise" style="transition-delay:.12s">Proofworks identifies candidates with strong adjacent experience, evaluates them through role-specific work, and packages the evidence recruiters need to submit them confidently.</p>
          </div>

          <div class="pkg-stage" id="pkgStage">
            {floatLabels.map((f) => (<span class:list={['fl', f.c]}>{f.t}</span>))}
            <div class="pkg" id="pkg">
              <div class="pkg-head">
                <span class="pkg-title">Candidate Proof Package</span>
                <span class="pkg-dot" aria-hidden="true"></span>
              </div>
              {proofRows.map((r) => (
                <div class="row">
                  <span class="chk" aria-hidden="true">✓</span>
                  <span class="rl">{r}</span>
                  <span class="rs">Ready</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </header>

      <!-- SCREEN TWO -->
      <main class="col s2" id="figured-out">
        <p class="lbl rise">What we figured out</p>
        <h2 class="s2-h rise" style="transition-delay:.05s">The market does not need another general job marketplace.</h2>

        <ol class="findings">
          {findings.map((f, i) => (
            <li class="rise" style={`transition-delay:${0.05 + i * 0.05}s`}>
              <span class="fn">{String(i + 1).padStart(2, '0')}</span>
              <span>{f}</span>
            </li>
          ))}
        </ol>

        <div class="cols">
          <section class="card rise" id="for-candidates">
            <h3>Why candidates participate</h3>
            <ul>{candidateWhy.map((c) => (<li>{c}</li>))}</ul>
          </section>
          <section class="card rise" id="for-recruiters" style="transition-delay:.08s">
            <h3>Why recruiters use Proofworks</h3>
            <ul>{recruiterWhy.map((r) => (<li>{r}</li>))}</ul>
          </section>
        </div>

        <div class="closing">
          <h2 class="rise">Proofworks does not replace recruiters. <b>It gives them stronger candidates to place.</b></h2>
          <div class="cta-row rise" style="transition-delay:.08s">
            <a href={hardRoleMailto} class="btn btn-p">Send us a difficult role</a>
            <a href={candidateMailto} class="btn btn-s">Join the first candidate group</a>
          </div>
        </div>
      </main>

      <!-- FOOTER -->
      <footer class="foot" id="contact">
        <div class="foot-in">
          <div>
            <div class="foot-brand">Proofworks</div>
            <div class="foot-tag">Evidence before placement.</div>
          </div>
          <div class="foot-links">
            <a href={`mailto:${email}`}>Email</a>
            <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="/">Kyle Findlay</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        // scroll reveal
        const els = document.querySelectorAll('.rise');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
        } else {
          const obs = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } });
          }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
          els.forEach((el) => obs.observe(el));
        }
        // proof-package assembly: trigger stagger once in view
        const pkg = document.getElementById('pkg');
        const stage = document.getElementById('pkgStage');
        function go() { pkg && pkg.classList.add('go'); stage && stage.classList.add('go'); }
        if (reduce || !('IntersectionObserver' in window)) { go(); }
        else if (pkg) {
          const po = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => { if (e.isIntersecting) { go(); o.disconnect(); } });
          }, { threshold: 0.35 });
          po.observe(pkg);
        }
      })();
    </script>
  </body>
</html>
