---
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Proofworks — Capable operators for changing work';
const description = 'Proofworks identifies capable, AI-enabled operators and validates how they work—not only what appears on their résumé. A managed talent network on a path to capability infrastructure.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
const mail = (s: string) => `mailto:${email}?subject=${encodeURIComponent(s)}`;
const joinMail = mail('Proofworks — join the talent network');
const findMail = mail('Proofworks — find proven operators');
const partnerMail = mail('Proofworks — partner with Proofworks');

const heroSignals = ['Real work', 'Tool fluency', 'Judgment', 'Learning speed', 'Response to feedback', 'Role readiness'];
const people = [
  'Comfortable with ambiguity', 'Fast with new technology', 'Strong without perfect instructions',
  'Able to learn unfamiliar systems', 'Curious about how work can improve', 'Willing to take ownership',
  'Capable of delivering through change',
];
const stages = [
  { n: '01', t: 'Candidates join', lead: 'Candidates enter Proofworks because they want:', items: ['Access to relevant opportunities', 'A stronger way to demonstrate capability', 'Exposure to recruiters and companies', 'Less dependence on résumé keywords'] },
  { n: '02', t: 'Role readiness is evaluated', lead: 'Proofworks examines:', items: ['Relevant and transferable experience', 'Ability to learn unfamiliar workflows', 'Use of modern software and AI tools', 'Judgment under incomplete information', 'Response to feedback'] },
  { n: '03', t: 'A Proof Package is created', lead: 'The Proof Package may include:', items: ['Role-specific work sample', 'Explanation of decisions', 'Structured interview findings', 'Evidence of responding to feedback', 'Relevant experience', 'Strengths and risk flags', 'Compensation, location, and availability'] },
  { n: '04', t: 'Recruiters and companies gain access', lead: 'Recruiters receive candidates they can submit confidently.', items: ['Companies gain access to people who may be overlooked by conventional recruiting filters.'] },
  { n: '05', t: 'Proofworks earns through outcomes', lead: 'Proofworks initially earns through successful placements and placement-fee partnerships.', items: ['The long-term value comes from understanding which capabilities predict success as work changes.'] },
];
const candidateValue = ['Demonstrate ability through real work', 'Build a reusable Proof Package', 'Reach recruiters and companies', 'Move beyond narrow résumé categories'];
const recruiterValue = ['Placement-ready candidates', 'Evidence beyond résumé claims', 'Structured strengths and risk flags', 'Access to overlooked talent', 'Less wasted screening time'];
const industries = ['Field services', 'Facilities', 'Construction services', 'Logistics', 'Property operations', 'Multi-location businesses', 'Technology-enabled services'];
const roles = ['Service Operations', 'Implementation', 'Customer Operations', 'Revenue Operations', 'Workforce Operations', 'AI Workflow Coordination', 'Project Operations'];
const stage1Metrics = ['Candidates evaluated', 'Recruiter submissions', 'Employer interviews', 'Successful placements'];
const stage2Keywords = ['Capability profiles', 'Work evidence', 'Role transitions', 'Placement outcomes', 'Recruiter trust'];
const stage3Items = ['Which roles are changing', 'Which employees can transition', 'Which candidates can fill emerging capability gaps', 'What evidence predicts job performance', 'When to hire, retrain, or redesign work'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks-v2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root { --acc: #4c9dff; --acc2: #7c9cff; --ok: #57d1a0; --bg: #090a0e; --ink: #eef1f4; --mut: #97a0ab; --dim: #6b7480; --pane: rgba(255,255,255,0.035); --line: rgba(255,255,255,0.09); }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }
      a { text-decoration: none; color: inherit; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; margin: 0; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      .col { max-width: 1180px; margin: 0 auto; padding: 0 26px; }
      ::selection { background: rgba(76,157,255,0.26); }

      .glow { position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background: radial-gradient(58% 44% at 80% 8%, rgba(76,157,255,0.14), transparent 70%),
                    radial-gradient(50% 40% at 6% 92%, rgba(124,156,255,0.07), transparent 70%); }
      .wrap { position: relative; z-index: 1; }

      .lbl { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--acc); margin: 0; }
      .sec { padding: 92px 0; border-top: 1px solid rgba(255,255,255,0.05); }
      .sec-lead { color: var(--mut); font-size: clamp(15px, 1.6vw, 18px); line-height: 1.5; max-width: 60ch; }
      .btn { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 13.5px; padding: 13px 22px; border-radius: 12px; cursor: pointer; transition: transform .15s ease, opacity .15s ease, border-color .18s ease; }
      .btn-p { background: var(--acc); color: #04101f; border: 1px solid var(--acc); }
      .btn-p:hover { opacity: .92; transform: translateY(-1px); }
      .btn-s { background: transparent; color: var(--ink); border: 1px solid var(--line); }
      .btn-s:hover { border-color: rgba(255,255,255,0.4); transform: translateY(-1px); }
      .btns { display: flex; gap: 13px; flex-wrap: wrap; }

      /* ── HERO ── */
      .hero { padding: 60px 0 78px; }
      .hero-grid { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 56px; align-items: center; }
      .hero-h { font-size: clamp(38px, 5.6vw, 72px); line-height: 1.0; color: #fff; margin: 22px 0 0; max-width: 15ch; }
      .hero-p { color: var(--mut); font-size: clamp(16px, 1.6vw, 19px); line-height: 1.5; max-width: 44ch; }
      .hero-p + .hero-p { margin-top: 14px; }
      .hero-p b { color: #d7dde4; font-weight: 600; }
      .hero .btns { margin-top: 34px; }

      /* proof package (hero visual) */
      .pkg-stage { position: relative; }
      .pkg { position: relative; z-index: 2; background: linear-gradient(180deg, rgba(22,26,34,0.92), rgba(13,16,22,0.94));
        border: 1px solid var(--line); border-radius: 18px; padding: 18px; box-shadow: 0 40px 90px -50px rgba(0,0,0,0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
      .pkg-head { display: flex; align-items: center; justify-content: space-between; padding: 2px 4px 14px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
      .pkg-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15.5px; }
      .pkg-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 12px var(--acc); }
      .prow { display: flex; align-items: center; gap: 12px; padding: 11px 8px; border-radius: 10px; }
      .prow + .prow { border-top: 1px solid rgba(255,255,255,0.05); }
      .prow .chk { width: 20px; height: 20px; border-radius: 6px; flex-shrink: 0; display: grid; place-items: center; font-size: 11px;
        background: rgba(76,157,255,0.12); border: 1px solid rgba(76,157,255,0.35); color: var(--acc); }
      .prow .pl { font-size: 14px; color: #dbe1e8; flex: 1; }
      .prow .ps { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--ok); opacity: .85; }
      .fl { position: absolute; z-index: 3; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--ink);
        background: rgba(16,20,27,0.9); border: 1px solid var(--line); border-radius: 999px; padding: 7px 12px; white-space: nowrap; box-shadow: 0 16px 40px -22px rgba(0,0,0,0.9); }
      .fl::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--acc); margin-right: 7px; vertical-align: middle; box-shadow: 0 0 8px var(--acc); }
      .fl1 { top: -14px; left: 10px; } .fl2 { bottom: -14px; right: 10px; }

      /* ── SECTION 2 · PEOPLE ── */
      .people-stmt { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(26px, 4vw, 46px); line-height: 1.08; letter-spacing: -0.03em; color: #fff; margin: 22px 0 0; max-width: 20ch; }
      .phrases { margin: 46px 0 0; display: flex; flex-direction: column; gap: 6px; }
      .phrase { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(20px, 2.8vw, 34px); line-height: 1.12; letter-spacing: -0.02em; color: #cfd6de; }
      .phrase:nth-child(even) { padding-left: clamp(20px, 8vw, 120px); color: #aeb7c1; }
      .phrase .d { color: var(--acc); margin-right: 12px; font-family: 'JetBrains Mono', monospace; font-size: .5em; vertical-align: middle; }
      .people-close { margin: 44px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(18px, 2vw, 24px); line-height: 1.4; color: #fff; max-width: 30ch; }
      .people-close b { color: var(--acc); font-weight: 600; }

      /* ── SECTION 3 · FIGURED OUT (editorial) ── */
      .fig-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 3.4vw, 40px); color: #fff; margin: 20px 0 40px; }
      .fig { display: flex; flex-direction: column; gap: 26px; max-width: 1000px; }
      .f-lg { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.1; letter-spacing: -0.03em; color: #fff; max-width: 20ch; }
      .f-md { font-size: clamp(17px, 1.9vw, 22px); line-height: 1.4; color: #c3cbd4; max-width: 46ch; }
      .f-in { margin-left: clamp(24px, 14vw, 220px); }
      .f-accent { color: var(--acc); }

      /* ── SECTION 4 · HOW IT WORKS ── */
      .flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-top: 46px; position: relative; }
      .fnode { background: var(--pane); border: 1px solid var(--line); border-radius: 16px; padding: 18px 16px; position: relative; }
      .fnode::after { content: ''; position: absolute; top: 42px; right: -14px; width: 14px; height: 2px; background: linear-gradient(90deg, var(--acc), transparent); z-index: 2; }
      .fnode:last-child::after { display: none; }
      .fn-n { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--acc); }
      .fn-t { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 16px; color: #fff; margin: 8px 0 12px; line-height: 1.15; min-height: 2.3em; }
      .fn-lead { font-size: 12.5px; color: var(--mut); margin: 0 0 10px; line-height: 1.4; }
      .fnode ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; }
      .fnode li { font-size: 12.5px; line-height: 1.35; color: #c0c8d1; padding-left: 13px; position: relative; }
      .fnode li::before { content: ''; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; border-radius: 50%; background: var(--acc); opacity: .7; }

      /* ── SECTION 5 · TWO-SIDED ── */
      .two { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 42px; }
      .panel { background: var(--pane); border: 1px solid var(--line); border-radius: 20px; padding: 32px 30px; position: relative; overflow: hidden; }
      .panel::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--acc); opacity: .8; }
      .panel .ptag { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--acc); }
      .panel h3 { font-size: clamp(22px, 2.5vw, 30px); color: #fff; margin: 12px 0 12px; letter-spacing: -0.02em; }
      .panel .pcopy { color: var(--mut); font-size: 15.5px; line-height: 1.5; margin: 0 0 20px; }
      .panel ul { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 11px; }
      .panel li { display: flex; gap: 11px; font-size: 15.5px; line-height: 1.4; color: #c8cfd7; }
      .panel li::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); margin-top: 7px; flex-shrink: 0; }

      /* ── SECTION 6 · INITIAL MARKET ── */
      .mkt-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 3.6vw, 44px); color: #fff; margin: 20px 0 16px; letter-spacing: -0.03em; max-width: 20ch; }
      .chipset { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
      .clabel { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--dim); width: 100%; margin: 26px 0 2px; }
      .chip { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #cdd4dc; background: var(--pane); border: 1px solid var(--line); border-radius: 999px; padding: 9px 15px; }
      .chip.role { border-color: rgba(76,157,255,0.28); color: #dbe6f5; }
      .mkt-line { margin: 40px 0 0; font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(20px, 2.6vw, 32px); line-height: 1.25; letter-spacing: -0.025em; color: #fff; max-width: 26ch; border-left: 3px solid var(--acc); padding-left: 22px; }

      /* ── SECTION 7 · VENTURE PATH ── */
      .venture { position: relative; margin-top: 50px; padding-left: 34px; }
      .vrail { position: absolute; left: 7px; top: 6px; bottom: 90px; width: 2px; background: linear-gradient(180deg, rgba(76,157,255,0.1), var(--acc) 40%, rgba(76,157,255,0.5)); }
      .vstage { position: relative; margin-bottom: 30px; }
      .vstage::before { content: ''; position: absolute; left: -34px; top: 8px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--acc); box-shadow: 0 0 0 5px rgba(76,157,255,0.12); }
      .vcard { background: linear-gradient(160deg, rgba(76,157,255,0.06), rgba(255,255,255,0.02)); border: 1px solid var(--line); border-radius: 20px; padding: 26px 28px; }
      .vstage.s1 .vcard { max-width: 560px; }
      .vstage.s2 .vcard { max-width: 760px; }
      .vstage.s3 .vcard { max-width: 100%; border-color: rgba(76,157,255,0.3); }
      .v-lbl { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--acc); }
      .v-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; color: #fff; margin: 10px 0 10px; }
      .s1 .v-h { font-size: clamp(24px, 3vw, 32px); } .s2 .v-h { font-size: clamp(26px, 3.4vw, 38px); } .s3 .v-h { font-size: clamp(28px, 4vw, 48px); }
      .v-c { color: var(--mut); font-size: 15.5px; line-height: 1.5; max-width: 62ch; margin: 0; }
      .metrics { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
      .metric { background: rgba(255,255,255,0.03); border: 1px solid var(--line); border-radius: 12px; padding: 12px 15px; min-width: 150px; }
      .metric .mv { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 22px; color: var(--dim); }
      .metric .mk { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mut); margin-top: 4px; }
      .vkeys { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 18px; }
      .vkey { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: #cdd4dc; background: rgba(255,255,255,0.04); border: 1px solid var(--line); border-radius: 999px; padding: 8px 13px; }
      .vlist { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
      .vlist li { font-size: 15px; line-height: 1.35; color: #c8cfd7; padding-left: 14px; position: relative; }
      .vlist li::before { content: ''; position: absolute; left: 0; top: 8px; width: 6px; height: 6px; border-radius: 50%; background: var(--acc); }
      .v-close { margin-top: 20px; }
      .v-close .a { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(20px, 2.4vw, 28px); color: var(--mut); }
      .v-close .b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(24px, 3.4vw, 42px); line-height: 1.12; letter-spacing: -0.03em; color: #fff; margin-top: 8px; max-width: 22ch; }
      .v-close .b em { color: var(--acc); font-style: normal; }

      /* ── SECTION 8 · CLOSING ── */
      .close-h { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(30px, 5vw, 62px); line-height: 1.02; letter-spacing: -0.035em; color: #fff; max-width: 16ch; }
      .close-p { color: var(--mut); font-size: clamp(16px, 1.7vw, 19px); line-height: 1.5; max-width: 50ch; margin: 22px 0 0; }
      .close .btns { margin-top: 32px; }
      .foot { margin-top: 90px; border-top: 1px solid var(--line); }
      .foot-in { max-width: 1180px; margin: 0 auto; padding: 38px 26px 56px; display: flex; justify-content: space-between; gap: 28px; flex-wrap: wrap; align-items: flex-end; }
      .foot-b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 20px; }
      .foot-t { color: var(--mut); font-size: 14px; margin-top: 5px; }
      .foot-links { display: flex; gap: 20px; flex-wrap: wrap; }
      .foot-links a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--mut); transition: color .18s ease; }
      .foot-links a:hover { color: var(--acc); }

      /* ── reveal + motion ── */
      .rev { opacity: 0; transform: translateY(22px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); }
      .rev.in { opacity: 1; transform: none; }
      @keyframes rowLock { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
      @keyframes floatY { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
      .prow { opacity: 0; }
      .pkg.go .prow { animation: rowLock .55s cubic-bezier(.22,1,.36,1) forwards; }
      .pkg.go .prow:nth-child(2){animation-delay:.08s}.pkg.go .prow:nth-child(3){animation-delay:.17s}.pkg.go .prow:nth-child(4){animation-delay:.26s}
      .pkg.go .prow:nth-child(5){animation-delay:.35s}.pkg.go .prow:nth-child(6){animation-delay:.44s}.pkg.go .prow:nth-child(7){animation-delay:.53s}
      .fl { opacity: 0; transition: opacity .6s ease; }
      .pkg-stage.go .fl { opacity: 1; animation: floatY 6s ease-in-out infinite; }
      .pkg-stage.go .fl2 { animation-delay: 1.6s; }

      @media (max-width: 940px) {
        .hero-grid { grid-template-columns: 1fr; gap: 54px; }
        .flow { grid-template-columns: 1fr; gap: 12px; }
        .fnode::after { top: auto; right: auto; bottom: -13px; left: 30px; width: 2px; height: 13px; background: linear-gradient(180deg, var(--acc), transparent); }
        .fn-t { min-height: 0; }
        .two { grid-template-columns: 1fr; }
        .f-in { margin-left: clamp(16px, 8vw, 80px); }
      }
      @media (max-width: 620px) {
        .sec { padding: 68px 0; }
        .hero { padding: 40px 0 60px; }
        .phrase:nth-child(even) { padding-left: 22px; }
        .vlist { grid-template-columns: 1fr; }
        .venture { padding-left: 26px; } .vstage::before { left: -26px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rev, .prow, .fl { opacity: 1 !important; transform: none !important; transition: none !important; animation: none !important; }
        .pkg-stage.go .fl { animation: none !important; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <div class="glow"></div>
    <div class="wrap">
      <SiteHeader />

      <!-- 1 · HERO -->
      <header class="hero col">
        <div class="hero-grid">
          <div>
            <p class="lbl rev">Proofworks</p>
            <h1 class="hero-h rev" style="transition-delay:.05s">Capable operators for work that is changing faster than job titles.</h1>
            <p class="hero-p rev" style="transition-delay:.1s">Proofworks identifies people who can learn quickly, use modern tools, operate through ambiguity, and deliver inside rapidly changing companies.</p>
            <p class="hero-p rev" style="transition-delay:.14s"><b>We validate how they work</b>—not only what appears on their résumé.</p>
            <div class="btns rev" style="transition-delay:.2s">
              <a href={joinMail} class="btn btn-p">Join the talent network</a>
              <a href={findMail} class="btn btn-s">Find proven operators</a>
            </div>
          </div>
          <div class="pkg-stage" id="pkgStage">
            <span class="fl fl1">Signals in</span>
            <span class="fl fl2">Package ready</span>
            <div class="pkg" id="pkg">
              <div class="pkg-head"><span class="pkg-title">Candidate Proof Package</span><span class="pkg-dot" aria-hidden="true"></span></div>
              {heroSignals.map((s) => (
                <div class="prow"><span class="chk" aria-hidden="true">✓</span><span class="pl">{s}</span><span class="ps">Locked</span></div>
              ))}
            </div>
          </div>
        </div>
      </header>

      <!-- 2 · THE PEOPLE -->
      <section class="sec col">
        <p class="lbl rev">Who Proofworks is for</p>
        <h2 class="people-stmt rev" style="transition-delay:.05s">Not everyone wants to work at the edge of change. These people do.</h2>
        <div class="phrases">
          {people.map((p, i) => (
            <p class="phrase rev" style={`transition-delay:${0.04 * i}s`}><span class="d">/</span>{p}</p>
          ))}
        </div>
        <p class="people-close rev">Proofworks finds these people, validates their ability, and <b>helps the right companies discover them.</b></p>
      </section>

      <!-- 3 · WHAT WE FIGURED OUT -->
      <section class="sec col">
        <p class="lbl rev">What we figured out</p>
        <h2 class="fig-h rev" style="transition-delay:.05s">What we figured out</h2>
        <div class="fig">
          <p class="f-lg rev">The market does not need another general job board.</p>
          <p class="f-md f-in rev">“Adaptable operator” is a selection thesis—not a job title.</p>
          <p class="f-md rev">Training people from scratch would turn Proofworks into a school.</p>
          <p class="f-md f-in rev">Recruiters and companies already have hiring demand. What they lack is credible evidence that an unconventional candidate can perform.</p>
          <p class="f-md rev">Résumés describe where someone has been. They often fail to show what that person can do next.</p>
          <p class="f-md f-in rev">Short, role-specific work can reveal judgment, learning speed, tool fluency, and response to feedback.</p>
          <p class="f-md rev">Proofworks begins with one role, one relevant challenge, and one placement-ready candidate at a time.</p>
          <p class="f-md rev">The first milestone is not building a marketplace.</p>
          <p class="f-lg f-accent rev">It is making a successful placement that would not have happened without Proofworks.</p>
        </div>
      </section>

      <!-- 4 · HOW IT WORKS -->
      <section class="sec col">
        <p class="lbl rev">How it works</p>
        <div class="flow">
          {stages.map((s, i) => (
            <div class="fnode rev" style={`transition-delay:${0.06 * i}s`}>
              <span class="fn-n">{s.n}</span>
              <h3 class="fn-t">{s.t}</h3>
              <p class="fn-lead">{s.lead}</p>
              <ul>{s.items.map((it) => (<li>{it}</li>))}</ul>
            </div>
          ))}
        </div>
      </section>

      <!-- 5 · TWO-SIDED VALUE -->
      <section class="sec col">
        <p class="lbl rev">Two-sided value</p>
        <div class="two">
          <div class="panel rev">
            <span class="ptag">For candidates</span>
            <h3>More than another application portal.</h3>
            <p class="pcopy">Proofworks gives capable people a stronger way to show what they can do and where they could succeed next.</p>
            <ul>{candidateValue.map((c) => (<li>{c}</li>))}</ul>
            <a href={joinMail} class="btn btn-p">Join Proofworks</a>
          </div>
          <div class="panel rev" style="transition-delay:.08s">
            <span class="ptag">For recruiters &amp; companies</span>
            <h3>Stronger evidence before the interview.</h3>
            <p class="pcopy">Proofworks provides role-aligned candidates whose interest, availability, work quality, and potential have already been examined.</p>
            <ul>{recruiterValue.map((r) => (<li>{r}</li>))}</ul>
            <a href={partnerMail} class="btn btn-s">Access the talent network</a>
          </div>
        </div>
      </section>

      <!-- 6 · INITIAL MARKET -->
      <section class="sec col">
        <p class="lbl rev">Initial market</p>
        <h2 class="mkt-h rev" style="transition-delay:.05s">Starting where operational work is changing fastest.</h2>
        <p class="sec-lead rev" style="transition-delay:.08s">Proofworks is initially exploring AI-enabled operations and implementation talent for operationally complex companies.</p>
        <div class="chipset">
          <span class="clabel">Example industries</span>
          {industries.map((x, i) => (<span class="chip rev" style={`transition-delay:${0.03 * i}s`}>{x}</span>))}
          <span class="clabel">Example roles</span>
          {roles.map((x, i) => (<span class="chip role rev" style={`transition-delay:${0.03 * i}s`}>{x}</span>))}
        </div>
        <p class="mkt-line rev">The people who connect software, teams, customers, and real-world operations will become increasingly valuable.</p>
      </section>

      <!-- 7 · VENTURE-SCALE PATH -->
      <section class="sec col">
        <p class="lbl rev">The venture-scale path</p>
        <div class="venture">
          <span class="vrail" aria-hidden="true"></span>
          <div class="vstage s1 rev">
            <div class="vcard">
              <span class="v-lbl">Placements</span>
              <h3 class="v-h">Prove the transaction.</h3>
              <p class="v-c">Validate candidates, create Proof Packages, and generate successful placements.</p>
              <div class="metrics">
                {stage1Metrics.map((m) => (<div class="metric"><div class="mv">—</div><div class="mk">{m}</div></div>))}
              </div>
            </div>
          </div>
          <div class="vstage s2 rev">
            <div class="vcard">
              <span class="v-lbl">Talent network</span>
              <h3 class="v-h">Build reusable evidence of capability.</h3>
              <p class="v-c">Candidates maintain evolving records of work completed, tools used, feedback incorporated, industries understood, and outcomes achieved.</p>
              <div class="vkeys">{stage2Keywords.map((k) => (<span class="vkey">{k}</span>))}</div>
            </div>
          </div>
          <div class="vstage s3 rev">
            <div class="vcard">
              <span class="v-lbl">Capability infrastructure</span>
              <h3 class="v-h">Help companies understand who can do the work next.</h3>
              <p class="v-c">Proofworks can eventually help companies determine:</p>
              <ul class="vlist">{stage3Items.map((it) => (<li>{it}</li>))}</ul>
              <div class="v-close">
                <p class="a rev">The long-term opportunity is not another recruiting agency.</p>
                <p class="b rev" style="transition-delay:.1s">It is a <em>proprietary capability graph</em> connecting people, work, evidence, and outcomes.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 8 · FINAL POSITIONING -->
      <section class="sec col close">
        <h2 class="close-h rev">Evidence before placement. Capability beyond credentials.</h2>
        <p class="close-p rev" style="transition-delay:.06s">Proofworks is building a more credible way for capable people, recruiters, and companies to find one another as work changes.</p>
        <div class="btns rev" style="transition-delay:.12s">
          <a href={joinMail} class="btn btn-p">Join the talent network</a>
          <a href={partnerMail} class="btn btn-s">Partner with Proofworks</a>
        </div>
      </section>

      <footer class="foot">
        <div class="foot-in">
          <div>
            <div class="foot-b">Proofworks</div>
            <div class="foot-t">Built by Kyle Findlay</div>
          </div>
          <div class="foot-links">
            <a href="/">Main portfolio</a>
            <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href={`mailto:${email}`}>Email</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('.rev');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
        } else {
          const obs = new IntersectionObserver((entries, o) => {
            entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } });
          }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
          els.forEach((el) => obs.observe(el));
        }
        const pkg = document.getElementById('pkg');
        const stage = document.getElementById('pkgStage');
        const go = () => { pkg && pkg.classList.add('go'); stage && stage.classList.add('go'); };
        if (reduce || !('IntersectionObserver' in window)) { go(); }
        else if (pkg) {
          const po = new IntersectionObserver((en, o) => { en.forEach((e) => { if (e.isIntersecting) { go(); o.disconnect(); } }); }, { threshold: 0.4 });
          po.observe(pkg);
        }
      })();
    </script>
  </body>
</html>
