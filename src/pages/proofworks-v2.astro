---
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Proofworks — A capability layer for changing work';
const description = 'Proofworks helps people prove what they can do—and helps companies find the capabilities their changing work requires. Starting with placements, building the capability infrastructure for a job market in motion.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
const mail = (s: string) => `mailto:${email}?subject=${encodeURIComponent(s)}`;
const joinMail = mail('Proofworks — join Proofworks');
const partnerMail = mail('Proofworks — partner with Proofworks');

const incoming = ['People', 'Capabilities', 'Changing Work', 'Evidence', 'Outcomes'];
const outgoing = [
  { t: 'Recruiters', c: 'v' },
  { t: 'Companies', c: 'v' },
  { t: 'Placement', c: 'w' },
];
const progression = ['Placements', 'Talent Network', 'Capability Data', 'Hiring Infrastructure'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks-v2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root {
        --ink: #172449; --navy: #101a37; --mut: #5c688a; --soft: #8b94ad;
        --acc: #3f6ff0; --vio: #7d5cf0; --warm: #e08a4f; --line: rgba(28,44,92,0.12);
        --card: rgba(255,255,255,0.6);
      }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body { margin: 0; color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden;
        background: linear-gradient(178deg, #f5f9ff 0%, #eaf1fe 50%, #edf0fd 100%); }
      a { text-decoration: none; color: inherit; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.03em; margin: 0; color: var(--navy); }
      .mono { font-family: 'JetBrains Mono', monospace; }
      .col { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
      ::selection { background: rgba(63,111,240,0.18); }

      /* ambient soft glows */
      .amb { position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background: radial-gradient(42% 40% at 74% 16%, rgba(125,92,240,0.14), transparent 70%),
                    radial-gradient(46% 42% at 66% 24%, rgba(63,111,240,0.14), transparent 72%),
                    radial-gradient(40% 50% at 10% 88%, rgba(63,111,240,0.07), transparent 70%); }
      .wrap { position: relative; z-index: 1; }

      .btn { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 13.5px; padding: 13px 22px; border-radius: 12px; cursor: pointer; transition: transform .15s ease, box-shadow .2s ease, background-color .2s ease, border-color .2s ease; }
      .btn-p { background: var(--acc); color: #fff; border: 1px solid var(--acc); box-shadow: 0 14px 30px -14px rgba(63,111,240,0.7); }
      .btn-p:hover { transform: translateY(-1px); box-shadow: 0 18px 36px -14px rgba(63,111,240,0.8); }
      .btn-s { background: rgba(255,255,255,0.5); color: var(--navy); border: 1px solid var(--line); }
      .btn-s:hover { transform: translateY(-1px); border-color: rgba(28,44,92,0.28); }
      .btns { display: flex; gap: 13px; flex-wrap: wrap; }

      /* ── HERO ── */
      .hero { padding: 40px 0 70px; }
      .hero-in { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 40px; align-items: center; min-height: 74vh; }
      .hero-h { font-size: clamp(44px, 6.4vw, 88px); line-height: 0.98; letter-spacing: -0.04em; color: var(--navy); }
      .hero-h .accent { background: linear-gradient(96deg, var(--acc), var(--vio)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .hero-lead { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.55; color: var(--mut); margin: 26px 0 0; max-width: 42ch; }
      .hero-vision { font-size: clamp(15px, 1.5vw, 18px); line-height: 1.5; color: var(--ink); margin: 20px 0 0; max-width: 40ch; border-left: 2px solid var(--acc); padding-left: 16px; }
      .hero-vision b { color: var(--navy); font-weight: 600; }
      .hero .btns { margin-top: 32px; }

      /* visualization */
      .viz { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; }
      .nodes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
      .nodes.out { align-items: flex-end; text-align: right; }
      .node { display: flex; align-items: center; gap: 11px; font-size: 15px; font-weight: 500; color: var(--ink); white-space: nowrap; }
      .nodes.out .node { flex-direction: row-reverse; }
      .nicon { width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center;
        background: rgba(63,111,240,0.1); border: 1px solid rgba(63,111,240,0.4); }
      .nicon::after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); }
      .node.v .nicon { background: rgba(125,92,240,0.1); border-color: rgba(125,92,240,0.42); }
      .node.v .nicon::after { background: var(--vio); }
      .node.w .nicon { background: rgba(224,138,79,0.12); border-color: rgba(224,138,79,0.5); }
      .node.w .nicon::after { background: var(--warm); box-shadow: 0 0 10px rgba(224,138,79,0.8); }

      .ring-wrap { position: relative; width: 100%; aspect-ratio: 1 / 1; max-width: 460px; margin: 0 auto; }
      .ring-svg { width: 100%; height: 100%; display: block; overflow: visible; }
      .ring-label { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 14%; }
      .ring-label h2 { font-size: clamp(20px, 2.4vw, 30px); color: var(--navy); letter-spacing: -0.02em; }
      .ring-label p { font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 1.5; color: var(--mut); margin: 10px 0 0; max-width: 22ch; }

      /* ── generic section ── */
      .sec { padding: 108px 0; }
      .ey { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--acc); margin: 0 0 34px; }

      /* editorial statement stacks */
      .stmts { display: flex; flex-direction: column; gap: 10px; }
      .stmt { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 5vw, 60px); line-height: 1.04; letter-spacing: -0.035em; color: var(--navy); max-width: 20ch; }
      .stmt.dim { color: #9aa3bd; }
      .stmt.reveal-accent { background: linear-gradient(96deg, var(--acc), var(--vio)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .stmt.i1 { margin-left: clamp(20px, 9vw, 150px); }
      .stmt.i2 { margin-left: clamp(40px, 18vw, 300px); }
      .stmt.gap { margin-top: 26px; }
      .stmt.sm { font-size: clamp(24px, 3.6vw, 44px); font-weight: 500; }

      /* ── section 4 progression ── */
      .prog { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 8px; margin: 40px 0 40px; }
      .prog .p { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(16px, 2.1vw, 26px); letter-spacing: -0.02em; color: var(--navy); }
      .prog .p:nth-child(1){ color: var(--acc); } .prog .p:nth-child(7){ color: var(--vio); }
      .prog .ar { color: #a9b2cc; font-size: clamp(15px, 1.8vw, 22px); }
      .prog-copy { font-size: clamp(16px, 1.7vw, 19px); line-height: 1.55; color: var(--mut); max-width: 56ch; margin: 0 0 34px; }

      /* footer */
      .foot { margin-top: 30px; border-top: 1px solid var(--line); }
      .foot-in { max-width: 1180px; margin: 0 auto; padding: 36px 28px 56px; display: flex; justify-content: space-between; gap: 26px; flex-wrap: wrap; align-items: flex-end; }
      .foot-b { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 20px; color: var(--navy); }
      .foot-t { color: var(--mut); font-size: 14px; margin-top: 5px; }
      .foot-links { display: flex; gap: 20px; flex-wrap: wrap; }
      .foot-links a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--mut); transition: color .18s ease; }
      .foot-links a:hover { color: var(--acc); }

      /* ── reveal + ambient motion ── */
      .rev { opacity: 0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      .rev.in { opacity: 1; transform: none; }

      .ring-breathe { transform-box: fill-box; transform-origin: center; animation: breathe 8s ease-in-out infinite; }
      .ring-spin { transform-box: fill-box; transform-origin: center; animation: spin 64s linear infinite; }
      .stream-in { stroke-dasharray: 7 12; animation: flowIn 2.6s linear infinite; }
      .stream-out { stroke-dasharray: 7 12; animation: flowOut 3s linear infinite; }
      .twk { animation: twinkle 4.5s ease-in-out infinite; }
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.045); } }
      @keyframes flowIn { to { stroke-dashoffset: -190; } }
      @keyframes flowOut { to { stroke-dashoffset: 190; } }
      @keyframes twinkle { 0%,100% { opacity: .18; } 50% { opacity: .7; } }

      @media (max-width: 940px) {
        .hero-in { grid-template-columns: 1fr; gap: 46px; min-height: 0; }
        .viz { grid-template-columns: 1fr; gap: 24px; justify-items: center; }
        .nodes { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 12px 22px; order: 2; }
        .nodes.out { align-items: center; text-align: center; order: 3; }
        .nodes.out .node { flex-direction: row; }
        .ring-wrap { order: 1; max-width: 360px; }
        .stmt.i1, .stmt.i2 { margin-left: 0; }
      }
      @media (max-width: 560px) {
        .sec { padding: 74px 0; }
        .hero { padding: 26px 0 50px; }
        .node { font-size: 14px; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .rev { opacity: 1 !important; transform: none !important; transition: none !important; }
        .ring-breathe, .ring-spin, .stream-in, .stream-out, .twk { animation: none !important; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <div class="amb"></div>
    <div class="wrap">
      <SiteHeader />

      <!-- 1 · HERO -->
      <header class="hero col">
        <div class="hero-in">
          <div class="hero-copy">
            <h1 class="hero-h rev">Jobs are becoming <span class="accent">less static.</span></h1>
            <p class="hero-lead rev" style="transition-delay:.08s">Proofworks helps people prove what they can do—and helps companies find the capabilities their changing work requires.</p>
            <p class="hero-vision rev" style="transition-delay:.12s"><b>Starting with placements.</b> Building the capability infrastructure for a job market in motion.</p>
            <div class="btns rev" style="transition-delay:.18s">
              <a href="#engine" class="btn btn-p">See how it works</a>
            </div>
          </div>

          <div class="viz rev" style="transition-delay:.1s">
            <ul class="nodes in">
              {incoming.map((n) => (<li class="node"><span class="nicon" aria-hidden="true"></span>{n}</li>))}
            </ul>

            <div class="ring-wrap">
              <svg class="ring-svg" viewBox="0 0 400 400" role="img" aria-label="Capability Layer connecting people, work, evidence, and opportunity">
                <defs>
                  <linearGradient id="rg" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#4c7ef5" /><stop offset="1" stop-color="#8b6cf0" />
                  </linearGradient>
                  <radialGradient id="glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0" stop-color="#8b6cf0" stop-opacity="0.28" />
                    <stop offset="45%" stop-color="#4c7ef5" stop-opacity="0.14" />
                    <stop offset="100%" stop-color="#4c7ef5" stop-opacity="0" />
                  </radialGradient>
                </defs>
                <circle cx="200" cy="200" r="180" fill="url(#glow)" />
                <!-- incoming blue streams (left → center) -->
                <g fill="none" stroke="#4c7ef5" stroke-width="1.5" stroke-linecap="round" opacity="0.55">
                  <path class="stream-in" d="M4 96 C 90 118, 150 168, 196 196" />
                  <path class="stream-in" d="M0 172 C 80 176, 150 188, 196 200" style="animation-delay:.5s" />
                  <path class="stream-in" d="M6 250 C 90 236, 150 214, 196 204" style="animation-delay:1s" />
                  <path class="stream-in" d="M14 316 C 96 284, 150 232, 197 208" style="animation-delay:1.5s" />
                </g>
                <!-- outgoing violet streams (center → right) -->
                <g fill="none" stroke="#8b6cf0" stroke-width="1.5" stroke-linecap="round" opacity="0.5">
                  <path class="stream-out" d="M204 196 C 250 168, 320 138, 398 120" />
                  <path class="stream-out" d="M205 202 C 260 204, 330 210, 400 214" style="animation-delay:.6s" />
                  <path class="stream-out" d="M203 208 C 255 232, 320 270, 392 300" style="animation-delay:1.2s" />
                </g>
                <!-- breathing + rotating portal -->
                <g class="ring-breathe">
                  <g class="ring-spin">
                    <ellipse cx="200" cy="200" rx="120" ry="120" fill="none" stroke="url(#rg)" stroke-width="2" opacity="0.9" />
                    <ellipse cx="200" cy="200" rx="120" ry="86" fill="none" stroke="url(#rg)" stroke-width="1.4" opacity="0.55" transform="rotate(18 200 200)" />
                    <ellipse cx="200" cy="200" rx="86" ry="120" fill="none" stroke="url(#rg)" stroke-width="1.4" opacity="0.4" transform="rotate(-12 200 200)" />
                    <ellipse cx="200" cy="200" rx="104" ry="104" fill="none" stroke="#fff" stroke-width="1" opacity="0.5" stroke-dasharray="2 10" />
                  </g>
                </g>
                <!-- particles -->
                <g fill="#6b8cf2">
                  <circle class="twk" cx="120" cy="120" r="2.2" />
                  <circle class="twk" cx="290" cy="140" r="1.8" style="animation-delay:1s" />
                  <circle class="twk" cx="300" cy="270" r="2" style="animation-delay:2s" />
                  <circle class="twk" cx="110" cy="280" r="1.8" style="animation-delay:1.5s" />
                  <circle class="twk" cx="235" cy="300" r="2.2" style="animation-delay:.6s" />
                </g>
              </svg>
              <div class="ring-label">
                <h2>Capability Layer</h2>
                <p>A living connection between people, work, evidence, and opportunity.</p>
              </div>
            </div>

            <ul class="nodes out">
              {outgoing.map((n) => (<li class:list={['node', n.c]}><span class="nicon" aria-hidden="true"></span>{n.t}</li>))}
            </ul>
          </div>
        </div>
      </header>

      <!-- 2 · THE PROBLEM -->
      <section class="sec col">
        <p class="ey rev">The problem with current hiring</p>
        <div class="stmts">
          <p class="stmt rev">Experience matters.</p>
          <p class="stmt i1 rev">Credentials matter.</p>
          <p class="stmt sm dim gap rev">But neither fully proves who can do the work now.</p>
          <p class="stmt reveal-accent gap rev">Proofworks adds the missing evidence.</p>
        </div>
      </section>

      <!-- 3 · THE PROOFWORKS ENGINE -->
      <section class="sec col" id="engine">
        <p class="ey rev">The Proofworks Engine</p>
        <div class="stmts">
          <p class="stmt sm rev">Candidates join Proofworks.</p>
          <p class="stmt sm i1 rev">Capability is demonstrated through experience, evidence, and relevant work.</p>
          <p class="stmt sm i2 rev">Recruiters and companies see stronger signals before the interview.</p>
          <p class="stmt reveal-accent gap rev">Successful placements strengthen the network.</p>
        </div>
      </section>

      <!-- 4 · THE LARGER COMPANY -->
      <section class="sec col">
        <p class="ey rev">The larger company</p>
        <div class="stmts">
          <p class="stmt dim rev">Placements are the starting point.</p>
          <p class="stmt reveal-accent gap rev">Capability infrastructure is the company.</p>
        </div>
        <div class="prog rev">
          {progression.map((p, i) => (
            <>
              {i > 0 && <span class="ar" aria-hidden="true">→</span>}
              <span class="p mono">{p.toUpperCase()}</span>
            </>
          ))}
        </div>
        <p class="prog-copy rev">Proofworks can eventually connect people, changing roles, demonstrated capability, company demand, and employment outcomes into a living capability network.</p>
        <div class="btns rev">
          <a href={joinMail} class="btn btn-p">Join Proofworks</a>
          <a href={partnerMail} class="btn btn-s">Partner with Proofworks</a>
        </div>
      </section>

      <footer class="foot">
        <div class="foot-in">
          <div>
            <div class="foot-b">Proofworks</div>
            <div class="foot-t">Built by Kyle Findlay</div>
          </div>
          <div class="foot-links">
            <a href="/">Main portfolio</a>
            <a href={linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href={`mailto:${email}`}>Email</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('.rev');
        if (reduce || !('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('in')); return; }
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); o.unobserve(e.target); } });
        }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
