              ))}
            </div>
            <p class="impact" data-reveal style="margin-top:44px">The filter is not whether someone says they are <span class="dim">interested in AI.</span> It is whether they can <span class="accent">improve a real workflow.</span></p>
          </div>
        </section>

        <!-- THE PROOFWORKS ENGINE (standout stone band) -->
        <ProofworksEngine />

        <!-- SELECTIVE BY DESIGN -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Selective by design</p>
            <h2 class="mkt-h" data-reveal style="transition-delay:.05s">Not for everyone.</h2>
            <p class="mkt-lead" data-reveal style="transition-delay:.09s">Proofworks is for people with <b>judgment, agency, learning velocity,</b> and evidence they can improve messy workflows.</p>
            <div class="tiles3">
              {selective.map((t, i) => <div class="tile3" data-reveal style={`transition-delay:${i * 80}ms`}>{t}</div>)}
            </div>
          </div>
        </section>

        <!-- TRAINING HAS TO MOVE INTO THE WORK -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>The method</p>
            <h2 class="mkt-h" data-reveal style="transition-delay:.05s">Training has to move into the work.</h2>
            <p class="mkt-lead" data-reveal style="transition-delay:.09s">Watching lessons and learning terminology does not show whether someone can improve a business.</p>
            <p class="mkt-lead2" data-reveal style="transition-delay:.12s">The next version of workforce development will be built around real workflows, measured outputs, and people showing they can improve how a company operates.</p>
          </div>
        </section>

        <!-- WHERE COMPANIES PAY -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Where companies pay</p>
            <p class="mkt-lead" data-reveal style="transition-delay:.05s">Talent can enter Proofworks directly. Companies pay when that talent is ready for real company needs: as hires, contractors, internal mobility candidates, retrained employees, or ongoing access to a network of operators.</p>
            <div class="grid3">
              {pays.map((c, i) => (
                <div class="card" data-reveal style={`transition-delay:${i * 80}ms`}>
                  <h3 class="cardh" style={`color:${c.a}`}>{c.h}</h3>
                  <p class="cardb">{c.b}</p>
                </div>
              ))}
            </div>
            <p class="mini" data-reveal>The employer is the primary payer.</p>
          </div>
        </section>

        <!-- RELATIONSHIP LOOP -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>The relationship loop</p>
            <div class="loop" data-reveal style="transition-delay:.05s">
              {loop.map((n, i) => (
                <>
                  <span class="loop-node">{n}</span>
                  {i < loop.length - 1 && <span class="loop-arr" aria-hidden="true">→</span>}
                </>
              ))}
            </div>
            <p class="mkt-lead2" data-reveal style="transition-delay:.1s">Every successful operator can become a referral source, a future hiring manager, or the entry point into a new company.</p>
          </div>
        </section>

        <!-- ROLE UNIVERSE -->
        <section class="sec univ">
          <div class="col">
            <p class="eyebrow" data-reveal>The role universe</p>
            <h2 data-reveal style="transition-delay:.05s">A large, underserved talent market.</h2>
            <p class="sub" data-reveal>Every company has operators close to the work.</p>
            <div class="spanel">
              {clusters.map((c, i) => (
                <div class="urow" data-reveal style={`transition-delay:${i * 50}ms`}>
                  <div class="cat">{c.h}</div>
                  <div class="rl">{c.roles}</div>
                </div>
              ))}
            </div>

            <div class="breadth">
              <h3 class="breadth-h" data-reveal>And this isn't just a tech story.</h3>
              <p class="breadth-b" data-reveal style="transition-delay:.05s">The same operator exists everywhere: dispatchers, estimators, schedulers, coordinators, account managers, claims teams, field reps, and operators close to the work. <b>Every company adapting to new tools has people worth developing.</b></p>
              <div class="sectors" data-reveal style="transition-delay:.1s">
                {sectors.map((s) => <span class="sector">{s}</span>)}
              </div>
            </div>
          </div>
        </section>

        <!-- WHY THIS FOUNDER -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Why this founder</p>
            <p class="why-stmt" data-reveal style="transition-delay:.05s">Running complex client programs showed me that the people most capable of adapting, improving work, and taking on new responsibilities are often poorly represented by their formal roles.</p>
            <div class="stat-grid">
              <div class="stat" data-reveal>
                <div class="statnum" style="color:var(--g)" data-count data-count-to="3.1" data-count-dec="1" data-count-prefix="$" data-count-suffix="M+">$3.1M+</div>
                <div class="statlbl">owned annually</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.08s">
                <div class="statnum" style="color:var(--c)">$5–6M</div>
                <div class="statlbl">supported</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.16s">
                <div class="statnum" style="color:var(--g)">30–40</div>
                <div class="statlbl">programs / year</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.24s">
                <div class="statnum" style="color:var(--c)" data-count data-count-to="12" data-count-dec="0" data-count-suffix="+">12+</div>
                <div class="statlbl">national brands</div>
              </div>
            </div>
            <p class="why-close" data-reveal>Proofworks is the third iteration of this work: from labor-market intelligence, to talent signals, to work-sample infrastructure for adaptive talent.</p>
            <p class="why-close" data-reveal style="margin-top:14px"><b>Solo founder, moving fast,</b> relocating to San Francisco — open to technical cofounders building at the intersection of talent, workforce transformation, and real operator workflows.</p>
          </div>
        </section>

        <!-- LOOKING TO CONNECT -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Looking to connect with</p>
            <div class="meet-grid">
              {looking.map((m, i) => (
                <div class:list={["meet", m.full && "full"]} data-reveal style={`transition-delay:${i * 60}ms`}>
                  <span class="ar" style={`color:${m.a}`}>→</span>{m.t}
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- CONTACT -->
        <section class="sec" id="contact">
          <div class="col">
            <p class="eyebrow" data-reveal>Get in touch</p>
            <div class="contact-panel" data-reveal>
              <div class="contact-row">
                <div class="who">
                  <div class="avatar"><Image src={headshot} alt="Kyle Findlay" width={360} height={450} /></div>
                  <div>
                    <div class="nm">Kyle Findlay</div>
                    <div class="loc">San Francisco / Los Angeles</div>
                  </div>
                </div>
                <div class="contact-actions">
                  <button id="copy-email" class="btn-g" data-email={email} type="button"><span class="ce">Copy email</span> ⧉</button>
                  <a href={linkedin} target="_blank" rel="noopener" class="pill-out">LinkedIn ↗</a>
                </div>
              </div>
              <p class="contact-email">{email}</p>
              <p style="font-family:'Space Grotesk',sans-serif;font-weight:500;font-size:clamp(18px,2.1vw,24px);line-height:1.25;color:#eef1f4;margin:20px 0 0">Let's talk about <span style="color:var(--g)">talent, corporate pilots, or building this together.</span></p>
            </div>
            <div class="foot">
              <a href="/">About &amp; Contact</a>
              <a href="/proofworks-v1">Proofworks V1</a>
              <a href="/gtm-radar">GTM Radar V1</a>
              <a href="/radar-v2">GTM Radar V2</a>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      // ── background: aurora blobs (electric blue) + constellation ──
      (() => {
        const canvas = document.getElementById('bg');
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let W = 0, H = 0;
        function resize() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = window.innerWidth; H = window.innerHeight;
          canvas.width = W * dpr; canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize);
        const blobs = [
          { hue: 208, sat: 90, r: .44, ox: .24, oy: .32, ax: .12, ay: .10, sx: .075, sy: .055, op: 0.7,  so: .070 },
          { hue: 214, sat: 92, r: .56, ox: .77, oy: .40, ax: .13, ay: .12, sx: .105, sy: .125, op: 1.15, so: .085 },
          { hue: 200, sat: 80, r: .50, ox: .50, oy: .74, ax: .14, ay: .11, sx: .130, sy: .085, op: 0.75, so: .100 },
        ];
        const N = 200, pts = [];
        for (let i = 0; i < N; i++) pts.push({ x: Math.random(), y: Math.random(), vx: (Math.random() - .5) * 0.00012, vy: (Math.random() - .5) * 0.00012 });
        const start = performance.now();
        const maxD = 0.062;
        function frame(now) {
          const t = (now - start) / 1000;
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#090a0e'; ctx.fillRect(0, 0, W, H);
          ctx.globalCompositeOperation = 'lighter';
          for (const b of blobs) {
            const cx = (b.ox + Math.sin(t * b.sx) * b.ax) * W;
            const cy = (b.oy + Math.cos(t * b.sy) * b.ay) * H;
            const rad = b.r * Math.max(W, H) * 0.5 * (1 + Math.sin(t * 0.08 + b.hue) * 0.14);
            const op = b.op * (0.86 + 0.14 * Math.sin(t * (b.so ?? .08) + b.r * 12));
            const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
            g.addColorStop(0, `hsla(${b.hue}, ${b.sat}%, 66%, ${0.32 * op})`);
            g.addColorStop(0.34, `hsla(${b.hue}, ${b.sat}%, 55%, ${0.16 * op})`);
            g.addColorStop(0.7, `hsla(${b.hue}, ${b.sat}%, 45%, ${0.05 * op})`);
            g.addColorStop(1, `hsla(${b.hue}, ${b.sat}%, 45%, 0)`);
            ctx.fillStyle = g;
            ctx.beginPath(); ctx.arc(cx, cy, rad, 0, Math.PI * 2); ctx.fill();
          }
          ctx.globalCompositeOperation = 'source-over';
          for (let i = 0; i < N; i++) {
            const p = pts[i];
            if (!reduce) {
              p.x += p.vx; p.y += p.vy;
              if (p.x < 0 || p.x > 1) p.vx *= -1;
              if (p.y < 0 || p.y > 1) p.vy *= -1;
              p.x = Math.max(0, Math.min(1, p.x)); p.y = Math.max(0, Math.min(1, p.y));
            }
            for (let j = i + 1; j < N; j++) {
              const q = pts[j];
              const dx = p.x - q.x, dy = p.y - q.y, d = Math.hypot(dx, dy);
              if (d < maxD) {
                ctx.strokeStyle = `rgba(180,195,210,${0.09 * (1 - d / maxD)})`;
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(p.x * W, p.y * H); ctx.lineTo(q.x * W, q.y * H); ctx.stroke();
              }
            }
          }
          for (const p of pts) {
            ctx.fillStyle = 'rgba(200,210,222,0.45)';
            ctx.beginPath(); ctx.arc(p.x * W, p.y * H, 1.3, 0, Math.PI * 2); ctx.fill();
          }
          if (!reduce) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      // ── scroll reveal + count-up ──
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function countUp(el) {
          const to = parseFloat(el.dataset.countTo || '0');
          const dec = parseInt(el.dataset.countDec || '0', 10);
          const pre = el.dataset.countPrefix || '', suf = el.dataset.countSuffix || '';
          const dur = 1200, start = performance.now();
          function step(now) {
            const p = Math.min(1, (now - start) / dur);
            const e = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + (to * e).toFixed(dec) + suf;
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
        const els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          document.querySelectorAll('[data-count]').forEach((el) => countUp(el));
          return;
        }
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            const c = e.target.querySelector('[data-count]');
            if (c && !c.dataset.done) { c.dataset.done = '1'; countUp(c); }
            o.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => obs.observe(el));
      })();

      // ── copy email ──
      document.querySelectorAll('button[data-email]').forEach((btn) => {
        const label = btn.querySelector('.ce');
        const original = label ? label.textContent : '';
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(btn.dataset.email || ''); }
          catch { const t = document.createElement('textarea'); t.value = btn.dataset.email || ''; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); }
          if (label) { label.textContent = 'Copied!'; setTimeout(() => { label.textContent = original; }, 1600); }
        });
      });
    </script>
  </body>
</html>
