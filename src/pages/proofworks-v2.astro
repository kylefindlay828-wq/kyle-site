---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';
import Analytics from '@vercel/analytics/astro';
import ProofworksEngine from '../components/ProofworksEngineV2.astro';

const title = 'Proofworks V2 — Kyle Findlay';
const description = 'Proofworks is a selective, two-sided talent platform. Talent applies to become more valuable; companies pay for demonstrated capability. Work-sample talent infrastructure for adaptive operators.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';

const model = [
  { h: 'For companies', b: 'Identify, develop, redeploy, retain, hire, or contract trusted operators.', a: 'var(--c)' },
  { h: 'For talent', b: 'Build real workflow projects, sharpen capability, and create a stronger signal than a résumé line.', a: 'var(--g)' },
  { h: 'For recruiters', b: 'Match people through validated outputs, not keywords alone.', a: 'var(--c)' },
];

const flow = [
  { v: 'Select', l: 'Adaptive talent' },
  { v: 'Build', l: 'Real workflows' },
  { v: 'Validate', l: 'Work samples' },
  { v: 'Route', l: 'Jobs, projects, internal mobility' },
];

const selective = ['Learns by building', 'Handles ambiguity', 'Improves real workflows'];

const pays = [
  { h: 'Talent access & placement', b: 'Companies pay to access, hire, or contract operators with demonstrated capability.', a: 'var(--g)' },
  { h: 'Internal workforce transformation', b: 'Companies pay to identify, develop, redeploy, and retain people they already trust.', a: 'var(--c)' },
  { h: 'Ongoing talent network', b: 'Companies pay for continued access to adaptive operators, work samples, capability tracking, and additional teams or projects.', a: 'var(--g)' },
];

const loop = ['Join', 'Build', 'Validate', 'Route', 'Develop', 'Refer', 'Expand'];

const becomes = ['What work is changing?', 'Who can adapt?', 'What has each person demonstrated?', 'Which gaps remain?', 'Who is ready for which work?', 'Where is internal mobility possible?', 'Where is external talent required?', 'What economic value did the transformation create?'];

const clusters = [
  { h: 'Operations / execution', roles: 'project managers, program managers, operations associates, chiefs of staff, implementation specialists, business analysts' },
  { h: 'Customer / account', roles: 'account managers, account directors, customer success, client services, onboarding, renewals, partnerships managers' },
  { h: 'GTM / revenue operations', roles: 'RevOps analysts, sales ops, GTM ops, marketing ops, growth ops, recruiting ops, sales enablement' },
  { h: 'Product / delivery', roles: 'product ops, associate PMs, delivery managers, scrum masters, QA analysts, implementation analysts' },
  { h: 'Admin-heavy professional work', roles: 'paralegals, compliance analysts, insurance claims, healthcare admin, finance ops, procurement, HR coordinators' },
  { h: 'Field & frontline commercial', roles: 'field sales reps, inside sales, dispatch coordinators, service & install schedulers, estimators, branch operators, territory managers' },
];

const sectors = ['SaaS & software', 'Home & field services', 'Logistics & supply chain', 'Healthcare', 'Financial services', 'Insurance', 'Manufacturing', 'Construction', 'Retail & e-commerce', 'Professional services', 'Energy & utilities', 'Public sector'];

const looking = [
  { t: 'adaptable operators who want to demonstrate what they can build', a: 'var(--g)' },
  { t: 'companies and recruiters facing talent-signal gaps', a: 'var(--c)' },
  { t: 'technical cofounders or partners excited about work-sample talent infrastructure', a: 'var(--g)', full: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks-v2" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 74px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: #090a0e; color: #eef1f4;
        font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        --g: #4c9dff; --c: #4c9dff; --v: #4c9dff;
        overflow-x: hidden;
      }
      ::selection { background: rgba(76,157,255,0.26); }
      a { text-decoration: none; }
      p { overflow-wrap: break-word; }

      #bg { position: fixed; inset: 0; z-index: 0; display: block; }
      .dotgrid { position: fixed; inset: 0; z-index: 1; pointer-events: none;
        background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 34px 34px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%);
        mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%); }
      .wrap { position: relative; z-index: 2; }
      .col { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; }

      /* nav */
      .nav { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(14px);
        background: rgba(9,10,14,0.6); border-bottom: 1px solid rgba(255,255,255,0.07); }
      .nav-in { max-width: 1120px; margin: 0 auto; padding: 13px 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 14px; }
      .nav a { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #aab2bc; transition: color .2s; }
      .nav a:hover { color: #eef1f4; }
      .nav .brand { color: #eef1f4; }
      .nav-others { display: flex; align-items: center; gap: 12px; padding: 7px 16px;
        border: 1px solid rgba(255,255,255,0.08); border-radius: 100px; background: rgba(255,255,255,0.02); }
      .nav-others a { color: #8b94a0; }
      .nav-others .sep { color: #40474f; }
      .pw-pills { display: flex; gap: 8px; }
      .navpill { color: var(--g) !important; border: 1px solid rgba(76,157,255,0.42);
        border-radius: 100px; padding: 6px 14px; background: rgba(76,157,255,0.08); }
      .navpill.on { background: var(--g); color: #04101f !important; border-color: var(--g); }

      .sec { padding: 66px 0; }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--g); margin: 0 0 24px; }

      /* hero */
      .hero { padding: 110px 0 78px; }
      .brandname { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: clamp(22px, 2.7vw, 30px);
        letter-spacing: 0.16em; text-transform: uppercase; color: #eef1f4; margin: 0; }
      .brandsub { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 13px;
        letter-spacing: 0.1em; text-transform: uppercase; color: #8b94a0; margin: 8px 0 0; }
      .hero-head { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(44px, 8vw, 104px); line-height: .96; letter-spacing: -0.035em; color: #fff; margin: 22px 0 0; max-width: 1040px; }
      .hero-head .accent { color: var(--g); font-style: italic; }
      .hero-strong { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(22px, 3vw, 34px); line-height: 1.18; letter-spacing: -0.025em; color: #eef1f4; margin: 30px 0 0; max-width: 860px; }
      .hero-lead { font-size: clamp(17px, 2vw, 21px); line-height: 1.5; color: #b6bfc9; margin: 18px 0 0; max-width: 760px; }
      .hero-lead b { color: #fff; font-weight: 600; }
      .hero-doors { font-size: clamp(17px, 1.9vw, 21px); line-height: 1.45; color: #c7cdd4; margin: 22px 0 0; max-width: 740px;
        padding-left: 16px; border-left: 2px solid rgba(76,157,255,0.55); }
      .hero-doors b { color: var(--g); font-weight: 700; }
      .cta-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
      .btn-g { font-family: 'JetBrains Mono', monospace; font-size: 14px; background: var(--g); color: #04101f;
        padding: 13px 24px; border-radius: 100px; border: 0; cursor: pointer; transition: opacity .2s; }
      .btn-g:hover { opacity: .9; }
      .pill-out { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #eef1f4; border: 1px solid rgba(255,255,255,0.2);
        border-radius: 100px; padding: 12px 22px; transition: border-color .2s; }
      .pill-out:hover { border-color: rgba(255,255,255,0.45); }

      /* section headings + text */
      .mkt-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 4vw, 48px); line-height: 1.04; letter-spacing: -0.03em; color: #fff; margin: 0; max-width: 900px; }
      .mkt-lead { font-size: clamp(18px, 2vw, 22px); line-height: 1.45; color: #dbe1e8; margin: 20px 0 0; max-width: 900px; }
      .mkt-lead b { color: #fff; font-weight: 600; }
      .mkt-lead2 { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.55; color: #a9b2bd; margin: 18px 0 0; max-width: 860px; }
      .mini { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #9aa3ad; margin: 22px 0 0; letter-spacing: .02em; }

      /* impact / filter statement */
      .impact { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(26px, 4.2vw, 50px); line-height: 1.08; letter-spacing: -0.03em; color: #eef1f4; margin: 0; max-width: 1040px; }
      .impact .accent { color: var(--g); }
      .impact .dim { color: #7b8490; font-style: italic; }

      /* process flow */
      .flow { display: flex; align-items: flex-start; gap: 12px; margin-top: 30px; }
      .flow-stage { flex: 1 1 0; min-width: 0; }
      .flow-verb { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-style: italic; text-transform: uppercase;
        font-size: clamp(32px, 4.4vw, 56px); line-height: 1; letter-spacing: -0.035em; color: #fff; }
      .flow-label { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.02em; color: #a9b2bd; margin-top: 12px; }
      .flow-arrow { flex: 0 0 auto; align-self: center; color: var(--g); font-size: 30px; line-height: 1; padding-top: clamp(14px, 2vw, 26px); }

      /* cards */
      .card { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.05); border-radius: 16px; padding: 26px 28px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 28px; }
      .cardh { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 20px; letter-spacing: -0.02em; margin: 0 0 10px; }
      .cardb { font-size: 15px; line-height: 1.55; color: #aeb6c0; margin: 0; }

      /* selective tiles */
      .tiles3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 28px; }
      .tile3 { border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.05); border-radius: 16px; padding: 26px 24px;
        font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(18px, 2vw, 23px); letter-spacing: -0.02em; color: #eef1f4;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

      /* relationship loop */
      .loop { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 8px; }
      .loop-node { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(19px, 2.6vw, 32px); letter-spacing: -0.025em; color: #fff; }
      .loop-arr { color: var(--g); font-size: clamp(16px, 2vw, 24px); }

      /* what it becomes */
      .becomes { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(24px, 3.4vw, 42px); line-height: 1.14; letter-spacing: -0.03em; color: #fff; margin: 0; max-width: 1000px; }
      .becomes b { color: var(--g); }
      .outputs { list-style: none; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 44px; }
      .outputs li { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(16px, 1.8vw, 21px); letter-spacing: -0.015em; color: #cbd3dd; padding-left: 18px; position: relative; }
      .outputs li::before { content: "—"; position: absolute; left: 0; color: #5b6470; }

      /* role universe */
      .univ h2 { font-size: clamp(30px, 4.6vw, 52px); line-height: 1.02; margin: 0 0 6px; max-width: 760px; }
      .univ .sub { font-size: 17px; color: #a9b2bd; margin: 0 0 24px; }
      .spanel { border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); border-radius: 18px; padding: 4px 28px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .urow { display: grid; grid-template-columns: 260px 1fr; gap: 30px; padding: 20px 0; border-top: 1px solid rgba(255,255,255,0.09); }
      .urow:first-child { border-top: 0; }
      .urow .cat { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 18px; letter-spacing: -0.01em; color: #eef1f4; }
      .urow .rl { font-size: 15px; line-height: 1.5; color: #b6bfc9; }

      /* not just a tech story */
      .breadth { margin: 44px 0 0; }
      .breadth-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(23px, 3.4vw, 36px); line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 16px; }
      .breadth-b { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.55; color: #c7cdd4; margin: 0 0 24px; max-width: 900px; }
      .breadth-b b { color: #eef1f4; font-weight: 600; }
      .sectors { display: flex; flex-wrap: wrap; gap: 9px; }
      .sector { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: -0.01em;
        padding: 8px 15px; border-radius: 999px; color: #dfe4ea;
        border: 1px solid rgba(76,157,255,0.28); background: rgba(76,157,255,0.05); }

      /* why founder */
      .why-stmt { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(23px, 3.4vw, 36px); line-height: 1.2; letter-spacing: -0.025em; color: #eef1f4; margin: 0 0 34px; max-width: 900px; }
      .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
      .stat { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.05); border-radius: 16px; padding: 22px 20px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .statnum { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 40px; letter-spacing: -0.02em; line-height: 1; }
      .statlbl { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #9aa3ad; margin-top: 11px; letter-spacing: .02em; }
      .why-close { font-size: 17px; line-height: 1.55; color: #a9b2bd; margin: 32px 0 0; max-width: 700px; }
      .why-close b { color: #eef1f4; }

      /* looking to meet */
      .meet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .meet { display: flex; gap: 14px; align-items: center; border: 1px solid rgba(255,255,255,0.09);
        background: rgba(255,255,255,0.045); border-radius: 14px; padding: 20px 22px; font-size: 16px; color: #dfe4ea;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .meet .ar { flex-shrink: 0; }
      .meet.full { grid-column: 1 / -1; }

      /* contact */
      .contact-panel { border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; backdrop-filter: blur(6px);
        background: linear-gradient(140deg, rgba(76,157,255,0.1), rgba(76,157,255,0.04)); padding: 32px 34px; }
      .contact-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
      .who { display: flex; align-items: center; gap: 18px; }
      .avatar { width: 122px; height: 152px; border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.14); flex-shrink: 0; }
      .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top; transform: scale(1.35) translateY(-10%); transform-origin: top center; }
      .who .nm { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 23px; }
      .who .loc { color: #9aa3ad; font-size: 15px; margin-top: 3px; }
      .contact-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .contact-email { font-family: 'JetBrains Mono', monospace; font-size: 15px; color: #9aa3ad; margin: 22px 0 0; }
      .foot { display: flex; gap: 22px; flex-wrap: wrap; padding: 30px 0 60px; }
      .foot a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #7b8490; transition: color .2s; }
      .foot a:hover { color: var(--g); }

      /* reveal */
      [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      [data-reveal].in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }

      /* responsive */
      @media (max-width: 760px) {
        .flow { flex-direction: column; align-items: flex-start; gap: 0; margin-top: 22px; }
        .flow-stage { padding: 9px 0; }
        .flow-verb { font-size: clamp(32px, 11vw, 44px); }
        .flow-label { margin-top: 5px; }
        .flow-arrow { align-self: flex-start; padding: 2px 0 2px 10px; transform: rotate(90deg); }
      }
      @media (max-width: 900px) {
        .grid3, .tiles3 { grid-template-columns: 1fr 1fr; }
        .stat-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 620px) {
        .hero { padding: 84px 0 56px; }
        .grid3, .tiles3, .meet-grid, .stat-grid, .outputs { grid-template-columns: 1fr; }
        .urow { grid-template-columns: 1fr; gap: 6px; }
        .contact-row { flex-direction: column; align-items: flex-start; }
        .who { flex-direction: column; align-items: flex-start; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div class="dotgrid"></div>

    <div class="wrap">
      <!-- NAV -->
      <nav class="nav">
        <div class="nav-in">
          <a href="/" class="brand mono">Kyle Findlay</a>
          <div class="nav-others mono">
            <a href="/gtm-radar">GTM Radar V1</a>
            <span class="sep">·</span>
            <a href="/radar-v2">GTM Radar V2</a>
            <span class="sep">·</span>
            <a href="/">About &amp; Contact</a>
          </div>
          <div class="pw-pills">
            <a href="/proofworks-v1" class="navpill mono">Proofworks V1</a>
            <a href="/proofworks-v2" class="navpill mono on">Proofworks V2</a>
          </div>
        </div>
      </nav>

      <main>
        <!-- HERO -->
        <section class="hero">
          <div class="col">
            <div data-reveal>
              <p class="brandname">PROOFWORKS</p>
              <p class="brandsub">Founder thesis by Kyle Findlay</p>
            </div>
            <h1 class="hero-head" data-reveal style="transition-delay:.06s">Job titles are <span class="accent">lagging indicators.</span></h1>
            <p class="hero-strong" data-reveal style="transition-delay:.12s">The next workforce shift should not default to layoffs, generic training, or blind external hiring.</p>
            <p class="hero-lead" data-reveal style="transition-delay:.16s">Proofworks helps companies see who can adapt through real work — then <b>develop, redeploy, retain, or hire</b> the talent they need next.</p>
            <p class="hero-doors" data-reveal style="transition-delay:.2s"><b>One standard</b> for internal employees and external candidates.</p>
            <div class="cta-row" data-reveal style="transition-delay:.24s">
              <a href="mailto:kylefindlay828@gmail.com?subject=Apply%20as%20operator" class="btn-g">Apply as operator →</a>
              <a href="mailto:kylefindlay828@gmail.com?subject=Find%20operators" class="pill-out">Find operators</a>
              <a href="mailto:kylefindlay828@gmail.com?subject=Talk%20to%20Kyle" class="pill-out">Talk to Kyle</a>
            </div>
          </div>
        </section>

        <!-- WHAT IT BECOMES (moved up: after hero, before the model) -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>What it becomes</p>
            <p class="becomes" data-reveal style="transition-delay:.05s">The long-term product is not an online school or a recruiting agency. It is <b>workforce transformation infrastructure</b> for companies that want to adapt without giving up on their people.</p>
            <p class="mkt-lead2" data-reveal style="transition-delay:.1s">Proofworks helps answer:</p>
            <ul class="outputs" data-reveal style="transition-delay:.14s">
              {becomes.map((o) => <li>{o}</li>)}
            </ul>
            <p class="becomes" data-reveal style="margin-top:34px; font-size:clamp(21px,2.8vw,34px)">Proofworks turns <b>real company problems into working systems</b> — and connects companies with the people capable of building what they need next.</p>
          </div>
        </section>

        <!-- THE MODEL -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>The model</p>
            <h2 class="mkt-h" data-reveal style="transition-delay:.05s">Selective talent network.</h2>
            <p class="mkt-lead" data-reveal style="transition-delay:.09s"><b>Talent comes for career upside. Companies pay for demonstrated capability.</b></p>
            <p class="mkt-lead2" data-reveal style="transition-delay:.12s">Proofworks develops operators through real workflow projects, turns outputs into work samples, and connects the strongest talent with companies and teams that need them.</p>
            <div class="grid3">
              {model.map((c, i) => (
                <div class="card" data-reveal style={`transition-delay:${i * 80}ms`}>
                  <h3 class="cardh" style={`color:${c.a}`}>{c.h}</h3>
                  <p class="cardb">{c.b}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- THE PROCESS -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>The process</p>
            <div class="flow" data-reveal>
              {flow.map((s, i) => (
                <>
                  <div class="flow-stage">
                    <div class="flow-verb">{s.v}</div>
                    <div class="flow-label">{s.l}</div>
                  </div>
                  {i < flow.length - 1 && <div class="flow-arrow" aria-hidden="true">→</div>}
