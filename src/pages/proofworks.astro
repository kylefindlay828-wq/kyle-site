---
import Analytics from '@vercel/analytics/astro';
import WorkforceTransformationIndex from '../components/WorkforceTransformationIndexFinal.astro';
import ProofworksEngine from '../components/ProofworksEngineFinal.astro';
import SiteHeader from '../components/SiteHeader.astro';

const title = 'Proofworks — Kyle Findlay';
const description = 'Proofworks maps where AI is changing real workflows — where companies can develop or redeploy employees, redesign the work itself, or hire external talent. A workforce-transformation thesis by Kyle Findlay.';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 74px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: #090a0e; color: #eef1f4;
        font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        --g: #4c9dff; --c: #4c9dff;
        overflow-x: hidden;
      }
      ::selection { background: rgba(76,157,255,0.26); }
      a { text-decoration: none; }
      p { overflow-wrap: break-word; }

      #bg { position: fixed; inset: 0; z-index: 0; display: block; }
      .dotgrid { position: fixed; inset: 0; z-index: 1; pointer-events: none;
        background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 34px 34px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%);
        mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%); }
      .wrap { position: relative; z-index: 2; }
      .col { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; }

      .sec { padding: 62px 0; }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--g); margin: 0 0 20px; }
      .sec-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(26px, 3.6vw, 40px); line-height: 1.08; letter-spacing: -0.03em; color: #eef1f4; margin: 0; max-width: 900px; }
      .sec-sub { font-size: clamp(15px, 1.7vw, 18px); line-height: 1.55; color: #b6bfc9; margin: 16px 0 0; max-width: 720px; }

      /* hero */
      .hero { padding: 100px 0 66px; }
      .hero-head { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(44px, 8vw, 104px); line-height: .96; letter-spacing: -0.035em; color: #fff; margin: 20px 0 0; max-width: 1040px; }
      .hero-head .accent { color: var(--g); font-style: italic; }
      .hero-lead { font-size: clamp(17px, 2vw, 21px); line-height: 1.5; color: #b6bfc9; margin: 26px 0 0; max-width: 660px; }

      .idx-intro { padding-bottom: 6px; }

      /* minimal footer */
      .site-foot { border-top: 1px solid rgba(255,255,255,0.08); margin-top: 24px; }
      .foot { display: flex; gap: 22px; flex-wrap: wrap; align-items: center; padding: 26px 0 46px; }
      .foot span, .foot a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #7b8490; transition: color .2s; }
      .foot a:hover { color: var(--g); }

      [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      [data-reveal].in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }

      @media (max-width: 560px) {
        .hero { padding: 78px 0 50px; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div class="dotgrid"></div>

    <div class="wrap">
      <SiteHeader />

      <main>
        <!-- 1 · HERO -->
        <section class="hero">
          <div class="col">
            <p class="eyebrow" data-reveal>Proofworks — Workforce Transformation Thesis</p>
            <h1 class="hero-head" data-reveal style="transition-delay:.06s">Job titles are <span class="accent">lagging indicators.</span></h1>
            <p class="hero-lead" data-reveal style="transition-delay:.12s">Proofworks maps where AI is changing real workflows, where existing employees can be developed or redeployed, and where companies will need external talent.</p>
          </div>
        </section>

        <!-- 2 · WORKFORCE TRANSFORMATION INDEX -->
        <section class="sec idx-intro" id="index-intro">
          <div class="col">
            <p class="eyebrow" data-reveal>Workforce Transformation Index</p>
            <h2 class="sec-h" data-reveal style="transition-delay:.05s">Where should companies develop people—and where should the work itself change?</h2>
            <p class="sec-sub" data-reveal style="transition-delay:.1s">The index compares the urgency of workflow change with the value of developing the people currently doing the work.</p>
          </div>
        </section>
        <WorkforceTransformationIndex />

        <!-- 3 · THE PROOFWORKS ENGINE (final substantive section) -->
        <ProofworksEngine />
      </main>

      <footer class="site-foot">
        <div class="col foot">
          <span>© {year} Kyle Findlay</span>
          <a href="/">Kyle Findlay — About ↗</a>
        </div>
      </footer>
    </div>

    <script>
      // ── background: aurora blobs (electric blue) + constellation ──
      (() => {
        const canvas = document.getElementById('bg');
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let W = 0, H = 0;
        function resize() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = window.innerWidth; H = window.innerHeight;
          canvas.width = W * dpr; canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize);
        const blobs = [
          { hue: 208, sat: 90, r: .44, ox: .24, oy: .32, ax: .12, ay: .10, sx: .075, sy: .055, op: 0.7,  so: .070 },
          { hue: 214, sat: 92, r: .56, ox: .77, oy: .40, ax: .13, ay: .12, sx: .105, sy: .125, op: 1.15, so: .085 },
          { hue: 200, sat: 80, r: .50, ox: .50, oy: .74, ax: .14, ay: .11, sx: .130, sy: .085, op: 0.75, so: .100 },
        ];
        const N = 200, pts = [];
        for (let i = 0; i < N; i++) pts.push({ x: Math.random(), y: Math.random(), vx: (Math.random() - .5) * 0.00012, vy: (Math.random() - .5) * 0.00012 });
        const start = performance.now();
        const maxD = 0.062;
        function frame(now) {
          const t = (now - start) / 1000;
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#090a0e'; ctx.fillRect(0, 0, W, H);
          ctx.globalCompositeOperation = 'lighter';
          for (const b of blobs) {
            const cx = (b.ox + Math.sin(t * b.sx) * b.ax) * W;
            const cy = (b.oy + Math.cos(t * b.sy) * b.ay) * H;
            const rad = b.r * Math.max(W, H) * 0.5 * (1 + Math.sin(t * 0.08 + b.hue) * 0.14);
            const op = b.op * (0.86 + 0.14 * Math.sin(t * (b.so ?? .08) + b.r * 12));
            const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
            g.addColorStop(0, `hsla(${b.hue}, ${b.sat}%, 66%, ${0.32 * op})`);
            g.addColorStop(0.34, `hsla(${b.hue}, ${b.sat}%, 55%, ${0.16 * op})`);
            g.addColorStop(0.7, `hsla(${b.hue}, ${b.sat}%, 45%, ${0.05 * op})`);
            g.addColorStop(1, `hsla(${b.hue}, ${b.sat}%, 45%, 0)`);
            ctx.fillStyle = g;
            ctx.beginPath(); ctx.arc(cx, cy, rad, 0, Math.PI * 2); ctx.fill();
          }
          ctx.globalCompositeOperation = 'source-over';
          for (let i = 0; i < N; i++) {
            const p = pts[i];
            if (!reduce) {
              p.x += p.vx; p.y += p.vy;
              if (p.x < 0 || p.x > 1) p.vx *= -1;
              if (p.y < 0 || p.y > 1) p.vy *= -1;
              p.x = Math.max(0, Math.min(1, p.x)); p.y = Math.max(0, Math.min(1, p.y));
            }
            for (let j = i + 1; j < N; j++) {
              const q = pts[j];
              const dx = p.x - q.x, dy = p.y - q.y, d = Math.hypot(dx, dy);
              if (d < maxD) {
                ctx.strokeStyle = `rgba(180,195,210,${0.09 * (1 - d / maxD)})`;
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(p.x * W, p.y * H); ctx.lineTo(q.x * W, q.y * H); ctx.stroke();
              }
            }
          }
          for (const p of pts) {
            ctx.fillStyle = 'rgba(200,210,222,0.45)';
            ctx.beginPath(); ctx.arc(p.x * W, p.y * H, 1.3, 0, Math.PI * 2); ctx.fill();
          }
          if (!reduce) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      // ── scroll reveal ──
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          return;
        }
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            o.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
