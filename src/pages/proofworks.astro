---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';
import Analytics from '@vercel/analytics/astro';

const title = '/proofworks — Kyle Findlay';
const description = 'Proofworks retools the operators mid-market companies already have (dispatchers, coordinators, account managers, estimators) into people who rebuild their own workflows with AI. Employer-paid retooling, measured on real work. Proof over credentials.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 74px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: #06070a; color: #eef1f4;
        font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        --g: oklch(0.85 0.16 155); --c: oklch(0.8 0.15 232); --v: oklch(0.8 0.15 300);
        overflow-x: hidden;
      }
      ::selection { background: oklch(0.85 0.16 155 / 0.28); }
      a { text-decoration: none; }

      #bg { position: fixed; inset: 0; z-index: 0; display: block; }
      .dotgrid { position: fixed; inset: 0; z-index: 1; pointer-events: none;
        background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 34px 34px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 85%);
        mask-image: radial-gradient(ellipse at 50% 40%, #000 30%, transparent 85%); }
      .wrap { position: relative; z-index: 2; }
      .col { max-width: 1120px; margin: 0 auto; padding: 0 28px; }

      .disp { font-family: 'Space Grotesk', sans-serif; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; }

      /* nav */
      .nav { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(14px);
        background: rgba(6,7,10,0.55); border-bottom: 1px solid rgba(255,255,255,0.07); }
      .nav-in { max-width: 1120px; margin: 0 auto; padding: 13px 28px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 14px; }
      .nav a { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #aab2bc; transition: color .2s; }
      .nav a:hover { color: #eef1f4; }
      .nav .brand { color: #eef1f4; }
      .nav-others { display: flex; align-items: center; gap: 12px; padding: 7px 16px;
        border: 1px solid rgba(255,255,255,0.08); border-radius: 100px; background: rgba(255,255,255,0.02); }
      .nav-others a { color: #8b94a0; }
      .nav-others .sep { color: #40474f; }
      .navpill { color: var(--g) !important; border: 1px solid oklch(0.85 0.16 155 / 0.4);
        border-radius: 100px; padding: 6px 14px; background: oklch(0.85 0.16 155 / 0.06); }

      .sec { padding: 70px 0; }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--g); margin: 0 0 34px; }

      /* hero */
      .hero { padding: 120px 0 90px; }
      .hero .eyebrow { color: #8b94a0; letter-spacing: .18em; margin-bottom: 26px; }
      .brandblock { margin-bottom: 20px; }
      .brandname { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: clamp(24px, 2.9vw, 33px);
        letter-spacing: 0.15em; text-transform: uppercase; color: #eef1f4; margin: 0; }
      .brandsub { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 13px;
        letter-spacing: 0.1em; text-transform: uppercase; color: #8b94a0; margin: 8px 0 0; }
      .h1 { font-size: clamp(56px, 10vw, 132px); line-height: .92; letter-spacing: -0.03em; }
      .h1 .slash { color: #4b5560; }
      .h1 .grad { background: linear-gradient(100deg, var(--g), var(--c), var(--v));
        -webkit-background-clip: text; background-clip: text; color: transparent; }
      .subhead { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(22px, 3vw, 32px);
        line-height: 1.18; letter-spacing: -0.01em; margin: 30px 0 0; max-width: 780px; }
      .support { font-size: 19px; line-height: 1.55; color: #aeb6c0; margin: 20px 0 0; max-width: 620px; }
      .support b { color: #eef1f4; font-weight: 600; }
      .cta-row { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-top: 34px; }
      .btn-g { font-family: 'JetBrains Mono', monospace; font-size: 14px; background: var(--g); color: #06251a;
        padding: 14px 26px; border-radius: 100px; border: 0; cursor: pointer; transition: opacity .2s; }
      .btn-g:hover { opacity: .9; }
      .status { display: flex; align-items: center; gap: 10px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #8b94a0; }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--g); box-shadow: 0 0 12px var(--g); animation: pulseGlow 1.8s ease-in-out infinite; }
      /* full-width editorial hero */
      .hero-head { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(36px, 6.2vw, 72px); line-height: 1.0; letter-spacing: -0.03em; color: #eef1f4; margin: 18px 0 0; max-width: 1040px; }
      .hero-head .accent { color: var(--g); font-style: italic; }
      .hero-lead { font-family: 'Space Grotesk', sans-serif; font-weight: 400; font-size: clamp(19px, 2.1vw, 27px); line-height: 1.38; letter-spacing: -0.01em; color: #c7cdd4; margin: 26px 0 0; max-width: 960px; }
      .hero-lead b { color: #ffffff; font-weight: 600; }
      .hero-sub { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(24px, 2.9vw, 33px);
        line-height: 1.2; letter-spacing: -0.02em; color: #eef1f4; margin: 34px 0 6px; max-width: 900px; }
      .hero-sub .g { color: var(--g); }
      /* wide video band (lives lower on the page) */
      .video-band { position: relative; width: 100%; height: clamp(280px, 40vw, 440px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.12);
        background: linear-gradient(165deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
        display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .video-band .play { width: 74px; height: 74px; border-radius: 50%; background: var(--g); display: flex; align-items: center; justify-content: center; box-shadow: 0 14px 40px -10px rgba(0,0,0,.55); }
      .video-band .vlabel { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: #c7cdd4; margin-top: 20px; }
      .video-band .vsub { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--g); margin-top: 7px; }
      /* big impactful statement near the top */
      .impact { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 4.4vw, 52px); line-height: 1.08; letter-spacing: -0.025em; color: #eef1f4; margin: 0; max-width: 1040px; }
      .impact .accent { color: var(--g); }
      .impact .dim { color: #7b8490; font-style: italic; }

      /* section heading for "The bigger market" */
      .mkt-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(26px, 3.6vw, 40px); line-height: 1.08; letter-spacing: -0.02em; margin: 0; }
      .mkt-sub { font-size: 17px; line-height: 1.5; color: #aeb6c0; margin: 16px 0 22px; max-width: 640px; }
      .mkt-lead { font-size: clamp(18px, 2.1vw, 24px); line-height: 1.42; color: #dbe1e8; margin: 22px 0 0; max-width: 960px; }
      .mkt-lead b { color: #ffffff; font-weight: 600; }
      .mkt-lead .big { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.5em; letter-spacing: -0.02em; color: var(--g); }
      .mkt-lead2 { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.5; color: #aeb6c0; margin: 18px 0 26px; max-width: 900px; }
      .mkt-lead2 b { color: #eef1f4; font-weight: 600; }
      /* process flow — big italic verbs with arrows between */
      .flow { display: flex; align-items: flex-start; gap: 12px; margin-top: 30px; }
      .flow-stage { flex: 1 1 0; min-width: 0; }
      .flow-verb { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-style: italic; text-transform: uppercase;
        font-size: clamp(34px, 4.6vw, 58px); line-height: 1; letter-spacing: -0.035em; color: #eef1f4; }
      .flow-label { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.02em; color: #aeb6c0; margin-top: 12px; }
      .flow-arrow { flex: 0 0 auto; align-self: center; color: var(--g); font-size: 30px; line-height: 1; padding-top: clamp(16px, 2vw, 30px); }
      @media (max-width: 760px) {
        .flow { flex-direction: column; align-items: flex-start; gap: 0; margin-top: 22px; }
        .flow-stage { padding: 10px 0; }
        .flow-verb { font-size: clamp(34px, 10vw, 40px); }
        .flow-label { margin-top: 6px; }
        .flow-arrow { align-self: flex-start; padding: 2px 0 2px 12px; transform: rotate(90deg); }
      }
      /* strongest system step (Route) */
      .step-strong { border-color: color-mix(in srgb, var(--v) 45%, rgba(255,255,255,0.09)); background: rgba(255,255,255,0.075);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--v) 22%, transparent), 0 24px 50px -34px color-mix(in srgb, var(--v) 85%, transparent); }

      /* generic card */
      .card { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.05); border-radius: 18px; position: relative; overflow: hidden;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .spanel { border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.04); border-radius: 18px; padding: 26px 30px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

      /* system */
      .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
      .step { padding: 22px 22px 26px; }
      .step .glow { position: absolute; inset: 0; pointer-events: none; }
      .step .lbl { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; letter-spacing: .06em; position: relative; }
      .step h3 { font-size: 22px; margin: 14px 0 10px; position: relative; }
      .step p { font-size: 15px; line-height: 1.5; color: #aeb6c0; margin: 0; position: relative; }

      /* who we source */
      .source-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 44px; }
      .panel-title { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 26px; letter-spacing: -0.02em; margin: 0 0 22px; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; }
      .chip { font-family: 'JetBrains Mono', monospace; font-size: 13px; padding: 9px 15px; border-radius: 100px;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.14); color: #c7cdd4; }
      .evid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 26px; }
      .evid li { list-style: none; display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: #c7cdd4; line-height: 1.4; }
      .evid .ck { color: var(--g); }
      ul { margin: 0; padding: 0; }

      /* what we build */
      .intro { font-size: 19px; line-height: 1.5; color: #aeb6c0; margin: -14px 0 34px; max-width: 720px; }
      .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .role { padding: 24px 24px 26px; }
      .role h3 { font-size: 20px; margin: 0 0 10px; }
      .role .from { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #8b94a0; margin: 0 0 16px; line-height: 1.5; }
      .role .builds-lbl { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: .04em; margin: 0 0 11px; }
      .tags { display: flex; flex-wrap: wrap; gap: 7px; }
      .tag { font-size: 13px; padding: 5px 10px; border-radius: 8px; background: rgba(255,255,255,0.05); color: #c7cdd4; }

      /* role universe */
      .univ h2 { font-size: clamp(32px, 5vw, 56px); line-height: 1.02; margin: 0 0 30px; max-width: 760px; }
      .urow { display: grid; grid-template-columns: 280px 1fr; gap: 30px; padding: 24px 0; border-top: 1px solid rgba(255,255,255,0.09); }
      .urow:last-child { border-bottom: 1px solid rgba(255,255,255,0.09); }
      .urow .cat { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 19px; letter-spacing: -0.01em; }
      .urow .rl { font-size: 16px; line-height: 1.55; color: #eef1f4; font-weight: 500; }
      /* industry breadth — the market is huge */
      .breadth { margin: 46px 0 0; }
      .breadth-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(24px, 3.6vw, 38px);
        line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 16px; }
      .breadth-b { font-size: clamp(16px, 1.9vw, 19px); line-height: 1.6; color: #c7cdd4; margin: 0 0 26px; max-width: 860px; font-weight: 500; }
      .breadth-b b { color: #eef1f4; font-weight: 600; }
      .sectors { display: flex; flex-wrap: wrap; gap: 10px; }
      .sector { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 15px; letter-spacing: -0.01em;
        padding: 9px 16px; border-radius: 999px; color: #dfe4ea;
        border: 1px solid color-mix(in srgb, var(--g) 30%, rgba(255,255,255,0.1)); background: color-mix(in srgb, var(--g) 6%, rgba(255,255,255,0.03)); }

      /* proof of work */
      .pow { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0; align-items: center; }
      .pow-card { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.045); border-radius: 18px; padding: 26px 28px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .pow-card.after { border-color: oklch(0.85 0.16 155 / 0.3); background: oklch(0.85 0.16 155 / 0.05); }
      .pow-lbl { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 18px; }
      .pow li { list-style: none; display: flex; gap: 12px; align-items: center; font-size: 15px; margin: 12px 0; }
      .pow .before-l { color: #8892a0; } .pow .before-l .m { color: #5a636e; }
      .pow .after-l { color: #dfe4ea; } .pow .after-l .m { color: var(--g); }
      .arrow { font-size: 30px; color: var(--g); padding: 0 26px; animation: floaty 3s ease-in-out infinite; }
      .pow-close { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(22px, 3.4vw, 34px);
        line-height: 1.25; letter-spacing: -0.02em; margin: 44px 0 0; max-width: 900px; }
      .pow-close b { color: var(--g); font-weight: 500; }
      .pow-close .q { font-style: italic; color: #c7cdd4; }

      /* why me */
      .why-stmt { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(24px, 3.6vw, 38px);
        line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 40px; max-width: 900px; }
      .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
      .stat { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.05); border-radius: 16px; padding: 24px 22px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .statnum { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 44px; letter-spacing: -0.02em; line-height: 1; }
      .statlbl { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #9aa3ad; margin-top: 12px; letter-spacing: .02em; }
      .why-close { font-size: 18px; line-height: 1.55; color: #aeb6c0; margin: 36px 0 0; max-width: 640px; }

      /* looking to meet */
      .meet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .meet { display: flex; gap: 14px; align-items: center; border: 1px solid rgba(255,255,255,0.09);
        background: rgba(255,255,255,0.045); border-radius: 14px; padding: 20px 22px; font-size: 16px; color: #dfe4ea;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .meet .ar { flex-shrink: 0; }
      .meet.full { grid-column: 1 / -1; }

      /* contact */
      .contact-panel { border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; backdrop-filter: blur(6px);
        background: linear-gradient(140deg, oklch(0.85 0.16 155 / 0.06), oklch(0.8 0.15 300 / 0.05)); padding: 34px 36px; }
      .contact-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
      .who { display: flex; align-items: center; gap: 18px; }
      .avatar { width: 132px; height: 164px; border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.14); flex-shrink: 0; }
      .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top; transform: scale(1.35) translateY(-10%); transform-origin: top center; }
      .who .nm { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 24px; }
      .who .loc { color: #9aa3ad; font-size: 15px; margin-top: 3px; }
      .contact-actions { display: flex; align-items: center; gap: 12px; }
      .pill-out { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #eef1f4; border: 1px solid rgba(255,255,255,0.2);
        border-radius: 100px; padding: 12px 20px; transition: border-color .2s; }
      .pill-out:hover { border-color: rgba(255,255,255,0.4); }
      .contact-email { font-family: 'JetBrains Mono', monospace; font-size: 15px; color: #9aa3ad; margin: 22px 0 0; }
      .foot { display: flex; gap: 22px; flex-wrap: wrap; padding: 30px 0 60px; }
      .foot a { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #7b8490; transition: color .2s; }
      .foot a:hover { color: var(--g); }

      /* placeholder blocks — clearly marked for Kyle to fill */
      .ph { border: 1px dashed color-mix(in srgb, var(--g) 55%, rgba(255,255,255,0.22)); border-radius: 12px;
        background: oklch(0.85 0.16 155 / 0.045); padding: 15px 18px; margin: 16px 0 0; }
      .ph-lbl { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--g); display: block; margin: 0 0 7px; }
      .ph-b { font-size: 15px; line-height: 1.5; color: #aeb6c0; font-style: italic; margin: 0; }

      /* lineage — the spine */
      .lin-head { display: flex; align-items: center; gap: 12px; margin: 0 0 20px; flex-wrap: wrap; }
      .lin-step { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-style: italic; font-size: clamp(28px, 4.2vw, 50px); letter-spacing: -0.035em; color: #4b5560; }
      .lin-step.now { color: var(--g); }
      .lin-sep { color: var(--g); font-size: clamp(20px, 2.6vw, 30px); }
      .lin { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 30px; }
      .lin-card { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.04); border-radius: 18px; padding: 26px 26px 28px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .lin-card.now { border-color: color-mix(in srgb, var(--g) 45%, rgba(255,255,255,0.09)); background: oklch(0.85 0.16 155 / 0.05); }
      .lin-top { display: flex; align-items: baseline; gap: 10px; margin: 0 0 16px; flex-wrap: wrap; }
      .lin-tag { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 13px; letter-spacing: .1em; color: var(--g); }
      .lin-name { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 21px; letter-spacing: -0.02em; color: #eef1f4; }
      a.lin-name { transition: color .2s; }
      a.lin-name:hover { color: var(--g); }
      .lin-row { margin: 13px 0 0; }
      .lin-row .k { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #8b94a0; display: block; margin: 0 0 5px; }
      .lin-row .t { font-size: 15px; line-height: 1.5; color: #c7cdd4; }
      .lin-row .t.strong { color: #eef1f4; font-weight: 500; }

      /* wedge */
      .w-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(30px, 4.6vw, 54px); line-height: 1.04; letter-spacing: -0.025em; color: #eef1f4; margin: 0; max-width: 900px; }
      .w-block { margin: 34px 0 0; max-width: 820px; }
      .w-k { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--g); margin: 0 0 12px; }
      .w-b { font-size: clamp(17px, 1.9vw, 20px); line-height: 1.55; color: #dbe1e8; margin: 0; }
      .w-b b { color: #fff; font-weight: 600; }
      .w-steps { font-size: clamp(17px, 1.9vw, 20px); line-height: 1.6; color: #dbe1e8; margin: 0; }
      .w-keeper { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(19px, 2.2vw, 26px); line-height: 1.3; letter-spacing: -0.02em; color: #eef1f4; margin: 20px 0 0; }
      .w-keeper b { color: var(--g); font-weight: 600; }
      /* the money-shot paragraph carries extra weight */
      .w-b.big { font-size: clamp(19px, 2.4vw, 26px); line-height: 1.5; color: #eef1f4; }
      /* compact, low-key lineage strip */
      .lin-mini { font-family: 'JetBrains Mono', monospace; font-size: 14px; letter-spacing: .02em; color: #8b94a0; display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin: 0; }
      .lin-mini .lead { color: #c7cdd4; }
      .lin-mini a { color: #aab2bc; transition: color .2s; }
      .lin-mini a:hover { color: var(--g); }
      .lin-mini .s, .lin-mini .now { color: var(--g); }
      /* mission line */
      .mission { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(20px, 2.5vw, 28px); line-height: 1.3; letter-spacing: -0.02em; color: #eef1f4; margin: 26px 0 0; max-width: 860px; }
      .mission b { color: var(--g); font-weight: 600; }

      /* proof */
      .proof-lead { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(22px, 3vw, 32px); line-height: 1.2; letter-spacing: -0.02em; color: #eef1f4; margin: 0 0 4px; max-width: 840px; }
      .proof-b { font-size: clamp(17px, 1.9vw, 20px); line-height: 1.55; color: #c7cdd4; margin: 26px 0 24px; max-width: 780px; }
      .proof-b b { color: #eef1f4; font-weight: 600; }

      /* what it becomes */
      .becomes { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.22; letter-spacing: -0.02em; color: #eef1f4; margin: 0; max-width: 960px; }
      .becomes b { color: var(--g); font-weight: 600; }
      .becomes .dim { color: #8b94a0; }

      /* reveal + ambient motion */
      [data-reveal] { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      [data-reveal].in { opacity: 1; transform: none; }
      @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
      @keyframes pulseGlow { 0%,100% { opacity: .55; } 50% { opacity: 1; } }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        .arrow, .dot { animation: none !important; }
        html { scroll-behavior: auto; }
      }

      /* responsive */
      @media (max-width: 900px) {
        .hero-grid { grid-template-columns: 1fr; gap: 30px; }
        .lin { grid-template-columns: 1fr; }
        .grid4 { grid-template-columns: 1fr 1fr; }
        .grid3 { grid-template-columns: 1fr 1fr; }
        .source-grid { grid-template-columns: 1fr; gap: 40px; }
        .stat-grid { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 640px) {
        .hero { padding: 90px 0 60px; }
        .grid4, .grid3, .meet-grid, .evid, .stat-grid { grid-template-columns: 1fr; }
        .urow { grid-template-columns: 1fr; gap: 8px; }
        .pow { grid-template-columns: 1fr; gap: 16px; }
        .arrow { transform: rotate(90deg); padding: 4px 0; }
        .contact-row { flex-direction: column; align-items: flex-start; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div class="dotgrid"></div>

    <div class="wrap">
      <!-- NAV -->
      <nav class="nav">
        <div class="nav-in">
          <a href="/" class="brand mono">Kyle Findlay</a>
          <div class="nav-others mono">
