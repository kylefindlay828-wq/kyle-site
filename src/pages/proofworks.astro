---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';
import Analytics from '@vercel/analytics/astro';
import WorkforceTransformationIndex from '../components/WorkforceTransformationIndexFinal.astro';
import ProofworksEngine from '../components/ProofworksEngineFinal.astro';

const title = 'Proofworks — Kyle Findlay';
const description = 'Workforce transformation infrastructure. Proofworks helps companies see who can adapt through real work — then develop, redeploy, retain, or hire the talent they need next. One standard for internal employees and external candidates.';

const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
const talk = 'mailto:kylefindlay828@gmail.com?subject=Talk%20to%20Kyle%20about%20Proofworks';

const sectors = ['AI labs & software', 'Home & field services', 'Logistics & supply chain', 'Healthcare administration', 'Insurance', 'Financial operations', 'Construction', 'Manufacturing', 'Property & facilities', 'Professional services', 'Retail & hospitality', 'Energy & utilities', 'Public sector'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kylefindlay.xyz/proofworks" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-proofworks.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 74px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: #090a0e; color: #eef1f4;
        font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        --g: #4c9dff; --c: #4c9dff;
        overflow-x: hidden;
      }
      ::selection { background: rgba(76,157,255,0.26); }
      a { text-decoration: none; }
      p { overflow-wrap: break-word; }

      #bg { position: fixed; inset: 0; z-index: 0; display: block; }
      .dotgrid { position: fixed; inset: 0; z-index: 1; pointer-events: none;
        background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
        background-size: 34px 34px;
        -webkit-mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%);
        mask-image: radial-gradient(ellipse at 50% 22%, #000 24%, transparent 64%); }
      .wrap { position: relative; z-index: 2; }
      .col { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
      .mono { font-family: 'JetBrains Mono', monospace; }
      h1, h2, h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; }

      /* minimal nav — no version labels */
      .nav { position: sticky; top: 0; z-index: 20; backdrop-filter: blur(14px);
        background: rgba(9,10,14,0.6); border-bottom: 1px solid rgba(255,255,255,0.07); }
      .nav-in { max-width: 1120px; margin: 0 auto; padding: 13px 28px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .nav .brand { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #eef1f4; }
      .nav .talk { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--g);
        border: 1px solid rgba(76,157,255,0.42); border-radius: 100px; padding: 7px 16px; background: rgba(76,157,255,0.08); transition: background .2s; }
      .nav .talk:hover { background: rgba(76,157,255,0.16); }

      .sec { padding: 66px 0; }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--g); margin: 0 0 24px; }

      /* hero */
      .hero { padding: 104px 0 70px; }
      .brandname { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: clamp(22px, 2.7vw, 30px);
        letter-spacing: 0.16em; text-transform: uppercase; color: #eef1f4; margin: 0; }
      .brandsub { font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 13px;
        letter-spacing: 0.1em; text-transform: uppercase; color: #8b94a0; margin: 8px 0 0; }
      .hero-head { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(44px, 8vw, 104px); line-height: .96; letter-spacing: -0.035em; color: #fff; margin: 22px 0 0; max-width: 1040px; }
      .hero-head .accent { color: var(--g); font-style: italic; }
      .hero-lead { font-size: clamp(17px, 2vw, 21px); line-height: 1.5; color: #b6bfc9; margin: 26px 0 0; max-width: 760px; }
      .hero-strong { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(22px, 3vw, 34px); line-height: 1.18; letter-spacing: -0.025em; color: #eef1f4; margin: 20px 0 0; max-width: 880px; }
      .hero-strong b { color: var(--g); font-weight: 600; }
      .hero-doors { font-size: clamp(17px, 1.9vw, 21px); line-height: 1.45; color: #c7cdd4; margin: 22px 0 0; max-width: 740px;
        padding-left: 16px; border-left: 2px solid rgba(76,157,255,0.55); }
      .hero-doors b { color: var(--g); font-weight: 700; }
      .cta-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 34px; }
      .btn-g { font-family: 'JetBrains Mono', monospace; font-size: 14px; background: var(--g); color: #04101f;
        padding: 13px 24px; border-radius: 100px; border: 0; cursor: pointer; transition: opacity .2s; }
      .btn-g:hover { opacity: .9; }
      .pill-out { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: #eef1f4; border: 1px solid rgba(255,255,255,0.2);
        border-radius: 100px; padding: 12px 22px; transition: border-color .2s; }
      .pill-out:hover { border-color: rgba(255,255,255,0.45); }

      /* what it becomes */
      .becomes { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(24px, 3.4vw, 42px); line-height: 1.14; letter-spacing: -0.03em; color: #fff; margin: 0; max-width: 1000px; }
      .becomes b { color: var(--g); }

      /* filter statement */
      .filter-sec { padding: 30px 0; }
      .filter-rule { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
      .impact { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(26px, 4.2vw, 50px); line-height: 1.08; letter-spacing: -0.03em; color: #eef1f4; margin: 0; max-width: 1040px;
        border-left: 3px solid var(--g); padding-left: 24px; }
      .impact .accent { color: var(--g); }
      .impact .dim { color: #7b8490; font-style: italic; }

      /* not just a tech story */
      .breadth-h { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: clamp(28px, 4vw, 48px); line-height: 1.06; letter-spacing: -0.03em; margin: 0 0 16px; }
      .breadth-b { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.55; color: #c7cdd4; margin: 0 0 26px; max-width: 940px; }
      .breadth-b b { color: #eef1f4; font-weight: 600; }
      .sectors { display: flex; flex-wrap: wrap; gap: 9px; }
      .sector { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 14px; letter-spacing: -0.01em;
        padding: 8px 15px; border-radius: 999px; color: #dfe4ea;
        border: 1px solid rgba(76,157,255,0.28); background: rgba(76,157,255,0.05); }

      /* why founder */
      .why-stmt { font-family: 'Space Grotesk', sans-serif; font-weight: 500; font-size: clamp(23px, 3.4vw, 36px); line-height: 1.2; letter-spacing: -0.025em; color: #eef1f4; margin: 0 0 34px; max-width: 940px; }
      .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
      .stat { border: 1px solid rgba(255,255,255,0.09); background: rgba(255,255,255,0.05); border-radius: 16px; padding: 22px 20px;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
      .statnum { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 40px; letter-spacing: -0.02em; line-height: 1; }
      .statlbl { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #9aa3ad; margin-top: 11px; letter-spacing: .02em; }
      .why-close { font-size: 17px; line-height: 1.55; color: #a9b2bd; margin: 32px 0 0; max-width: 760px; }
      .why-close b { color: #eef1f4; }

      /* contact */
      .contact-panel { border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; backdrop-filter: blur(6px);
        background: linear-gradient(140deg, rgba(76,157,255,0.1), rgba(76,157,255,0.04)); padding: 32px 34px; }
      .contact-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
      .who { display: flex; align-items: center; gap: 18px; }
      .avatar { width: 122px; height: 152px; border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,0.14); flex-shrink: 0; }
      .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: top; transform: scale(1.35) translateY(-10%); transform-origin: top center; }
      .who .nm { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 23px; }
      .who .loc { color: #9aa3ad; font-size: 15px; margin-top: 3px; }
      .contact-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
      .contact-email { font-family: 'JetBrains Mono', monospace; font-size: 15px; color: #9aa3ad; margin: 22px 0 0; }
      .foot { display: flex; gap: 22px; flex-wrap: wrap; padding: 30px 0 60px; }
      .foot a, .foot span { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: #7b8490; transition: color .2s; }
      .foot a:hover { color: var(--g); }

      /* reveal */
      [data-reveal] { opacity: 0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
      [data-reveal].in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
        html { scroll-behavior: auto; }
      }

      @media (max-width: 900px) { .stat-grid { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 620px) {
        .hero { padding: 80px 0 52px; }
        .stat-grid { grid-template-columns: 1fr; }
        .contact-row { flex-direction: column; align-items: flex-start; }
        .who { flex-direction: column; align-items: flex-start; }
      }
    </style>
    <Analytics />
  </head>
  <body>
    <canvas id="bg"></canvas>
    <div class="dotgrid"></div>

    <div class="wrap">
      <nav class="nav">
        <div class="nav-in">
          <a href="/" class="brand">Kyle Findlay</a>
          <a href={talk} class="talk">Talk to Kyle →</a>
        </div>
      </nav>

      <main>
        <!-- 1 · HERO -->
        <section class="hero">
          <div class="col">
            <div data-reveal>
              <p class="brandname">PROOFWORKS</p>
              <p class="brandsub">Founder thesis by Kyle Findlay</p>
            </div>
            <h1 class="hero-head" data-reveal style="transition-delay:.06s">Job titles are <span class="accent">lagging indicators.</span></h1>
            <p class="hero-lead" data-reveal style="transition-delay:.12s">The next workforce shift should not default to layoffs, generic training, or blind external hiring.</p>
            <p class="hero-strong" data-reveal style="transition-delay:.18s">Proofworks helps companies see who can adapt through real work — then <b>develop, redeploy, retain, or hire</b> the talent they need next.</p>
            <p class="hero-doors" data-reveal style="transition-delay:.24s"><b>One standard</b> for internal employees and external candidates.</p>
            <div class="cta-row" data-reveal style="transition-delay:.28s">
              <a href={talk} class="btn-g">Talk to Kyle →</a>
            </div>
          </div>
        </section>

        <!-- 2 · WHAT IT BECOMES -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>What it becomes</p>
            <p class="becomes" data-reveal style="transition-delay:.05s"><b>Workforce transformation infrastructure</b> for companies that want to adapt without giving up on their people.</p>
            <p class="becomes" data-reveal style="transition-delay:.1s; margin-top:22px; font-size:clamp(20px,2.6vw,32px); color:#c7cdd4">Understand what work is changing, who can grow with it, and where external talent is genuinely required.</p>
          </div>
        </section>

        <!-- 3 · WORKFORCE TRANSFORMATION INDEX -->
        <WorkforceTransformationIndex />

        <!-- 4 · THE FILTER -->
        <section class="filter-sec">
          <div class="filter-rule">
            <p class="impact" data-reveal>The filter is not whether someone says they are <span class="dim">interested in AI.</span> It is whether they can <span class="accent">improve a real workflow.</span></p>
          </div>
        </section>

        <!-- 5 · THE PROOFWORKS ENGINE -->
        <ProofworksEngine />

        <!-- 6 · THIS ISN'T JUST A TECH STORY -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Market breadth</p>
            <h2 class="breadth-h" data-reveal style="transition-delay:.05s">This isn't just a tech story.</h2>
            <p class="breadth-b" data-reveal style="transition-delay:.08s">Proofworks targets <b>workflow-heavy work wherever it exists</b> — from technical teams to the people running services, logistics, healthcare administration, construction planning, manufacturing, finance, and public systems.</p>
            <div class="sectors" data-reveal style="transition-delay:.12s">
              {sectors.map((s) => <span class="sector">{s}</span>)}
            </div>
          </div>
        </section>

        <!-- 7 · WHY THIS FOUNDER -->
        <section class="sec">
          <div class="col">
            <p class="eyebrow" data-reveal>Why this founder</p>
            <p class="why-stmt" data-reveal style="transition-delay:.05s">Running complex client programs showed me that the people most capable of adapting, improving work, and taking on new responsibilities are often poorly represented by their formal roles.</p>
            <div class="stat-grid">
              <div class="stat" data-reveal>
                <div class="statnum" style="color:var(--g)" data-count data-count-to="3.1" data-count-dec="1" data-count-prefix="$" data-count-suffix="M+">$3.1M+</div>
                <div class="statlbl">owned annually</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.08s">
                <div class="statnum" style="color:var(--c)">$5–6M</div>
                <div class="statlbl">supported</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.16s">
                <div class="statnum" style="color:var(--g)">30–40</div>
                <div class="statlbl">programs / year</div>
              </div>
              <div class="stat" data-reveal style="transition-delay:.24s">
                <div class="statnum" style="color:var(--c)" data-count data-count-to="12" data-count-dec="0" data-count-suffix="+">12+</div>
                <div class="statlbl">national brands</div>
              </div>
            </div>
            <p class="why-close" data-reveal style="margin-top:32px"><b>Solo founder, relocating to San Francisco</b> — looking to meet technical cofounders and early partners building at the intersection of workforce transformation and real company workflows.</p>
          </div>
        </section>

        <!-- 8 · CONTACT -->
        <section class="sec" id="contact">
          <div class="col">
            <p class="eyebrow" data-reveal>Contact</p>
            <div class="contact-panel" data-reveal>
              <div class="contact-row">
                <div class="who">
                  <div class="avatar"><Image src={headshot} alt="Kyle Findlay" width={360} height={450} /></div>
                  <div>
                    <div class="nm">Kyle Findlay</div>
                    <div class="loc">San Francisco / Los Angeles</div>
                  </div>
                </div>
                <div class="contact-actions">
                  <button id="copy-email" class="btn-g" data-email={email} type="button"><span class="ce">Copy email</span> ⧉</button>
                  <a href={linkedin} target="_blank" rel="noopener" class="pill-out">LinkedIn ↗</a>
                  <a href={talk} class="pill-out">Talk to Kyle →</a>
                </div>
              </div>
              <p class="contact-email">{email}</p>
            </div>
            <div class="foot">
              <span>© Kyle Findlay</span>
              <a href="/">About</a>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      // ── background: aurora blobs (electric blue) + constellation ──
      (() => {
        const canvas = document.getElementById('bg');
        if (!(canvas instanceof HTMLCanvasElement)) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let W = 0, H = 0;
        function resize() {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          W = window.innerWidth; H = window.innerHeight;
          canvas.width = W * dpr; canvas.height = H * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }
        resize();
        window.addEventListener('resize', resize);
        const blobs = [
          { hue: 208, sat: 90, r: .44, ox: .24, oy: .32, ax: .12, ay: .10, sx: .075, sy: .055, op: 0.7,  so: .070 },
          { hue: 214, sat: 92, r: .56, ox: .77, oy: .40, ax: .13, ay: .12, sx: .105, sy: .125, op: 1.15, so: .085 },
          { hue: 200, sat: 80, r: .50, ox: .50, oy: .74, ax: .14, ay: .11, sx: .130, sy: .085, op: 0.75, so: .100 },
        ];
        const N = 200, pts = [];
        for (let i = 0; i < N; i++) pts.push({ x: Math.random(), y: Math.random(), vx: (Math.random() - .5) * 0.00012, vy: (Math.random() - .5) * 0.00012 });
        const start = performance.now();
        const maxD = 0.062;
        function frame(now) {
          const t = (now - start) / 1000;
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#090a0e'; ctx.fillRect(0, 0, W, H);
          ctx.globalCompositeOperation = 'lighter';
          for (const b of blobs) {
            const cx = (b.ox + Math.sin(t * b.sx) * b.ax) * W;
            const cy = (b.oy + Math.cos(t * b.sy) * b.ay) * H;
            const rad = b.r * Math.max(W, H) * 0.5 * (1 + Math.sin(t * 0.08 + b.hue) * 0.14);
            const op = b.op * (0.86 + 0.14 * Math.sin(t * (b.so ?? .08) + b.r * 12));
            const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rad);
            g.addColorStop(0, `hsla(${b.hue}, ${b.sat}%, 66%, ${0.32 * op})`);
            g.addColorStop(0.34, `hsla(${b.hue}, ${b.sat}%, 55%, ${0.16 * op})`);
            g.addColorStop(0.7, `hsla(${b.hue}, ${b.sat}%, 45%, ${0.05 * op})`);
            g.addColorStop(1, `hsla(${b.hue}, ${b.sat}%, 45%, 0)`);
            ctx.fillStyle = g;
            ctx.beginPath(); ctx.arc(cx, cy, rad, 0, Math.PI * 2); ctx.fill();
          }
          ctx.globalCompositeOperation = 'source-over';
          for (let i = 0; i < N; i++) {
            const p = pts[i];
            if (!reduce) {
              p.x += p.vx; p.y += p.vy;
              if (p.x < 0 || p.x > 1) p.vx *= -1;
              if (p.y < 0 || p.y > 1) p.vy *= -1;
              p.x = Math.max(0, Math.min(1, p.x)); p.y = Math.max(0, Math.min(1, p.y));
            }
            for (let j = i + 1; j < N; j++) {
              const q = pts[j];
              const dx = p.x - q.x, dy = p.y - q.y, d = Math.hypot(dx, dy);
              if (d < maxD) {
                ctx.strokeStyle = `rgba(180,195,210,${0.09 * (1 - d / maxD)})`;
                ctx.lineWidth = 1;
                ctx.beginPath(); ctx.moveTo(p.x * W, p.y * H); ctx.lineTo(q.x * W, q.y * H); ctx.stroke();
              }
            }
          }
          for (const p of pts) {
            ctx.fillStyle = 'rgba(200,210,222,0.45)';
            ctx.beginPath(); ctx.arc(p.x * W, p.y * H, 1.3, 0, Math.PI * 2); ctx.fill();
          }
          if (!reduce) requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
      })();

      // ── scroll reveal + count-up ──
      (() => {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function countUp(el) {
          const to = parseFloat(el.dataset.countTo || '0');
          const dec = parseInt(el.dataset.countDec || '0', 10);
          const pre = el.dataset.countPrefix || '', suf = el.dataset.countSuffix || '';
          const dur = 1200, start = performance.now();
          function step(now) {
            const p = Math.min(1, (now - start) / dur);
            const e = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + (to * e).toFixed(dec) + suf;
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
        const els = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in'));
          document.querySelectorAll('[data-count]').forEach((el) => countUp(el));
          return;
        }
        const obs = new IntersectionObserver((entries, o) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in');
            const c = e.target.querySelector('[data-count]');
            if (c && !c.dataset.done) { c.dataset.done = '1'; countUp(c); }
            o.unobserve(e.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => obs.observe(el));
      })();

      // ── copy email ──
      document.querySelectorAll('button[data-email]').forEach((btn) => {
        const label = btn.querySelector('.ce');
        const original = label ? label.textContent : '';
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(btn.dataset.email || ''); }
          catch { const t = document.createElement('textarea'); t.value = btn.dataset.email || ''; document.body.appendChild(t); t.select(); document.execCommand('copy'); t.remove(); }
          if (label) { label.textContent = 'Copied!'; setTimeout(() => { label.textContent = original; }, 1600); }
        });
      });
    </script>
  </body>
</html>
