    <script>
      (() => {
        const fmt = (n) => Math.round(n).toLocaleString('en-US');
        const R = {}, N = {};
        document.querySelectorAll('.sl-range').forEach((r) => { R[r.dataset.key] = r; });
        document.querySelectorAll('.sl-num').forEach((n) => { N[n.id.slice(2)] = n; });
        const val = (k) => +R[k].value;

        const PRESETS = {
          cons:  { start:100000, target:500000, churn:5,   ref:0.1, cost:10, ch0:3000,  ch1:100,  ch2:200,  ch3:150,  applied:2,  vetted:15, onb:55, act:45 },
          base:  { start:100000, target:500000, churn:3,   ref:0.3, cost:5,  ch0:8000,  ch1:250,  ch2:500,  ch3:400,  applied:4,  vetted:25, onb:70, act:60 },
          aggr:  { start:100000, target:500000, churn:1.5, ref:0.6, cost:3,  ch0:20000, ch1:1000, ch2:2000, ch3:1000, applied:7,  vetted:38, onb:82, act:72 },
        };

        function applyPreset(name) {
          const p = PRESETS[name];
          Object.entries(p).forEach(([k, v]) => {
            if (R[k]) { R[k].value = v; if (N[k]) N[k].value = v; }
          });
          document.querySelectorAll('.scen-btn').forEach((b) => b.classList.toggle('active', b.id === 'scen-' + name));
          render();
        }

        document.getElementById('scen-cons').addEventListener('click', () => applyPreset('cons'));
        document.getElementById('scen-base').addEventListener('click', () => applyPreset('base'));
        document.getElementById('scen-aggr').addEventListener('click', () => applyPreset('aggr'));

        function simulate() {
          const startN   = val('start'),  target  = val('target');
          const churnRate= val('churn')/100, refPer = val('ref'), costPer = val('cost');
          const conv     = (val('applied')/100) * (val('vetted')/100) * (val('onb')/100) * (val('act')/100);
          const chanSum  = ['ch0','ch1','ch2','ch3'].reduce((s,k)=>s+val(k),0);
          let active = startN, monthsToTarget = null, m12 = 0;
          const series = [active];
          for (let m = 1; m <= 60; m++) {
            const newA = (chanSum + active * refPer) * conv;
            const churn = active * churnRate;
            active = active + newA - churn;
            series.push(active);
            if (m === 12) m12 = newA - churn;
            if (monthsToTarget === null && active >= target) monthsToTarget = m;
          }
          const spend = chanSum * costPer;
          const firstNew = (chanSum + startN * refPer) * conv;
          return { series, target, monthsToTarget, m12, cost: firstNew > 0 ? spend / firstNew : 0 };
        }

        function render() {
          const r = simulate();
          document.getElementById('o-months').textContent = r.monthsToTarget ? r.monthsToTarget + ' mo' : 'Not within 60';
          document.getElementById('o-m12').textContent = (r.m12 >= 0 ? '+' : '') + fmt(r.m12);
          document.getElementById('o-cost').textContent = r.cost > 0 ? '$' + fmt(r.cost) : 'n/a';
          drawChart(r.series, r.target);
        }

        function drawChart(series, target) {
          const W=900,H=240,pL=6,pR=6,pT=12,pB=20;
          const maxY = Math.max(target,...series)*1.08, n = series.length-1;
          const x=(i)=>pL+(i/n)*(W-pL-pR), y=(v)=>H-pB-(v/maxY)*(H-pT-pB);
          const line=series.map((v,i)=>`${i===0?'M':'L'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
          const ty=y(target).toFixed(1);
          document.getElementById('chart-g').innerHTML=
            `<line x1="${pL}" y1="${ty}" x2="${W-pR}" y2="${ty}" stroke="var(--mut)" stroke-width="1" stroke-dasharray="5 4" opacity="0.6"></line>`+
            `<text x="${W-pR}" y="${+ty-5}" text-anchor="end" font-family="JetBrains Mono,monospace" font-size="10" fill="var(--mut)">target ${fmt(target)}</text>`+
            `<path d="${line}" fill="none" stroke="var(--blue)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></path>`+
            `<line x1="${pL}" y1="${H-pB}" x2="${W-pR}" y2="${H-pB}" stroke="var(--line)" stroke-width="1"></line>`+
            `<text x="${pL}" y="${H-5}" font-family="JetBrains Mono,monospace" font-size="10" fill="var(--mut)">mo 0</text>`+
            `<text x="${W-pR}" y="${H-5}" text-anchor="end" font-family="JetBrains Mono,monospace" font-size="10" fill="var(--mut)">mo 60</text>`;
        }

        document.querySelectorAll('.sl-range').forEach((range) => {
          const num = document.getElementById('n-'+range.dataset.key);
          if (!num) return;
          range.addEventListener('input', () => { num.value = range.value; render(); });
          num.addEventListener('input', () => { if (num.value !== '' && !isNaN(+num.value)) range.value = num.value; render(); });
          num.addEventListener('change', () => { num.value = range.value; });
        });

        applyPreset('base');
      })();
    </script>
  </body>
