---
import Analytics from '@vercel/analytics/astro';
import GlobalNav from '../components/GlobalNav.astro';

const title = "A public-data plan to scale AfterQuery's expert network";
const description = 'An outside-in analysis of expert sourcing, qualification and acquisition channels, built from public information, not AfterQuery operating data. AfterQuery Growth Associate application project.';

// ── HERO copy. Swap to the future state (commented) once real sourcing work exists. ──
const hero = {
  eyebrow: 'AfterQuery application project',
  // future headline: 'I built a prototype sourcing pipeline for senior financial-modeling experts'
  headline: "A public-data plan to scale AfterQuery's expert network",
  accent: 'expert network', // phrase in the headline rendered in accent color
  // future sub: 'A real, human-reviewed sourcing workflow built to test qualification, not another market-size estimate.'
  sub: 'An outside-in analysis of expert sourcing, qualification and acquisition channels. Built from public information, not AfterQuery operating data.',
  labels: ['Expert pools mapped', 'Channels compared', 'Funnel modeled', 'Sourcing prototype underway'],
};

// ── Prototype pipeline data. Enter real numbers here later; null renders the status, never a fake count. ──
type PipelineStatus = 'not_started' | 'in_progress' | 'complete';
type PipelineStage = { label: string; value: number | null; status: PipelineStatus };
const pipeline: PipelineStage[] = [
  { label: 'Sourced', value: null, status: 'in_progress' },
  { label: 'Enriched', value: null, status: 'in_progress' },
  { label: 'Reviewed', value: null, status: 'in_progress' },
  { label: 'Qualified', value: null, status: 'in_progress' },
  { label: 'Outreach-ready', value: null, status: 'not_started' },
];
type PrototypeSummary = {
  domain: string;
  profilesSourced: number | null;
  profilesEnriched: number | null;
  profilesReviewed: number | null;
  profilesQualified: number | null;
  profilesOutreachReady: number | null;
};
const prototype: PrototypeSummary = {
  domain: 'Senior financial-modeling experts',
  profilesSourced: null,
  profilesEnriched: null,
  profilesReviewed: null,
  profilesQualified: null,
  profilesOutreachReady: null,
};
const statusText = (s: PipelineStatus) => (s === 'complete' ? 'Complete' : s === 'in_progress' ? 'Prototype underway' : 'Not started');

// ── Qualification framework ──
const qual = {
  qualified: ['Senior ownership of complex financial work', 'Clear evidence of modeling or review responsibility', 'Professional history can be verified'],
  review: ['Relevant title or domain', 'Depth cannot be established publicly', 'Requires manual verification'],
  excluded: ['Primarily sales or relationship management', 'Entry-level or insufficiently specialized', 'No evidence of substantive modeling work'],
};

// ── Appendix data ──
const occ = [
  { name: 'Software Developers', emp: '1,687,890' },
  { name: 'Accountants and Auditors', emp: '1,449,500' },
  { name: 'Management Analysts', emp: '898,280' },
  { name: 'Financial Managers', emp: '841,710' },
  { name: 'Lawyers', emp: '754,500' },
  { name: 'Securities and Financial Services Sales Agents', emp: '489,570' },
  { name: 'Financial and Investment Analysts', emp: '361,980' },
  { name: 'Web and Digital Interface Designers', emp: '113,330' },
  { name: 'Computer and Information Research Scientists', emp: '37,200' },
];
const sourcingNotes = [
  'Clear credential signals in finance and law',
  'Specialist subset difficult to identify from titles',
  'Strong association and licensing-body channels',
  'Public evidence of actual modeling work is limited',
  'Concentrated institutional pipeline for research roles',
  'High manual-review requirement across domains',
];
const benchmarks = [
  { b: 'SpreadsheetBench 2', o: 'Financial and Investment Analysts; Accountants and Auditors', s: [5] },
  { b: 'FinanceQA', o: 'Financial and Investment Analysts; Financial Managers', s: [10] },
  { b: 'Market-Bench', o: 'Securities and Financial Services Sales Agents; Financial and Investment Analysts', s: [7] },
  { b: 'IDE-Bench', o: 'Software Developers', s: [6] },
  { b: 'App-Bench', o: 'Software Developers; Web and Digital Interface Designers', s: [8] },
  { b: 'UI-Bench', o: 'Web and Digital Interface Designers', s: [9] },
  { b: 'GDPval', o: 'Lawyers; Financial Managers; Software Developers; plus top digital occupation per sector', s: [12, 13] },
];
const channels = [
  { ch: 'Automated outbound', reach: 'Occupation pools are public', unk: 'Reply and trust rates', fail: 'Volume rises, quality falls' },
  { ch: 'Campus partnerships', reach: 'NSF names output by field and institution', unk: 'Whether departments route students', fail: 'Cycles take terms, not weeks' },
  { ch: 'Conferences', reach: 'Many publish attendance numbers', unk: 'On-site conversion rates', fail: 'High spend, yield lags months' },
  { ch: 'Expert referrals', reach: 'Active network compounds referrals', unk: 'Referral rates in high-opportunity-cost fields', fail: 'Experts may decline to refer competitors' },
  { ch: 'Associations / licensing', reach: 'Bar, CPA, CFA bodies publish membership', unk: 'Whether the body permits outreach', fail: 'Access is gated by the body' },
];
const assumptions = [
  { id: 'A1', text: 'Occupation inference: benchmarks name task domains; I map them to BLS occupations with matching standard duties. My reading of public research output, not a company statement.' },
  { id: 'A2', text: 'Public labor data estimates occupation size only. It cannot establish the qualification, availability, or acquisition cost of the specific practitioners a project needs.' },
  { id: 'A3', text: 'The qualification standard on this page is my judgment. It is a hypothesis to test against real manual review, not a validated rule.' },
];
const sources = [
  { id: 1, text: 'AfterQuery: research index', url: 'https://www.afterquery.com/research', date: 'accessed Jul 2026' },
  { id: 2, text: 'AfterQuery: How AfterQuery Helped NVIDIA Hill-Climb GDPval', url: 'https://www.afterquery.com/blog/how-afterquery-helped-nvidia-hill-climb-gdpval', date: 'Jul 2, 2026' },
  { id: 3, text: 'AfterQuery: On-policy distillation on GDPval', url: 'https://www.afterquery.com/blog/on-policy-distillation-gdpval', date: 'Jun 8, 2026' },
  { id: 4, text: 'AfterQuery: Human expertise, reimagined (Series A)', url: 'https://www.afterquery.com/blog/human-expertise-reimagined', date: 'Apr 9, 2026' },
  { id: 5, text: 'SpreadsheetBench 2', url: 'https://spreadsheetbench.github.io/', date: 'accessed Jul 2026' },
  { id: 6, text: 'IDE-Bench', url: 'https://arxiv.org/abs/2601.20886', date: '2026' },
  { id: 7, text: 'Market-Bench', url: 'https://arxiv.org/abs/2512.12264', date: '2025' },
  { id: 8, text: 'App-Bench', url: 'https://appbench.ai/', date: 'accessed Jul 2026' },
  { id: 9, text: 'UI-Bench', url: 'https://arxiv.org/abs/2508.20410', date: '2025' },
  { id: 10, text: 'FinanceQA', url: 'https://arxiv.org/abs/2501.18062', date: '2025' },
  { id: 11, text: 'AfterQuery: Growth Associate job posting', url: 'https://jobs.ashbyhq.com/AfterQuery/cddded26-a2ce-4840-a8d8-17b1ac0e3831', date: 'accessed Jul 2026' },
  { id: 12, text: 'OpenAI: GDPval announcement', url: 'https://openai.com/index/gdpval/', date: 'Sep 2025' },
  { id: 13, text: 'GDPval paper', url: 'https://arxiv.org/abs/2510.04374', date: '2025' },
  { id: 14, text: 'Epoch AI: GDPval summary', url: 'https://epoch.ai/benchmarks/gdpval', date: 'accessed Jul 2026' },
  { id: 15, text: 'BLS OEWS home', url: 'https://www.bls.gov/oes/', date: 'May 2025' },
  { id: 16, text: 'BLS OEWS: national occupation table (employment)', url: 'https://www.bls.gov/news.release/ocwage.t01.htm', date: 'May 2025' },
  { id: 17, text: 'NSF NCSES: Survey of Earned Doctorates', url: 'https://ncses.nsf.gov/pubs/nsf26315/report/field-of-doctorate', date: '2024 data' },
  { id: 18, text: 'SiliconANGLE: AfterQuery $30M Series A', url: 'https://siliconangle.com/2026/04/10/ai-training-data-startup-afterquery-nabs-30m-investment/', date: 'Apr 10, 2026' },
  { id: 19, text: 'NSF NCSES: 2024 SED data tables, Table 7-3', url: 'https://ncses.nsf.gov/pubs/nsf25349/assets/nsf25349.pdf', date: 'Aug 2025' },
];

const headParts = hero.headline.split(hero.accent);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://kylefindlay.xyz/supply" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-supply.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-supply.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root {
        --ink: #17223f; --navy: #0f1834; --mut: #58637f; --line: rgba(24,40,88,0.12);
        --blue: #4c7ef5; --card: #ffffff; --paper: #eef2fa;
        --hero-ink: #eef4fd; --hero-mut: rgba(238,244,253,0.66); --hero-line: rgba(255,255,255,0.10);
        --ok: #3f9a63; --warn: #c2892b; --no: #a05248;
        --radius: 16px;
      }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body { margin: 0; color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        background: linear-gradient(180deg, #eef4fd 0%, #e9eefb 55%, #ecebf9 100%); overflow-x: hidden; }
      h1, h2, h3, h4 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; color: var(--navy); }
      a { color: var(--blue); }
      .wrap { max-width: 1140px; margin: 0 auto; padding: 0 24px; width: 100%; }
      main { padding: 28px 0 96px; }

      /* section rhythm */
      .sec { margin-top: 4rem; scroll-margin-top: 72px; }
      @media (max-width: 700px) { .sec { margin-top: 2.75rem; } }
      .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--blue); margin: 0 0 12px; }
      .sec h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); line-height: 1.12; max-width: 760px; }
      .sec-lead { font-size: 16px; line-height: 1.55; color: var(--mut); margin: 12px 0 0; max-width: 640px; }
      @media (min-width: 768px) { .sec-lead { font-size: 17px; } }

      /* ── HERO ── */
      .hero { background: linear-gradient(155deg, #141d40 0%, #0d1330 60%, #0b1129 100%);
        border: 1px solid var(--hero-line); border-radius: 22px; color: var(--hero-ink);
        padding: clamp(30px, 5vw, 62px); margin-top: 22px; }
      .hero-eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--blue); margin: 0 0 20px; }
      .hero h1 { color: var(--hero-ink); font-weight: 700; letter-spacing: -0.03em; line-height: 1.04;
        font-size: clamp(38px, 6vw, 68px); max-width: 850px; }
      .hero h1 .ac { color: var(--blue); }
      .hero-sub { color: var(--hero-mut); font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.5; margin: 22px 0 0; max-width: 620px; }
      .hero-labels { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; }
      .hero-label { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--hero-ink);
        border: 1px solid var(--hero-line); background: rgba(255,255,255,0.04); border-radius: 999px; padding: 6px 13px; }
      .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0 0; }

      .btn { display: inline-flex; align-items: center; justify-content: center; font-family: 'JetBrains Mono', monospace;
        font-size: 12.5px; font-weight: 600; letter-spacing: .03em; padding: 12px 22px; border-radius: 10px;
        text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: opacity .15s, background .15s, border-color .15s; }
      .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
      .btn-primary:hover { opacity: .9; }
      .btn-ghost { background: transparent; color: var(--hero-ink); border-color: var(--hero-line); }
      .btn-ghost:hover { border-color: rgba(255,255,255,0.35); }
      .btn-outline { background: transparent; color: var(--navy); border-color: var(--line); }
      .btn-outline:hover { border-color: var(--blue); color: var(--blue); }

      /* ── cards ── */
      .grid3 { display: grid; grid-template-columns: 1fr; gap: 14px; margin: 22px 0 0; }
      @media (min-width: 720px) { .grid3 { grid-template-columns: repeat(3, 1fr); } }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; }
      .card-mark { width: 26px; height: 26px; border-radius: 7px; background: rgba(76,126,245,0.12); border: 1px solid rgba(76,126,245,0.3);
        display: flex; align-items: center; justify-content: center; margin-bottom: 12px; }
      .card-mark span { width: 9px; height: 9px; border-radius: 2px; background: var(--blue); }
      .card h3 { font-size: 1rem; font-weight: 700; margin: 0 0 6px; }
      .card p { font-size: 14.5px; line-height: 1.5; color: var(--ink); margin: 0; }
      .pill { display: inline-flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-size: 10px;
        font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; margin-top: 12px; }
      .pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
      .pill-prog { color: var(--warn); background: rgba(194,137,43,0.1); } .pill-prog::before { background: var(--warn); }

      /* ── qualification cards ── */
      .qcards { display: grid; grid-template-columns: 1fr; gap: 14px; margin: 22px 0 0; }
      @media (min-width: 720px) { .qcards { grid-template-columns: repeat(3, 1fr); } }
      .qcard { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; border-top: 3px solid var(--line); }
      .qcard.ok { border-top-color: var(--ok); }
      .qcard.warn { border-top-color: var(--warn); }
      .qcard.no { border-top-color: var(--no); }
      .qcard-h { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 12px; }
      .qcard.ok .qcard-h { color: var(--ok); } .qcard.warn .qcard-h { color: var(--warn); } .qcard.no .qcard-h { color: var(--no); }
      .qcard ul { margin: 0; padding: 0; list-style: none; }
      .qcard li { font-size: 14px; line-height: 1.4; color: var(--ink); padding: 7px 0 7px 16px; position: relative; border-bottom: 1px solid var(--line); }
      .qcard li:last-child { border-bottom: 0; }
      .qcard li::before { content: ''; position: absolute; left: 0; top: 14px; width: 5px; height: 5px; border-radius: 50%; background: var(--mut); }

      /* ── prototype funnel ── */
      .funnel { display: flex; align-items: stretch; gap: 8px; margin: 22px 0 0; }
      .fstage { flex: 1 1 0; min-width: 0; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 16px 14px; }
      .fstage.pending { background: rgba(24,40,88,0.02); border-style: dashed; }
      .fstage-n { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--mut); }
      .fstage-l { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 14.5px; color: var(--navy); margin: 4px 0 10px; }
      .fstatus { display: inline-flex; align-items: center; gap: 6px; font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mut); }
      .fstatus::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--mut); flex: 0 0 auto; }
      .fstatus.prog { color: var(--warn); } .fstatus.prog::before { background: var(--warn); }
      .fstatus.none { color: var(--mut); } .fstatus.none::before { background: rgba(88,99,127,0.4); }
      .fstatus.done { color: var(--ok); } .fstatus.done::before { background: var(--ok); }
      .fval { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.4rem; color: var(--blue); line-height: 1; }
      @media (max-width: 760px) { .funnel { flex-direction: column; } }
      .note-inline { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--mut); margin: 14px 0 0; }

      /* ── steps ── */
      .steps { display: flex; flex-direction: column; max-width: 720px; margin: 22px 0 0; }
      .step { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
      .step:last-child { border-bottom: 0; }
      .step-n { font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; color: var(--blue); flex: 0 0 20px; }
      .step p { font-size: 15.5px; line-height: 1.45; color: var(--ink); margin: 0; }

      /* ── appendix ── */
      .appendix { margin-top: 4rem; scroll-margin-top: 72px; }
      .appendix > summary { list-style: none; cursor: pointer; display: flex; flex-direction: column; gap: 6px;
        padding: 20px 22px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); user-select: none; }
      .appendix > summary::-webkit-details-marker { display: none; }
      .appendix > summary:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
      .app-sum-t { display: flex; align-items: center; gap: 10px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.15rem; color: var(--navy); }
      .app-sum-t::before { content: '+'; font-family: 'JetBrains Mono', monospace; font-size: 18px; color: var(--blue); line-height: 1; width: 16px; }
      .appendix[open] > summary .app-sum-t::before { content: '\2212'; }
      .app-sum-d { font-size: 13.5px; color: var(--mut); }
      .app-inner { padding: 8px 2px 0; display: flex; flex-direction: column; gap: 2.5rem; margin-top: 1.5rem; }
      .app-sec h3 { font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--navy); margin: 0 0 12px; }
      .app-sec p { font-size: 14.5px; line-height: 1.55; color: var(--ink); margin: 0 0 8px; max-width: 680px; }
      .app-sec p.mut { color: var(--mut); }
      .tags { display: flex; flex-wrap: wrap; gap: 8px; }
      .tag { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--navy); background: rgba(76,126,245,0.07);
        border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; }

      /* tables */
      .tbl { overflow-x: auto; -webkit-overflow-scrolling: touch; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 460px; }
      thead th { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
        color: var(--navy); padding: 0 12px 8px 0; border-bottom: 1.5px solid var(--line); text-align: left; }
      tbody td { padding: 9px 12px 9px 0; border-bottom: 1px solid var(--line); color: var(--ink); vertical-align: top; }
      tbody tr:last-child td { border-bottom: 0; }
      td.num { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; text-align: right; padding-right: 16px; }
      .occ { font-weight: 600; color: var(--navy); }
      .srccell { font-family: 'JetBrains Mono', monospace; font-size: 12px; }

      /* refs */
      .refs-grid { display: grid; grid-template-columns: 1fr; gap: 22px; }
      @media (min-width: 700px) { .refs-grid { grid-template-columns: 1fr 1fr; } }
      ol.reflist { margin: 0; padding: 0; list-style: none; }
      ol.reflist li { font-size: 12.5px; line-height: 1.5; color: var(--ink); padding: 7px 0; border-bottom: 1px solid var(--line); display: flex; gap: 8px; }
      ol.reflist li:last-child { border-bottom: 0; }
      .rn { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; color: var(--blue); flex: 0 0 auto; min-width: 24px; }
      .refs a { color: var(--blue); text-decoration: none; word-break: break-word; }
      .refs a:hover { text-decoration: underline; }
      .refd { color: var(--mut); font-size: 11px; }

      /* ── application footer ── */
      .footer { margin-top: 4rem; background: linear-gradient(155deg, #141d40 0%, #0d1330 70%); border: 1px solid var(--hero-line);
        border-radius: 22px; color: var(--hero-ink); padding: clamp(28px, 4vw, 44px); }
      .footer h2 { color: var(--hero-ink); font-size: clamp(1.3rem, 2.4vw, 1.7rem); max-width: 640px; }
      .footer p { color: var(--hero-mut); font-size: 16px; line-height: 1.55; margin: 14px 0 0; max-width: 560px; }
      .footer-btns { display: flex; flex-wrap: wrap; gap: 12px; margin: 26px 0 0; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 24px 0 0; padding-top: 20px; border-top: 1px solid var(--hero-line); }
      .footer-links a { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--hero-mut); text-decoration: none; }
      .footer-links a:hover { color: var(--hero-ink); }
      @media (max-width: 560px) { .btn { width: 100%; } .hero-btns .btn, .footer-btns .btn { flex: 1 1 100%; } }

      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
    <Analytics />
  </head>
  <body>
    <GlobalNav />

    <main class="wrap">

      <!-- 1. HERO -->
      <header class="hero">
        <p class="hero-eyebrow">{hero.eyebrow}</p>
        <h1>{headParts[0]}<span class="ac">{hero.accent}</span>{headParts[1]}</h1>
        <p class="hero-sub">{hero.sub}</p>
        <div class="hero-labels">
          {hero.labels.map((l) => <span class="hero-label">{l}</span>)}
        </div>
        <div class="hero-btns">
          <a class="btn btn-primary" href="#what-i-built">View the approach</a>
          <button class="btn btn-ghost" id="open-appendix" type="button">Research appendix</button>
        </div>
      </header>

      <!-- 2. WHAT I BUILT -->
      <section class="sec" id="what-i-built">
        <p class="eyebrow">01 · What I built</p>
        <div class="grid3">
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Expert-pool research</h3>
            <p>Mapped plausible professional groups using public labor, benchmark and institutional data.</p>
          </div>
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Acquisition-channel comparison</h3>
            <p>Compared outbound, referrals, universities, associations and conferences without inventing conversion rates.</p>
          </div>
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Sourcing prototype</h3>
            <p>Building one real Clay workflow to source and manually assess senior financial-modeling professionals.</p>
            <span class="pill pill-prog">In progress</span>
          </div>
        </div>
      </section>

      <!-- 3. QUALIFICATION FRAMEWORK -->
      <section class="sec">
        <p class="eyebrow">02 · Qualification framework</p>
        <h2>Qualification matters more than list size</h2>
        <p class="sec-lead">A large professional population is not the same as a qualified, reachable expert pool.</p>
        <div class="qcards">
          <div class="qcard ok">
            <p class="qcard-h">Qualified</p>
            <ul>{qual.qualified.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="qcard warn">
            <p class="qcard-h">Needs review</p>
            <ul>{qual.review.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="qcard no">
            <p class="qcard-h">Excluded</p>
            <ul>{qual.excluded.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>

      <!-- 4. PROTOTYPE PIPELINE -->
      <section class="sec">
        <p class="eyebrow">03 · Prototype pipeline</p>
        <h2>A real workflow, {prototype.domain.toLowerCase()}</h2>
        <p class="sec-lead">One domain, built and reviewed by hand in Clay. Counts appear here once the review is done.</p>
        <div class="funnel">
          {pipeline.map((st, i) => (
            <div class={`fstage ${st.status === 'not_started' ? 'pending' : ''}`}>
              <div class="fstage-n">Stage {i + 1}</div>
              <div class="fstage-l">{st.label}</div>
              {st.value !== null
                ? <div class="fval">{st.value.toLocaleString('en-US')}</div>
                : <div class={`fstatus ${st.status === 'in_progress' ? 'prog' : st.status === 'complete' ? 'done' : 'none'}`}>{statusText(st.status)}</div>}
            </div>
          ))}
        </div>
        <p class="note-inline">Anonymized examples will be added after manual review.</p>
      </section>

      <!-- 5. WHAT REQUIRED HUMAN JUDGMENT -->
      <section class="sec">
        <p class="eyebrow">04 · What required human judgment</p>
        <div class="grid3">
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Title versus actual work</h3>
            <p>Similar titles can represent substantially different levels of technical responsibility.</p>
          </div>
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Credentials versus evidence</h3>
            <p>Education and employer prestige do not establish that someone performed the relevant work.</p>
          </div>
          <div class="card">
            <div class="card-mark"><span></span></div>
            <h3>Public-profile limitations</h3>
            <p>Many potentially strong experts cannot be confidently qualified from public information alone.</p>
          </div>
        </div>
      </section>

      <!-- 6. WHAT I WOULD TEST NEXT -->
      <section class="sec">
        <p class="eyebrow">05 · What I would test next</p>
        <div class="steps">
          <div class="step"><span class="step-n">1</span><p>Whether shortlisted professionals respond.</p></div>
          <div class="step"><span class="step-n">2</span><p>Which value proposition earns trust.</p></div>
          <div class="step"><span class="step-n">3</span><p>What evidence predicts successful qualification.</p></div>
        </div>
      </section>

      <!-- 7. RESEARCH APPENDIX -->
      <details class="appendix" id="appendix">
        <summary>
          <span class="app-sum-t">Research appendix</span>
          <span class="app-sum-d">Supporting research behind the initial expert-pool and channel hypotheses.</span>
        </summary>
        <div class="app-inner">

          <div class="app-sec">
            <h3>Working hypothesis</h3>
            <p>Finance and law experts are not scarce. They are expensive to divert, which is why volume outbound underperforms referral in those domains.</p>
          </div>

          <div class="app-sec">
            <h3>What public labor data can and cannot do</h3>
            <p class="mut">Public labor data can estimate the broad size of an occupation. It cannot estimate the compensation, availability or acquisition cost of the highly qualified practitioners required for a specific project.</p>
          </div>

          <div class="app-sec">
            <h3>Occupation mapping [15, 16]</h3>
            <p class="mut" style="margin-bottom:10px;">Occupation size only. Size is not the same as the qualified, reachable subset (A2).</p>
            <div class="tbl">
              <table>
                <thead><tr><th>Occupation (BLS)</th><th class="num">U.S. employment, May 2025</th></tr></thead>
                <tbody>
                  {occ.map((r) => (<tr><td class="occ">{r.name}</td><td class="num">{r.emp}</td></tr>))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="app-sec">
            <h3>Initial sourcing considerations</h3>
            <p class="mut" style="margin-bottom:10px;">Qualitative observations, not a score.</p>
            <div class="tags">{sourcingNotes.map((n) => <span class="tag">{n}</span>)}</div>
          </div>

          <div class="app-sec">
            <h3>Benchmark-to-occupation mapping [A1]</h3>
            <div class="tbl">
              <table>
                <thead><tr><th>Benchmark</th><th>Occupations implied</th><th>Source</th></tr></thead>
                <tbody>
                  {benchmarks.map((r) => (
                    <tr>
                      <td class="occ">{r.b}</td>
                      <td>{r.o}</td>
                      <td class="srccell">{r.s.map((n) => <a href={`#s${n}`}>[{n}]</a>)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="app-sec">
            <h3>Channel comparison</h3>
            <div class="tbl">
              <table>
                <thead><tr><th>Channel</th><th>Verifiable reach</th><th>Not knowable outside</th><th>Failure mode</th></tr></thead>
                <tbody>
                  {channels.map((r) => (
                    <tr><td class="occ">{r.ch}</td><td>{r.reach}</td><td>{r.unk}</td><td>{r.fail}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="app-sec">
            <h3>Shortened 90-day thought process</h3>
            <div class="steps" style="margin-top:0;">
              <div class="step"><span class="step-n">1</span><p>Instrument the existing funnel by occupation and channel to find the largest drop-off.</p></div>
              <div class="step"><span class="step-n">2</span><p>Run one controlled sourcing test in a single domain and review results by hand.</p></div>
              <div class="step"><span class="step-n">3</span><p>Compare two acquisition channels and keep the one that produces qualified experts.</p></div>
            </div>
          </div>

          <div class="app-sec refs">
            <div class="refs-grid">
              <div>
                <h3>Sources</h3>
                <ol class="reflist">
                  {sources.map((s) => (
                    <li id={`s${s.id}`}><span class="rn">[{s.id}]</span><span>{s.text}. <a href={s.url} target="_blank" rel="noopener">{s.url}</a> <span class="refd">({s.date})</span></span></li>
                  ))}
                </ol>
              </div>
              <div>
                <h3>Assumptions</h3>
                <ol class="reflist">
                  {assumptions.map((a) => (
                    <li id={a.id.toLowerCase()}><span class="rn">{a.id}</span><span>{a.text}</span></li>
                  ))}
                </ol>
              </div>
            </div>
          </div>

        </div>
      </details>

      <!-- 8. APPLICATION FOOTER -->
      <section class="footer">
        <h2>Built as part of my Growth Associate application</h2>
        <p>I built this to show how I approach an unfamiliar growth problem: define the qualification standard, build the workflow and test the assumptions.</p>
        <div class="footer-btns">
          <a class="btn btn-primary" href="/">View résumé</a>
          <a class="btn btn-ghost" href="mailto:kylefindlay828@gmail.com?subject=AfterQuery%20%2F%20Kyle%20Findlay">Contact Kyle</a>
        </div>
        <div class="footer-links">
          <a href="/proofworks">Proofworks</a>
          <a href="/radar-v2">GTM Radar</a>
          <a href="/">About Kyle</a>
        </div>
      </section>

    </main>

    <script>
      document.getElementById('open-appendix')?.addEventListener('click', () => {
        const d = document.getElementById('appendix');
        if (d instanceof HTMLDetailsElement) {
          d.open = true;
          d.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    </script>
  </body>
</html>
