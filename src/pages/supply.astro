---
import Analytics from '@vercel/analytics/astro';
import GlobalNav from '../components/GlobalNav.astro';

const title = 'A public-data plan to scale AfterQuery\'s expert network';
const description = 'Outside-in analysis using public information. Expert supply mapping, channel comparison, and scenario model for AfterQuery\'s network growth problem.';

const sources = [
  { id: 1, text: 'AfterQuery: research index', url: 'https://www.afterquery.com/research', date: 'accessed Jul 2026' },
  { id: 2, text: 'AfterQuery: How AfterQuery Helped NVIDIA Hill-Climb GDPval', url: 'https://www.afterquery.com/blog/how-afterquery-helped-nvidia-hill-climb-gdpval', date: 'Jul 2, 2026' },
  { id: 3, text: 'AfterQuery: On-policy distillation on GDPval (+21.4% net win-loss)', url: 'https://www.afterquery.com/blog/on-policy-distillation-gdpval', date: 'Jun 8, 2026' },
  { id: 4, text: 'AfterQuery: Human expertise, reimagined (Series A)', url: 'https://www.afterquery.com/blog/human-expertise-reimagined', date: 'Apr 9, 2026' },
  { id: 5, text: 'SpreadsheetBench 2', url: 'https://spreadsheetbench.github.io/', date: 'accessed Jul 2026' },
  { id: 6, text: 'IDE-Bench', url: 'https://arxiv.org/abs/2601.20886', date: '2026' },
  { id: 7, text: 'Market-Bench', url: 'https://arxiv.org/abs/2512.12264', date: '2025' },
  { id: 8, text: 'App-Bench', url: 'https://appbench.ai/', date: 'accessed Jul 2026' },
  { id: 9, text: 'UI-Bench', url: 'https://arxiv.org/abs/2508.20410', date: '2025' },
  { id: 10, text: 'FinanceQA', url: 'https://arxiv.org/abs/2501.18062', date: '2025' },
  { id: 11, text: 'AfterQuery: Growth Associate job posting', url: 'https://jobs.ashbyhq.com/AfterQuery/cddded26-a2ce-4840-a8d8-17b1ac0e3831', date: 'accessed Jul 2026' },
  { id: 12, text: 'OpenAI: GDPval announcement', url: 'https://openai.com/index/gdpval/', date: 'Sep 2025' },
  { id: 13, text: 'GDPval paper', url: 'https://arxiv.org/abs/2510.04374', date: '2025' },
  { id: 14, text: 'Epoch AI: GDPval summary', url: 'https://epoch.ai/benchmarks/gdpval', date: 'accessed Jul 2026' },
  { id: 15, text: 'BLS OEWS home', url: 'https://www.bls.gov/oes/', date: 'May 2025' },
  { id: 16, text: 'BLS OEWS: national occupation table', url: 'https://www.bls.gov/news.release/ocwage.t01.htm', date: 'May 2025' },
  { id: 17, text: 'NSF NCSES: Survey of Earned Doctorates', url: 'https://ncses.nsf.gov/pubs/nsf26315/report/field-of-doctorate', date: '2024 data' },
  { id: 18, text: 'SiliconANGLE: AfterQuery $30M Series A', url: 'https://siliconangle.com/2026/04/10/ai-training-data-startup-afterquery-nabs-30m-investment/', date: 'Apr 10, 2026' },
  { id: 19, text: 'NSF NCSES: 2024 SED data tables, Table 7-3', url: 'https://ncses.nsf.gov/pubs/nsf25349/assets/nsf25349.pdf', date: 'Aug 2025' },
];

const assumptions = [
  { id: 'A1', text: 'Occupation inference: benchmarks name task domains; I map them to BLS occupations with matching standard duties. My reading of public research output, not a company statement.' },
  { id: 'A2', text: 'Reach-difficulty: High if pool < 250k or day-job wage > $80/hr; Low if pool > 500k and wage < $60/hr; Medium otherwise. Day-job wage is an opportunity-cost floor, not the expert-data rate.' },
  { id: 'A3', text: '"400,000" is illustrative: gap between the public ~100k figure and the 500k model default. Not a claim about company plans.' },
  { id: 'A4', text: 'Cost per contact is reader-supplied. Acquisition cost by channel is not public.' },
  { id: 'A5', text: "Scenario defaults are my stated priors, not industry benchmarks or AfterQuery's operating rates." },
];

const supplyData = [
  { occ: 'Computer and Information Research Scientists', emp: '37,200', wage: '$74.00', diff: 'High' },
  { occ: 'Web and Digital Interface Designers', emp: '113,330', wage: '$56.49', diff: 'High' },
  { occ: 'Lawyers', emp: '754,500', wage: '$89.35', diff: 'High' },
  { occ: 'Financial Managers', emp: '841,710', wage: '$89.86', diff: 'High' },
  { occ: 'Financial and Investment Analysts', emp: '361,980', wage: '$56.15', diff: 'Medium' },
  { occ: 'Securities and Financial Services Sales Agents', emp: '489,570', wage: '$52.48', diff: 'Medium' },
  { occ: 'Software Developers', emp: '1,687,890', wage: '$71.20', diff: 'Medium' },
  { occ: 'Management Analysts', emp: '898,280', wage: '$54.71', diff: 'Low' },
  { occ: 'Accountants and Auditors', emp: '1,449,500', wage: '$45.56', diff: 'Low' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://kylefindlay.xyz/supply" />
    <meta property="og:image" content="https://kylefindlay.xyz/og-supply.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kylefindlay.xyz/og-supply.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      * { box-sizing: border-box; }
      :root { --ink: #17223f; --navy: #0f1834; --mut: #58637f; --line: rgba(24,40,88,0.12); --blue: #4c7ef5; --card: rgba(255,255,255,0.6); }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body { margin: 0; color: var(--ink); font-family: 'Hanken Grotesk', system-ui, sans-serif; -webkit-font-smoothing: antialiased;
        background: linear-gradient(180deg,#eef4fd 0%,#e9eefb 60%,#ecebf9 100%); overflow-x: hidden; }
      h1,h2,h3 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.02em; margin: 0; color: var(--navy); }
      a { color: var(--blue); }
      .col { max-width: 1000px; margin: 0 auto; padding: 0 24px; width: 100%; }
      .page { padding-bottom: 80px; }

      /* ── hero ── */
      .hero { padding: 44px 0 8px; }
      .hero-tag { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--blue); margin: 0 0 14px; }
      .hero h1 { font-size: clamp(1.7rem, 3.5vw, 2.6rem); line-height: 1.08; font-weight: 700; max-width: 720px; }
      .hero-sub { font-size: 1.05rem; line-height: 1.5; color: var(--mut); font-weight: 500; margin: 12px 0 0; max-width: 560px; }
      .hero-disclaimer { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--mut); margin: 10px 0 0; padding-top: 12px; border-top: 1px solid var(--line); }
      .facts { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 20px 0 0; }
      .fact { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink); }
      .fact b { font-weight: 700; color: var(--navy); }

      /* ── sections ── */
      .sec { margin-top: 2.75rem; padding-top: 2rem; border-top: 1px solid var(--line); }
      .sec h2 { font-size: 1.1rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--navy); font-family: 'JetBrains Mono', monospace; margin: 0 0 1rem; }
      .body { font-size: 16px; line-height: 1.6; color: var(--ink); margin: 0 0 0.75rem; max-width: 680px; }
      @media (min-width: 768px) { .body { font-size: 17px; } }
      .body:last-child { margin-bottom: 0; }
      .mut { color: var(--mut); font-style: italic; }

      /* ── cards grid ── */
      .cards { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 0; }
      @media (min-width: 620px) { .cards { grid-template-columns: repeat(3,1fr); } }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
      .card-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 0.95rem; color: var(--navy); margin: 0 0 6px; }
      .card-body { font-size: 14px; line-height: 1.5; color: var(--ink); margin: 0; }
      .card-out { font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--mut); margin: 8px 0 0; }

      /* ── steps ── */
      .steps { display: flex; flex-direction: column; gap: 0; max-width: 680px; }
      .step { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
      .step:last-child { border-bottom: 0; }
      .step-n { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; color: var(--blue); flex: 0 0 22px; padding-top: 2px; }
      .step-txt { font-size: 15.5px; line-height: 1.5; color: var(--ink); }
      .step-txt b { font-weight: 700; color: var(--navy); }

      /* ── unknowns grid ── */
      .unknowns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; max-width: 680px; margin: 0; }
      @media (max-width: 520px) { .unknowns { grid-template-columns: 1fr; } }
      .unk { font-size: 14.5px; line-height: 1.45; color: var(--ink); padding: 8px 0; border-bottom: 1px solid var(--line); }
      .unk b { font-weight: 700; color: var(--navy); display: block; font-size: 13px; margin-bottom: 2px; }

      /* ── takeaway ── */
      .findings { display: flex; flex-direction: column; gap: 0; max-width: 680px; }
      .finding { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15.5px; line-height: 1.5; color: var(--ink); }
      .finding:last-child { border-bottom: 0; }
      .finding b { color: var(--navy); font-weight: 700; }

      /* ── appendix ── */
      .appendix { margin-top: 2.75rem; padding-top: 2rem; border-top: 1px solid var(--line); }
      .appendix > summary { list-style: none; cursor: pointer; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; font-weight: 700;
        letter-spacing: .1em; text-transform: uppercase; color: var(--mut); display: inline-flex; align-items: center; gap: 8px; user-select: none; }
      .appendix > summary::before { content: '+'; font-size: 16px; line-height: 1; color: var(--blue); }
      .appendix[open] > summary::before { content: '-'; }
      .app-inner { margin-top: 2rem; display: flex; flex-direction: column; gap: 2rem; }
      .app-sec h3 { font-size: 0.85rem; font-weight: 700; font-family: 'JetBrains Mono', monospace; letter-spacing: .1em;
        text-transform: uppercase; color: var(--navy); margin: 0 0 10px; }

      /* ── tables ── */
      .tbl { max-width: 900px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
      table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 500px; }
      thead th { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; letter-spacing: .06em;
        text-transform: uppercase; color: var(--navy); padding: 0 12px 8px 0; border-bottom: 1.5px solid var(--line); text-align: left; }
      tbody td { padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); color: var(--ink); vertical-align: top; }
      tbody tr:last-child td { border-bottom: 0; }
      td.num { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; text-align: right; padding-right: 16px; }
      .occ { font-weight: 600; color: var(--navy); }
      .diff-h { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; color: #b4443a; }
      .diff-m { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; color: #b5731f; }
      .diff-l { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; color: #3f7a4e; }

      /* ── refs ── */
      .refs-grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
      @media (min-width: 640px) { .refs-grid { grid-template-columns: 1fr 1fr; } }
      ol.reflist { margin: 0; padding: 0; list-style: none; }
      ol.reflist li { font-size: 12.5px; line-height: 1.5; color: var(--ink); padding: 7px 0; border-bottom: 1px solid var(--line); display: flex; gap: 8px; }
      ol.reflist li:last-child { border-bottom: 0; }
      .rn { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 700; color: var(--blue); flex: 0 0 auto; min-width: 24px; }
      .refs a { color: var(--blue); text-decoration: none; word-break: break-word; }
      .refs a:hover { text-decoration: underline; }
      .refd { color: var(--mut); font-size: 11px; }

      /* ── footer ── */
      .app-footer { margin-top: 2.75rem; padding-top: 2rem; border-top: 1px solid var(--line);
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
      .app-footer p { font-size: 15.5px; color: var(--ink); margin: 0; max-width: 480px; }
      .footer-btns { display: flex; gap: 10px; flex-wrap: wrap; }
      .btn { display: inline-flex; align-items: center; font-family: 'JetBrains Mono', monospace; font-size: 12.5px;
        font-weight: 700; letter-spacing: .04em; padding: 10px 20px; border-radius: 8px; text-decoration: none; transition: opacity .15s; }
      .btn:hover { opacity: 0.85; }
      .btn-primary { background: var(--blue); color: #fff; border: 1px solid var(--blue); }
      .btn-secondary { background: transparent; color: var(--navy); border: 1px solid var(--line); }

      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
    </style>
    <Analytics />
  </head>
  <body>
    <GlobalNav />

    <main class="page col">

      <!-- 1. HERO -->
      <header class="hero">
        <p class="hero-tag">AfterQuery</p>
        <h1>A public-data plan to scale AfterQuery's expert network</h1>
        <p class="hero-sub">Outside-in analysis using public information. Not AfterQuery operating data. Built to show how I think, not to claim inside knowledge.</p>
        <div class="facts">
          <span class="fact"><b>~100K</b> experts today [<a href="#s11">11</a>]</span>
          <span class="fact"><b>$100M+</b> ARR [<a href="#s4">4</a>]</span>
          <span class="fact"><b>$30M</b> Series A [<a href="#s4">4</a>,<a href="#s18">18</a>]</span>
          <span class="fact"><b>9</b> occupations mapped</span>
        </div>
      </header>

      <!-- 2. WORKING HYPOTHESIS -->
      <section class="sec">
        <h2>Working hypothesis</h2>
        <p class="body"><strong>Expert supply in finance and law is thin enough that referral quality matters more than outreach volume.</strong></p>
        <p class="body mut">Public data cannot establish current domain demand mix, contributor economics, or actual conversion rates.</p>
      </section>

      <!-- 3. WHAT I BUILT -->
      <section class="sec">
        <h2>What I built</h2>
        <div class="cards">
          <div class="card">
            <p class="card-title">Expert-pool map</p>
            <p class="card-body">BLS employment and day-job wage for 9 occupations implied by AfterQuery's published benchmarks.</p>
            <p class="card-out">Source: BLS OEWS May 2025 [15,16]. See appendix.</p>
          </div>
          <div class="card">
            <p class="card-title">Channel comparison</p>
            <p class="card-body">What public data supports vs. what it cannot establish for 5 acquisition channels.</p>
            <p class="card-out">Reach is verifiable. Conversion is not.</p>
          </div>
          <div class="card">
            <p class="card-title">Scenario model</p>
            <p class="card-body">Month-by-month network projection with adjustable funnel rates and referral compounding.</p>
            <p class="card-out">Inputs are my stated priors. Replace with yours.</p>
          </div>
        </div>
      </section>

      <!-- 4. HOW I WOULD APPROACH IT -->
      <section class="sec">
        <h2>How I would approach it</h2>
        <div class="steps">
          <div class="step"><span class="step-n">1</span><span class="step-txt"><b>Measure the existing funnel.</b> Tag contacts by occupation and channel. Find the largest drop-off.</span></div>
          <div class="step"><span class="step-n">2</span><span class="step-txt"><b>Pick one expert domain.</b> Highest-value, lowest-supply occupation. One channel, 60 days. Measure cost per activated expert.</span></div>
          <div class="step"><span class="step-n">3</span><span class="step-txt"><b>Test two acquisition channels head-to-head.</b> Automated outbound vs. campus for that domain. Kill the weaker one.</span></div>
        </div>
      </section>

      <!-- 5. WHAT PUBLIC DATA CANNOT ANSWER -->
      <section class="sec">
        <h2>What public data cannot answer</h2>
        <div class="unknowns">
          <div class="unk"><b>Domain demand</b>Which occupations AfterQuery is actively hiring in.</div>
          <div class="unk"><b>Qualification standards</b>What vetting looks like per domain or task type.</div>
          <div class="unk"><b>Funnel conversion</b>Reply, application, and vetting rates by channel.</div>
          <div class="unk"><b>Activation and retention</b>Time to first task; churn by domain.</div>
          <div class="unk"><b>Contributor economics</b>Pay per task; referral incentive structure.</div>
          <div class="unk"><b>Internal constraints</b>Team capacity, tooling, and current bottlenecks.</div>
        </div>
      </section>

      <!-- 6. FIRST 90 DAYS -->
      <section class="sec">
        <h2>First 90 days</h2>
        <div class="cards">
          <div class="card">
            <p class="card-title">Month 1: Learn</p>
            <p class="card-body">Instrument the funnel by occupation and channel.</p>
            <ul style="margin:8px 0 0;padding:0 0 0 16px;font-size:14px;line-height:1.6;color:var(--ink);">
              <li>Map existing expert distribution</li>
              <li>Tag every contact source</li>
              <li>Find the largest drop-off</li>
            </ul>
          </div>
          <div class="card">
            <p class="card-title">Month 2: Test</p>
            <p class="card-body">Run one controlled experiment, one occupation, two channels.</p>
            <ul style="margin:8px 0 0;padding:0 0 0 16px;font-size:14px;line-height:1.6;color:var(--ink);">
              <li>Automated outbound vs. campus</li>
              <li>Track cost per activated expert</li>
              <li>Kill the weaker channel</li>
            </ul>
          </div>
          <div class="card">
            <p class="card-title">Month 3: Improve</p>
            <p class="card-body">Build the referral loop. This is the compounding mechanism.</p>
            <ul style="margin:8px 0 0;padding:0 0 0 16px;font-size:14px;line-height:1.6;color:var(--ink);">
              <li>Measure referral invites per active expert</li>
              <li>Add one structured referral prompt</li>
              <li>Establish the referral baseline</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 8. KEY TAKEAWAY -->
      <section class="sec">
        <h2>Key takeaway</h2>
        <div class="findings">
          <div class="finding"><b>Finance and law are hardest to reach and most valuable to own.</b> Smallest pools, highest wages, no obvious channel.</div>
          <div class="finding"><b>Automated outbound scales volume; referrals scale quality.</b> They compound differently. The model shows the gap.</div>
          <div class="finding"><b>Cost per activated expert by domain is the number that matters.</b> It is not public. Measuring it is the first job.</div>
        </div>
      </section>

      <!-- 9. RESEARCH APPENDIX (collapsed) -->
      <details class="appendix">
        <summary>Research appendix</summary>
        <div class="app-inner">

          <!-- expert pool table -->
          <div class="app-sec">
            <h3>Expert-pool map: BLS OEWS, May 2025 [15, 16]</h3>
            <p style="font-size:13px;color:var(--mut);margin:0 0 10px;">Reach-difficulty: High if pool &lt; 250k or day-job wage &gt; $80/hr; Low if pool &gt; 500k and wage &lt; $60/hr; Medium otherwise [A2].</p>
            <div class="tbl">
              <table>
                <thead><tr><th>Occupation (BLS)</th><th class="num">U.S. employment</th><th class="num">Day-job wage / hr</th><th>Difficulty</th></tr></thead>
                <tbody>
                  {supplyData.map((r) => (
                    <tr>
                      <td class="occ">{r.occ}</td>
                      <td class="num">{r.emp}</td>
                      <td class="num">{r.wage}</td>
                      <td class={r.diff === 'High' ? 'diff-h' : r.diff === 'Medium' ? 'diff-m' : 'diff-l'}>{r.diff}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- benchmark mapping -->
          <div class="app-sec">
            <h3>Benchmark-to-occupation mapping [A1]</h3>
            <div class="tbl">
              <table>
                <thead><tr><th>Benchmark</th><th>Occupations implied</th><th>Source</th></tr></thead>
                <tbody>
                  <tr><td class="occ">SpreadsheetBench 2</td><td>Financial and Investment Analysts; Accountants and Auditors</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s5">[5]</a></td></tr>
                  <tr><td class="occ">FinanceQA</td><td>Financial and Investment Analysts; Financial Managers</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s10">[10]</a></td></tr>
                  <tr><td class="occ">Market-Bench</td><td>Securities and Financial Services Sales Agents; Financial and Investment Analysts</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s7">[7]</a></td></tr>
                  <tr><td class="occ">IDE-Bench</td><td>Software Developers</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s6">[6]</a></td></tr>
                  <tr><td class="occ">App-Bench</td><td>Software Developers; Web and Digital Interface Designers</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s8">[8]</a></td></tr>
                  <tr><td class="occ">UI-Bench</td><td>Web and Digital Interface Designers</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s9">[9]</a></td></tr>
                  <tr><td class="occ">GDPval (44 occ., 9 sectors)</td><td>Lawyers; Financial Managers; Software Developers; plus highest-earning digital occ. per sector</td><td style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut)"><a href="#s12">[12]</a><a href="#s13">[13]</a></td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- channel table -->
          <div class="app-sec">
            <h3>Channel comparison</h3>
            <div class="tbl">
              <table>
                <thead><tr><th>Channel</th><th>Verifiable reach</th><th>Not knowable from outside</th><th>Failure mode</th></tr></thead>
                <tbody>
                  <tr><td class="occ">Automated outbound</td><td>Occupation pools are public.</td><td>Reply and trust rates.</td><td>Volume rises; quality falls.</td></tr>
                  <tr><td class="occ">Campus partnerships</td><td>NSF names output by field and institution [17,19].</td><td>Whether departments will route students.</td><td>Institutional cycles take terms, not weeks.</td></tr>
                  <tr><td class="occ">Conferences</td><td>Many publish attendance numbers.</td><td>On-site conversion rates.</td><td>High spend per event; yield lags months.</td></tr>
                  <tr><td class="occ">Expert referrals</td><td>Active network size compounds referrals.</td><td>Referral rates in scarce fields.</td><td>Finite-work experts decline to refer competitors.</td></tr>
                  <tr><td class="occ">Associations / licensing</td><td>Bar, CPA, CFA bodies publish membership counts.</td><td>Whether the body permits outreach.</td><td>Access is gated; body can refuse.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- sources + assumptions -->
          <div class="app-sec refs">
            <div class="refs-grid">
              <div>
                <h3>Sources</h3>
                <ol class="reflist">
                  {sources.map((s) => (
                    <li id={`s${s.id}`}><span class="rn">[{s.id}]</span><span>{s.text}. <a href={s.url} target="_blank" rel="noopener">{s.url}</a> <span class="refd">({s.date})</span></span></li>
                  ))}
                </ol>
              </div>
              <div>
                <h3>Assumptions</h3>
                <ol class="reflist">
                  {assumptions.map((a) => (
                    <li id={a.id.toLowerCase()}><span class="rn">{a.id}</span><span>{a.text}</span></li>
                  ))}
                </ol>
              </div>
            </div>
          </div>

        </div>
      </details>

      <!-- 10. APPLICATION FOOTER -->
