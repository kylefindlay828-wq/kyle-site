---
// The Proofworks Engine (V2) — the standout centerpiece band.
// Light-stone / graphite panel (NOT cream), electric-blue emphasis.
const talent = ['Establish capability.', 'Build through real work.', 'Create credible work samples.', 'Access stronger jobs, contracts, and companies.'];
const company = ['Validated external talent.', 'Internal workforce transformation.', 'Development before and after placement.', 'Ongoing access to adaptive operators.'];
---
<section class="engine" aria-label="The Proofworks Engine">
  <div class="ewrap">
    <div class="e-title-mask mask-reveal" data-reveal>
      <h2 class="e-title">The Proofworks Engine</h2>
    </div>
    <p class="e-h2" data-reveal style="transition-delay:.1s">How it actually works.</p>

    <hr class="e-div" data-reveal />

    <div class="e-lead">
      <p data-reveal>Proofworks <b class="ca">attracts adaptive talent</b>,</p>
      <p data-reveal style="transition-delay:.1s">identifies <b class="cb">what each person can already do</b>,</p>
      <p data-reveal style="transition-delay:.2s">develops <b class="ca">capability through real work</b>,</p>
      <p data-reveal style="transition-delay:.3s">and connects <b class="cb">validated outputs</b> with company demand.</p>
    </div>

    <hr class="e-div" data-reveal />

    <div class="e-two">
      <div class="e-side" data-reveal>
        <h3 class="e-side-h ca">Talent enters directly</h3>
        <p class="e-side-b">Some arrive ready. Others arrive with the <b>judgment, ambition, and learning ability</b> to become highly valuable operators.</p>
        <ul class="e-list">
          {talent.map((o) => <li><span class="ca">•</span>{o}</li>)}
        </ul>
      </div>
      <div class="e-side" data-reveal style="transition-delay:.12s">
        <h3 class="e-side-h cb">Companies pay for capability</h3>
        <p class="e-side-b">Companies pay to <b>access, hire, develop, redeploy, and retain</b> talent that helps them adapt faster.</p>
        <ul class="e-list">
          {company.map((o) => <li><span class="cb">•</span>{o}</li>)}
        </ul>
      </div>
    </div>

    <p class="e-connect" data-reveal>Talent joins to become <b class="ca">more valuable</b>. Companies pay for <b class="cb">demonstrated capability</b>.</p>
  </div>
</section>

<style>
  /* light-stone / graphite standout band — deliberately NOT cream/white */
  .engine { position: relative; color: #23262b; padding: 92px 0; isolation: isolate;
    background: #e7e6e1;
    box-shadow: 0 -30px 70px -40px rgba(0,0,0,0.75), 0 30px 70px -40px rgba(0,0,0,0.75);
    --ca: #2f7fe0; --cb: #1f5aa6; }
  .engine::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0.5;
    background-image: linear-gradient(#d5d3cb 1px, transparent 1px), linear-gradient(90deg, #d5d3cb 1px, transparent 1px);
    background-size: 46px 46px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 28%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 28%, transparent 78%); }
  .ewrap { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
  .ca { color: var(--ca); } .cb { color: var(--cb); }

  .e-title-mask { padding-bottom: .06em; }
  .e-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-style: italic; text-transform: uppercase;
    font-size: clamp(44px, 8.2vw, 92px); line-height: 0.9; letter-spacing: -0.035em; color: #1a1d22; margin: 0; }
  .e-h2 { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-style: italic;
    font-size: clamp(22px, 3vw, 38px); line-height: 1.0; letter-spacing: -0.022em; color: #3a3e44; margin: 14px 0 0; }
  .e-div { border: 0; border-top: 1px solid #cfcdc4; margin: 36px 0; }

  .e-lead p { font-family: 'Space Grotesk', sans-serif; font-weight: 600;
    font-size: clamp(21px, 2.8vw, 33px); line-height: 1.16; letter-spacing: -0.02em; color: #22262c; margin: 0 0 .08em; max-width: 1040px; }
  .e-lead p:last-child { margin-bottom: 0; }
  .e-lead b { font-weight: 700; }

  .e-two { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .e-side:first-child { padding-right: 48px; border-right: 1px solid #cfcdc4; }
  .e-side:last-child { padding-left: 48px; }
  .e-side-h { font-family: 'Space Grotesk', sans-serif; font-weight: 700; text-transform: uppercase;
    font-size: clamp(19px, 2.2vw, 26px); line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 14px; }
  .e-side-b { font-size: clamp(16px, 1.7vw, 19px); line-height: 1.5; color: #4a4e55; margin: 0 0 20px; max-width: 470px; }
  .e-side-b b { color: #22262c; font-weight: 700; }
  .e-list { list-style: none; margin: 0; padding: 0; }
  .e-list li { display: flex; gap: 12px; font-family: 'Space Grotesk', sans-serif; font-weight: 600;
    font-size: clamp(17px, 1.9vw, 22px); line-height: 1.28; letter-spacing: -0.015em; color: #22262c; margin: 0 0 13px; }
  .e-list li span { font-weight: 800; }

  .e-connect { font-family: 'Space Grotesk', sans-serif; font-weight: 700;
    font-size: clamp(24px, 4vw, 46px); line-height: 1.08; letter-spacing: -0.03em; color: #17191d; margin: 44px 0 0; max-width: 1020px; }

  /* reveal (scoped) */
  [data-reveal] { opacity: 0; transform: translateY(24px);
    transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
  [data-reveal].in { opacity: 1; transform: none; }
  .mask-reveal[data-reveal] { opacity: 1; transform: none; overflow: hidden; }
  .mask-reveal[data-reveal] > * { transform: translateY(114%); transition: transform 1.05s cubic-bezier(.22,1,.36,1); }
  .mask-reveal[data-reveal].in > * { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
    .mask-reveal[data-reveal] > * { transform: none !important; transition: none !important; }
  }
  @media (max-width: 820px) {
    .engine { padding: 62px 0; }
    .e-two { grid-template-columns: 1fr; gap: 32px; }
    .e-side:first-child { padding-right: 0; border-right: 0; border-bottom: 1px solid #cfcdc4; padding-bottom: 30px; }
    .e-side:last-child { padding-left: 0; }
  }
</style>
