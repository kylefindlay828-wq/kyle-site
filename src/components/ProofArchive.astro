---
import { briefings, methodology, memo } from '../content/briefings';
import SectionRubric from './SectionRubric.astro';

// Memo relabeled to broaden beyond a single recruiting firm (the PDF itself is unchanged).
const memoCard = {
  title: 'How GTM Radar scales inside a GTM team',
  summary: 'A one-page memo on operationalizing the workflow inside a recruiting agency, RevOps, or GTM org.',
  pdf: memo.pdf,
};
const editions = [...briefings].sort((a, b) => b.week - a.week);
---
<section id="proof" class="py-16 scroll-mt-[var(--nav-h)]">
  <SectionRubric num="05" label="Proof & archive" />
  <h2 class="font-serif text-3xl md:text-4xl mt-8">The receipts.</h2>
  <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[680px]">
    Full briefings and the thinking behind them — the long-form proof under the cards
    above. Open if you want depth; the page already tells the story.
  </p>

  <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-ink/60 mt-10 mb-3">Editions</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {editions.map((b) => (
      <a href={b.pdf} target="_blank" rel="noopener" class="lift flex flex-col border border-rule rounded-lg bg-card p-5">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent">Week {b.week}</p>
        <p class="font-mono text-[11px] text-ink/55 mt-1">{b.dateRange} · {b.year}</p>
        <p class="text-[15px] text-ink/85 leading-snug mt-3 flex-1">{b.summary}</p>
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent mt-4">Open PDF →</p>
      </a>
    ))}
  </div>

  <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-ink/60 mt-10 mb-3">Memo &amp; methodology</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {[memoCard, { title: methodology.title, summary: methodology.summary, pdf: methodology.pdf }].map((d) => (
      <a href={d.pdf} target="_blank" rel="noopener" class="lift block border border-rule rounded-lg bg-card p-5">
        <p class="font-serif text-lg leading-snug">{d.title}</p>
        <p class="text-[15px] text-ink/75 mt-2">{d.summary}</p>
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent mt-4">Open PDF →</p>
      </a>
    ))}
  </div>
</section>
