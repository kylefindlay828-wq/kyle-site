---
const tabs = [
  { id: 'home', label: 'Home' },
  { id: 'work', label: 'Work' },
  { id: 'off-the-record', label: 'Off the Record' },
  { id: 'gtm-radar', label: 'GTM Radar' },
  { id: 'contact', label: 'Contact' },
];
---
<nav class="sticky top-0 bg-paper border-b border-rule z-10">
  <div class="max-w-content mx-auto px-6 py-4 flex items-center gap-6 relative">
    <a href="#home" class="font-serif font-bold text-lg tracking-tight text-ink">Kyle Findlay</a>

    <button id="nav-toggle" class="ml-auto sm:hidden text-ink text-xl" aria-label="Toggle menu">☰</button>

    <ul id="nav-list" class="hidden sm:flex ml-auto gap-6 text-[10px] uppercase tracking-[0.15em] text-muted
                             absolute sm:static top-full left-0 right-0 bg-paper border-b sm:border-0 border-rule
                             flex-col sm:flex-row p-6 sm:p-0">
      {tabs.map((t) => (
        <li>
          <a href={`#${t.id}`} data-tab={t.id} class="nav-link pb-1 border-b-2 border-transparent hover:text-ink block">
            {t.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const links = document.querySelectorAll('a[data-tab]');
  const sections = document.querySelectorAll('section[data-section]');

  function syncTabs() {
    const hash = window.location.hash.replace('#', '') || 'home';
    links.forEach((link) => {
      const isActive = link.getAttribute('data-tab') === hash;
      link.classList.toggle('text-ink', isActive);
      link.classList.toggle('border-accent', isActive);
      link.classList.toggle('text-muted', !isActive);
    });
    sections.forEach((section) => {
      section.classList.toggle('hidden', section.getAttribute('data-section') !== hash);
    });
    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  window.addEventListener('hashchange', syncTabs);
  syncTabs();

  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');
  toggle?.addEventListener('click', () => {
    list.classList.toggle('hidden');
    list.classList.toggle('flex');
  });
  document.querySelectorAll('a[data-tab]').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 640) {
        list.classList.add('hidden');
        list.classList.remove('flex');
      }
    });
  });
</script>
