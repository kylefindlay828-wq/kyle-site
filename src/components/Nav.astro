---
const p = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isV1 = p === '/gtm-radar';
const isV2 = p === '/radar-v2';
const isAbout = p === '/';
---
<nav class="sticky top-0 z-30 bg-paper border-t-2 border-accent border-b border-rule">
  <div class="max-w-content mx-auto px-6 py-3 flex items-baseline gap-6 relative">
    <a href="/" class="font-serif font-bold text-xl md:text-2xl tracking-tight text-ink shrink-0">Kyle Findlay</a>

    <div class="ml-auto flex items-center gap-4 sm:gap-5 self-center">
      <ul id="nav-list" class="hidden sm:flex gap-6 font-mono text-[11px] uppercase tracking-[0.12em] text-muted
                               absolute sm:static top-full left-0 right-0 bg-paper sm:bg-transparent border-b sm:border-0 border-rule
                               flex-col sm:flex-row p-6 sm:p-0">
        <li>
          <span class="ver-toggle">
            <a href="/gtm-radar" class:list={["ver", isV1 ? "ver-active" : "ver-idle"]} aria-current={isV1 ? "page" : undefined}>GTM Radar V1</a>
            <a href="/radar-v2" class:list={["ver", isV2 ? "ver-active" : "ver-idle"]} aria-current={isV2 ? "page" : undefined}>GTM Radar V2</a>
          </span>
        </li>
        <li>
          <a href="/" class:list={["ver-solo", isAbout && "ver-solo-active"]} aria-current={isAbout ? "page" : undefined}>About &amp; Contact</a>
        </li>
      </ul>
      <button id="nav-toggle" class="sm:hidden text-ink text-xl shrink-0" aria-label="Toggle menu" aria-expanded="false">☰</button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');
  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('hidden') === false;
    list?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  /* segmented V1 | V2 toggle — the current page is filled, the others plain */
  .ver-toggle { display: inline-flex; align-items: stretch; border: 1px solid var(--color-rule); border-radius: 999px; overflow: hidden; }
  .ver { display: inline-flex; align-items: center; gap: 6px; padding: 6px 13px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .ver-idle { color: var(--color-ink); }
  .ver-idle:hover { background: color-mix(in srgb, var(--color-ink) 7%, transparent); }
  .ver-active { color: var(--color-on-accent); background: var(--color-accent); }
  /* About & Contact — matched pill; filled when it's the current page */
  .ver-solo { display: inline-flex; align-items: center; padding: 6px 13px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink); border: 1px solid var(--color-rule); border-radius: 999px; transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out), border-color 0.2s var(--ease-out); }
  .ver-solo:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .ver-solo-active { color: var(--color-on-accent); background: var(--color-accent); border-color: var(--color-accent); }
  .ver-solo-active:hover { color: var(--color-on-accent); }
</style>
