---
const p = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isV1 = p === '/gtm-radar';
const isV2 = p === '/radar-v2';
const isAbout = p === '/';
const isProofworks = p === '/proofworks';
---
<nav class="sticky top-0 z-30 bg-paper/90 backdrop-blur-md border-b border-rule">
  <div class="max-w-content mx-auto px-6 py-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <a href="/" class="font-serif font-bold text-xl md:text-2xl tracking-tight text-ink shrink-0">Kyle Findlay</a>

    <div class="nav-group">
      <a href="/gtm-radar" class:list={["nl", isV1 && "nl-on"]} aria-current={isV1 ? "page" : undefined}>GTM Radar V1</a>
      <span class="nsep" aria-hidden="true">·</span>
      <a href="/radar-v2" class:list={["nl", isV2 && "nl-on"]} aria-current={isV2 ? "page" : undefined}>GTM Radar V2</a>
      <span class="nsep" aria-hidden="true">·</span>
      <a href="/" class:list={["nl", isAbout && "nl-on"]} aria-current={isAbout ? "page" : undefined}>About &amp; Contact</a>
    </div>

    <a href="/proofworks" class:list={["navpill", isProofworks && "navpill-on"]} aria-current={isProofworks ? "page" : undefined}>/proofworks</a>
  </div>
</nav>

<style>
  /* grouped page links — matches the /proofworks page nav layout */
  .nav-group { display: inline-flex; align-items: center; gap: 12px; padding: 7px 16px;
    border: 1px solid var(--color-rule); border-radius: 999px; }
  .nl { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em; color: var(--color-muted); transition: color 0.2s var(--ease-out); }
  .nl:hover { color: var(--color-ink); }
  .nl-on { color: var(--color-accent); }
  .nsep { color: var(--color-rule); }
  /* /proofworks pill on the right — accent; filled when it's the current page */
  .navpill { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.03em; color: var(--color-accent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 42%, transparent); border-radius: 999px; padding: 6px 14px;
    background: color-mix(in srgb, var(--color-accent) 6%, transparent); transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .navpill:hover { background: color-mix(in srgb, var(--color-accent) 12%, transparent); }
  .navpill-on { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
  .navpill-on:hover { background: var(--color-accent); color: var(--color-on-accent); }
</style>
