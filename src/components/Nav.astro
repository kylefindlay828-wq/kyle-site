---
const links = [
  { id: 'gtm-radar', label: 'GTM Radar' },
  { id: 'signals', label: 'Signals' },
  { id: 'workflows', label: 'Workflows' },
  { id: 'how', label: 'How it works' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];
---
<nav class="sticky top-0 z-30 bg-paper/85 backdrop-blur border-b border-rule">
  <div class="max-w-content mx-auto px-6 py-3.5 flex items-center gap-6 relative">
    <a href="#top" class="font-serif font-bold text-lg tracking-tight text-ink shrink-0">Kyle Findlay</a>

    <button id="nav-toggle" class="ml-auto sm:hidden text-ink text-xl" aria-label="Toggle menu" aria-expanded="false">☰</button>

    <ul id="nav-list" class="hidden sm:flex ml-auto gap-6 font-mono text-[11px] uppercase tracking-[0.12em] text-muted
                             absolute sm:static top-full left-0 right-0 bg-paper sm:bg-transparent border-b sm:border-0 border-rule
                             flex-col sm:flex-row p-6 sm:p-0">
      {links.map((l) => (
        <li>
          <a href={`#${l.id}`} data-nav={l.id} class="nav-link block pb-0.5 border-b-2 border-transparent hover:text-ink hover:border-accent transition">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');

  function closeMenu() {
    list?.classList.add('hidden');
    list?.classList.remove('flex');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('hidden') === false;
    list?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  list?.querySelectorAll('a[data-nav]').forEach((a) => {
    a.addEventListener('click', () => { if (window.innerWidth < 640) closeMenu(); });
  });

  // active-section highlight
  const links = Array.from(document.querySelectorAll('a[data-nav]')) as HTMLAnchorElement[];
  const setActive = (id: string) => {
    links.forEach((a) => {
      const on = a.getAttribute('data-nav') === id;
      a.classList.toggle('text-ink', on);
      a.classList.toggle('border-accent', on);
      a.classList.toggle('text-muted', !on);
      a.classList.toggle('border-transparent', !on);
    });
  };
  const sections = links
    .map((a) => document.getElementById(a.getAttribute('data-nav')!))
    .filter(Boolean) as HTMLElement[];
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((s) => obs.observe(s));
</script>
