---
const links = [
  { id: 'gtm-radar', label: 'GTM Radar V1' },
  { id: 'about', label: 'About' },
];
---
<nav class="sticky top-0 z-30 bg-paper border-t-2 border-accent border-b border-rule">
  <div class="max-w-content mx-auto px-6 py-3 flex items-baseline gap-6 relative">
    <a href="/" class="font-serif font-bold text-xl md:text-2xl tracking-tight text-ink shrink-0">Kyle Findlay</a>

    <div class="ml-auto flex items-center gap-4 sm:gap-5 self-center">
      <ul id="nav-list" class="hidden sm:flex gap-6 font-mono text-[11px] uppercase tracking-[0.12em] text-muted
                               absolute sm:static top-full left-0 right-0 bg-paper sm:bg-transparent border-b sm:border-0 border-rule
                               flex-col sm:flex-row p-6 sm:p-0">
        <li>
          <span class="ver-toggle">
            <a href="/gtm-radar" class="ver ver-v1">GTM Radar V1</a>
            <a href="/radar-v2" class="ver ver-v2"><span class="v2-dot" aria-hidden="true"></span>GTM Radar V2</a>
          </span>
        </li>
        <li>
          <a href="/" class="ver-solo">About &amp; Contact</a>
        </li>
      </ul>
      <button id="nav-toggle" class="sm:hidden text-ink text-xl shrink-0" aria-label="Toggle menu" aria-expanded="false">☰</button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');

  function closeMenu() {
    list?.classList.add('hidden');
    list?.classList.remove('flex');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const open = list?.classList.toggle('hidden') === false;
    list?.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
  });

  list?.querySelectorAll('a[data-nav]').forEach((a) => {
    a.addEventListener('click', () => { if (window.innerWidth < 640) closeMenu(); });
  });

  // active-section highlight
  const links = Array.from(document.querySelectorAll('a[data-nav]')) as HTMLAnchorElement[];
  const setActive = (id: string) => {
    links.forEach((a) => {
      const on = a.getAttribute('data-nav') === id;
      a.classList.toggle('text-ink', on);
      a.classList.toggle('border-accent', on);
      a.classList.toggle('text-muted', !on);
      a.classList.toggle('border-transparent', !on);
    });
  };
  const sections = links
    .map((a) => document.getElementById(a.getAttribute('data-nav')!))
    .filter(Boolean) as HTMLElement[];
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.id); });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((s) => obs.observe(s));
</script>

<style>
  /* segmented V1 | V2 toggle — two versions, one control */
  .ver-toggle { display: inline-flex; align-items: stretch; border: 1px solid var(--color-rule); border-radius: 999px; overflow: hidden; }
  .ver { display: inline-flex; align-items: center; gap: 6px; padding: 6px 13px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .ver-v1 { color: var(--color-ink); }
  .ver-v1:hover { background: color-mix(in srgb, var(--color-ink) 7%, transparent); color: var(--color-ink); }
  .ver-v2 { color: var(--color-on-accent); background: var(--color-accent); }
  .ver-v2:hover { color: var(--color-on-accent); opacity: 0.92; }
  /* About & Contact — matched pill, in line with the version toggle */
  .ver-solo { display: inline-flex; align-items: center; padding: 6px 13px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink); border: 1px solid var(--color-rule); border-radius: 999px; transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out); }
  .ver-solo:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .v2-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-on-accent); box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-on-accent) 70%, transparent); animation: v2pulse 2s ease-out infinite; }
  @keyframes v2pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-on-accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 6px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) { .v2-dot { animation: none; } }
</style>
