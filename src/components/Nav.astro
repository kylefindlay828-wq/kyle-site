---
const tabs = [
  { id: 'gtm-radar', label: 'GTM Radar' },
  { id: 'profile', label: 'Profile' },
];
---
<nav class="sticky top-0 bg-paper border-b border-rule z-10">
  <div class="max-w-content mx-auto px-6 py-4 flex items-center gap-6 relative">
    <a href="#" class="font-serif font-bold text-lg tracking-tight text-ink">Kyle Findlay</a>

    <button id="nav-toggle" class="ml-auto sm:hidden text-ink text-xl" aria-label="Toggle menu">☰</button>

    <ul id="nav-list" class="hidden sm:flex ml-auto gap-6 text-[10px] uppercase tracking-[0.15em] text-muted
                             absolute sm:static top-full left-0 right-0 bg-paper border-b sm:border-0 border-rule
                             flex-col sm:flex-row p-6 sm:p-0">
      {tabs.map((t) => (
        <li>
          <button data-tab={t.id} class="nav-tab pb-1 border-b-2 border-transparent hover:text-ink hover:border-accent transition block">
            {t.label}
          </button>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const list = document.getElementById('nav-list');

  function activateTab(id: string) {
    document.querySelectorAll('[data-section]').forEach((el) => {
      (el as HTMLElement).style.display = el.getAttribute('data-section') === id ? '' : 'none';
    });
    document.querySelectorAll('.nav-tab').forEach((btn) => {
      const active = btn.getAttribute('data-tab') === id;
      btn.classList.toggle('text-ink', active);
      btn.classList.toggle('border-accent', active);
      btn.classList.toggle('text-muted', !active);
      btn.classList.toggle('border-transparent', !active);
    });
  }

  document.querySelectorAll('.nav-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-tab')!;
      activateTab(id);
      if (window.innerWidth < 640) {
        list?.classList.add('hidden');
        list?.classList.remove('flex');
      }
    });
  });

  toggle?.addEventListener('click', () => {
    list?.classList.toggle('hidden');
    list?.classList.toggle('flex');
  });

  activateTab('gtm-radar');
</script>
