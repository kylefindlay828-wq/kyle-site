  <dl class="space-y-5 font-serif text-lg">
    <div>
      <dt class="text-[10px] uppercase tracking-[0.15em] text-muted font-sans mb-1">Email</dt>
      <dd><a href={`mailto:${email}`} class="underline-offset-4 hover:underline hover:text-accent">{email}</a></dd>
    </div>
    <div>
      <dt class="text-[10px] uppercase tracking-[0.15em] text-muted font-sans mb-1">LinkedIn</dt>
      <dd><a href={linkedin} target="_blank" rel="noopener" class="underline-offset-4 hover:underline hover:text-accent">linkedin.com/in/kylefindlay828</a></dd>
    </div>
    <div>
      <dt class="text-[10px] uppercase tracking-[0.15em] text-muted font-sans mb-1">Location</dt>
      <dd class="text-ink/80">Los Angeles · open to SF / Austin · available immediately</dd>
    </div>
  </dl>
