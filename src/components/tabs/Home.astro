---
import { Image } from 'astro:assets';
import headshot from '../../assets/photos/headshot.jpg';
---
<div class="pt-6 md:pt-12">
  <div class="grid grid-cols-1 md:grid-cols-[140px_1fr] gap-8 items-start">
    <Image
      src={headshot}
      alt="Kyle Findlay"
      width={280}
      height={280}
      class="rounded-full w-[140px] h-[140px] object-cover"
    />
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Kyle Findlay</p>
      <h2 class="font-serif text-3xl md:text-4xl leading-tight mb-4">
        GTM operator. Seven years on the client side. Now building the intelligence layer for how retained search finds its next deal.
      </h2>
      <p class="font-serif text-lg text-ink/80 leading-relaxed">
        Seven years building the operator layer behind high-stakes client programs. Now focused on the same craft applied inside early-stage tech.
      </p>
      <p class="font-serif text-base text-ink/70 leading-relaxed mt-4">
        <span class="text-[10px] font-sans font-semibold uppercase tracking-[0.2em] text-accent mr-2">Currently</span>
        Running GTM Radar — a weekly intelligence briefing tracking AI-reshaped hiring across 63 companies. Week 17 published.
      </p>

      <div class="flex flex-wrap gap-3 mt-6">
        <a
          href="#gtm-radar"
          class="inline-block px-5 py-2.5 bg-accent text-paper text-[11px] font-semibold uppercase tracking-[0.15em] rounded-full hover:opacity-90 transition"
        >View GTM Radar</a>
        <a
          href="#contact"
          class="inline-block px-5 py-2.5 border border-rule text-ink text-[11px] font-semibold uppercase tracking-[0.15em] rounded-full hover:border-accent hover:text-accent transition"
        >Contact Me</a>
      </div>
    </div>
  </div>
</div>
