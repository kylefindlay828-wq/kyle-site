---
import { Image } from 'astro:assets';
import headshot from '../../assets/photos/headshot.jpg';
import { briefings, memo } from '../../content/briefings';

const heroSelected = {
  src: '/photos/work/experiential-4.jpeg',
  label: 'Experiential Production',
  href: '/#work',
};

const selectedRest = [
  { src: '/photos/work/experiential-10.jpeg', label: 'Experiential Production', href: '/#work' },
  { src: '/photos/work/experiential-8.jpeg', label: 'Insider Expeditions', href: '/#work' },
  { src: '/photos/work/neptune-5.JPG', label: 'Neptune Retail Solutions', href: '/#work' },
  { src: '/photos/work/experiential-3.jpeg', label: 'Experiential Production', href: '/#work' },
];
---
<div class="pt-6 md:pt-12">
  {/* Hero */}
  <div class="grid grid-cols-1 md:grid-cols-[140px_1fr] gap-8 items-start">
    <Image
      src={headshot}
      alt="Kyle Findlay"
      width={280}
      height={280}
      class="rounded-full w-[140px] h-[140px] object-cover"
    />
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Kyle Findlay</p>
      <h2 class="font-serif text-3xl md:text-4xl leading-tight mb-4">
        Customer Success, Partnerships, and GTM for early-stage tech.
      </h2>
      <p class="font-serif text-lg text-ink/80 leading-relaxed">
        Seven years building the operator layer behind high-stakes client programs. Now focused on the same craft applied inside early-stage tech.
      </p>
    </div>
  </div>

  {/* GTM Radar — featured block */}
  <section class="mt-16 md:mt-20 pt-10 border-t border-rule">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">GTM Radar</p>
    <h3 class="font-serif text-2xl md:text-3xl mb-4">A weekly intelligence briefing on AI-reshaped GTM.</h3>
    <p class="font-serif text-lg text-ink/85 leading-relaxed max-w-[640px]">
      Built for GTM recruiters who need to know which companies just raised, who's moving, and what to say in outreach — before the search brief is written. Human-in-the-loop research, not an automated feed.
    </p>

    <h4 class="font-serif text-xl mt-10 mb-4">Recent editions</h4>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {briefings.map((b) => (
        <a href={b.pdf} target="_blank" rel="noopener" class="block border border-rule rounded p-5 hover:border-accent transition bg-white">
          <p class="text-[10px] uppercase tracking-[0.15em] text-muted mb-2">Week {b.week} · {b.year} · {b.dateRange}</p>
          <p class="font-serif text-base leading-snug">{b.summary}</p>
          <p class="text-xs text-accent mt-3 uppercase tracking-[0.12em]">Open PDF →</p>
        </a>
      ))}
    </div>

    <h4 class="font-serif text-xl mt-10 mb-4">Memo</h4>
    <a href={memo.pdf} target="_blank" rel="noopener" class="block border border-rule rounded p-5 hover:border-accent transition bg-white">
      <p class="text-[10px] uppercase tracking-[0.15em] text-muted mb-2">One-pager</p>
      <p class="font-serif text-lg leading-snug">{memo.title}</p>
      <p class="text-sm text-ink/75 mt-2">{memo.summary}</p>
      <p class="text-xs text-accent mt-3 uppercase tracking-[0.12em]">Open PDF →</p>
    </a>

    <p class="mt-6">
      <a href="/#gtm-radar" class="text-[12px] uppercase tracking-[0.18em] text-accent hover:underline">See the workflow →</a>
    </p>
  </section>

  {/* Selected Work — agency-portfolio grid */}
  <section class="mt-16 md:mt-20 pt-10 border-t border-rule">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Selected Work</p>
    <h3 class="font-serif text-2xl md:text-3xl mb-8">A few of the rooms.</h3>

    <div class="grid grid-cols-1 gap-1 md:gap-2">
      {/* Hero */}
      <a
        href={heroSelected.href}
        class="selected-tile group relative block overflow-hidden bg-ink"
        aria-label={heroSelected.label}
      >
        <div
          class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-[1.02]"
          style={`background-image: url('${heroSelected.src}'), linear-gradient(135deg, #1a1613 0%, #5d554a 100%);`}
        />
        <div class="aspect-[16/9]" />
        <div class="absolute inset-0 bg-ink/40 md:bg-ink/0 md:group-hover:bg-ink/55 transition" />
        <div class="absolute bottom-0 left-0 right-0 p-5 md:p-6 text-paper md:opacity-0 md:group-hover:opacity-100 transition duration-300">
          <p class="font-serif text-xl leading-tight">{heroSelected.label} →</p>
        </div>
      </a>

      {/* 2x2 below */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-1 md:gap-2">
        {selectedRest.map((s) => (
          <a
            href={s.href}
            class="selected-tile group relative block overflow-hidden bg-ink"
            aria-label={s.label}
          >
            <div
              class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-[1.02]"
              style={`background-image: url('${s.src}'), linear-gradient(135deg, #1a1613 0%, #5d554a 100%);`}
            />
            <div class="aspect-[4/3]" />
            <div class="absolute inset-0 bg-ink/40 md:bg-ink/0 md:group-hover:bg-ink/55 transition" />
            <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5 text-paper md:opacity-0 md:group-hover:opacity-100 transition duration-300">
              <p class="font-serif text-lg leading-tight">{s.label} →</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* Currently */}
  <section class="mt-16 md:mt-20 max-w-2xl">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Currently</p>
    <p class="font-serif text-lg text-ink/85 leading-relaxed">
      Publishing GTM Radar — a weekly briefing on go-to-market motion in early-stage tech. Based in Los Angeles, relocating to San Francisco June 1. Open to GTM, customer success, and partnerships roles at early-stage startups.
    </p>
  </section>
</div>
