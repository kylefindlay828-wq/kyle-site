---
import { roles, education } from '../../content/work';
---
<div class="pt-6 md:pt-12">
  <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Work</p>
  <h2 class="font-serif text-3xl mb-8">A career built on running operator-heavy programs.</h2>

  <div class="space-y-10">
    {roles.map((role) => (
      <article class="border-t border-rule pt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 mb-2">
          <h3 class="font-serif text-xl">
            {role.company}
            {role.subtitle && <span class="text-muted text-base font-normal"> · {role.subtitle}</span>}
          </h3>
          <p class="text-xs uppercase tracking-[0.12em] text-muted">{role.period}</p>
        </div>
        <p class="font-serif text-[17px] leading-relaxed text-ink/85">{role.summary}</p>
      </article>
    ))}
  </div>

  <div class="mt-12 pt-6 border-t border-rule">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted mb-3">Education</p>
    <ul class="space-y-1 text-sm text-ink/80">
      {education.map((e) => (
        <li><span class="font-serif text-base">{e.school}</span>{e.detail && <span class="text-muted"> · {e.detail}</span>}</li>
      ))}
    </ul>
  </div>
</div>
