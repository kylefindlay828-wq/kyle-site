---
import { roles } from '../../content/work';
---
<div class="pt-6 md:pt-12">
  <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Work</p>
  <h2 class="font-serif text-3xl mb-2">The places that taught me.</h2>
  <p class="text-muted mb-8 text-sm">Hover a card for the short version. Click in for the story and the links.</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
    {roles.map((role) => (
      <button
        class="work-card group relative aspect-[4/5] overflow-hidden bg-ink cursor-pointer text-left transition"
        data-role-id={role.id}
        aria-label={`${role.title} — open detail`}
      >
        <div
          class="absolute inset-0 bg-cover bg-center transition duration-500 group-hover:scale-105"
          style={`background-image: linear-gradient(135deg, #1a1613 0%, #5d554a 100%), url('${role.photo}'); background-image: url('${role.photo}'), linear-gradient(135deg, #1a1613 0%, #5d554a 100%);`}
        />

        {/* Mobile: always-visible label strip */}
        <div class="md:hidden absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-ink/95 via-ink/60 to-transparent text-paper">
          <p class="font-serif text-lg leading-tight">{role.title}</p>
          <p class="text-[11px] uppercase tracking-wider opacity-80 mt-1 line-clamp-2">{role.subtitle}</p>
        </div>

        {/* Desktop: hover overlay */}
        <div class="hidden md:flex absolute inset-0 bg-ink/90 text-paper p-5 flex-col justify-end opacity-0 group-hover:opacity-100 transition duration-300">
          <p class="font-serif text-xl leading-tight mb-2">{role.title}</p>
          <p class="text-[10px] uppercase tracking-[0.15em] text-paper/75 mb-3 line-clamp-2">{role.subtitle}</p>
          <p class="text-[13px] leading-relaxed text-paper/90 line-clamp-5">{role.body}</p>
          <p class="text-[10px] uppercase tracking-[0.18em] mt-4 text-accent">Click for more →</p>
        </div>
      </button>
    ))}
  </div>
</div>

{/* Modal */}
<div id="work-modal" class="hidden fixed inset-0 bg-ink/90 z-50 overflow-y-auto">
  <button id="work-close" class="fixed top-5 right-5 text-paper text-3xl z-10 hover:text-accent transition w-10 h-10 flex items-center justify-center" aria-label="Close">✕</button>
  <div class="min-h-screen flex items-start justify-center p-4 md:p-8">
    <div id="work-modal-content" class="max-w-3xl w-full bg-paper rounded-sm overflow-hidden my-8 md:my-12"></div>
  </div>
</div>

<script define:vars={{ roles }}>
  const modal = document.getElementById('work-modal');
  const content = document.getElementById('work-modal-content');
  const close = document.getElementById('work-close');

  function esc(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  document.querySelectorAll('.work-card').forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-role-id');
      const role = roles.find((r) => r.id === id);
      if (!role) return;

      const links = role.links || [];
      const linksHtml = links.length > 0
        ? `<div class="flex flex-wrap gap-2 mt-6">${links.map((l) =>
            `<a href="${esc(l.url)}" target="_blank" rel="noopener noreferrer" class="text-[12px] px-3 py-1.5 border border-rule rounded-full hover:border-accent hover:text-accent transition ${l.kind === 'instagram' ? 'italic' : ''}">${esc(l.label)}</a>`
          ).join('')}</div>`
        : '';

      const detailPhotos = role.detailPhotos || [];
      const moreHtml = detailPhotos.length > 0
        ? `<div class="grid grid-cols-2 md:grid-cols-3 gap-2 mt-8">${detailPhotos.map((p) =>
            `<div class="aspect-square bg-cover bg-center bg-rule" style="background-image: url('${esc(p)}');"></div>`
          ).join('')}</div>`
        : '';

      const heroHtml = role.photo
        ? `<div class="aspect-[16/9] bg-cover bg-center bg-ink" style="background-image: url('${esc(role.photo)}');"></div>`
        : '';

      content.innerHTML = `
        ${heroHtml}
        <div class="p-6 md:p-10">
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">${esc(role.subtitle)}</p>
          <h3 class="font-serif text-3xl mb-4">${esc(role.title)}</h3>
          <p class="text-[15px] leading-relaxed text-ink/90">${esc(role.body)}</p>
          ${linksHtml}
          ${moreHtml}
        </div>
      `;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }
  close.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });
</script>
