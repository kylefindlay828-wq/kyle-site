---
import { roles, education } from '../../content/work';
import PhotoGallery from '../PhotoGallery.astro';
---
<div class="pt-6 md:pt-12">
  <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">Work</p>
  <h2 class="font-serif text-3xl mb-10">The places that taught me.</h2>

  {roles.map((role, idx) => (
    <section class={idx > 0 ? 'mt-14 pt-10 border-t border-rule' : ''}>
      <header class="mb-6">
        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent mb-2">{role.subtitle}</p>
        <h3 class="font-serif text-2xl md:text-3xl mb-3">{role.title}</h3>
        {role.body.split(/\n{2,}/).map((para) => (
          <p class="text-[15px] leading-relaxed text-ink/90 max-w-3xl mb-3 last:mb-0">{para}</p>
        ))}
        {role.links && role.links.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-5">
            {role.links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'text-[12px] px-3 py-1.5 border border-rule rounded-full hover:border-accent hover:text-accent transition',
                  l.kind === 'instagram' && 'italic',
                ]}
              >{l.label}</a>
            ))}
          </div>
        )}
      </header>

      {role.photos && role.photos.length > 0 && (
        <PhotoGallery photos={role.photos} groupId={role.id} />
      )}
    </section>
  ))}

  {/* Education footer */}
  <div class="mt-14 pt-6 border-t border-rule">
    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted mb-3">Education</p>
    <ul class="space-y-1 text-sm text-ink/80">
      {education.map((e) => (
        <li><span class="font-serif text-base">{e.school}</span>{e.detail && <span class="text-muted"> · {e.detail}</span>}</li>
      ))}
    </ul>
  </div>
</div>

{/* Lightbox */}
<div id="lightbox" class="hidden fixed inset-0 bg-ink/95 z-50 items-center justify-center p-4 md:p-8">
  <button
    id="lb-close"
    class="absolute top-4 right-4 text-paper hover:text-accent transition w-10 h-10 flex items-center justify-center text-2xl"
    aria-label="Close"
  >✕</button>
  <button
    id="lb-prev"
    class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 text-paper hover:text-accent transition w-12 h-12 flex items-center justify-center text-4xl leading-none"
    aria-label="Previous photo"
  >‹</button>
  <button
    id="lb-next"
    class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 text-paper hover:text-accent transition w-12 h-12 flex items-center justify-center text-4xl leading-none"
    aria-label="Next photo"
  >›</button>
  <img
    id="lightbox-img"
    src=""
    alt=""
    class="max-h-[90vh] max-w-[92vw] object-contain rounded-sm"
  />
</div>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('lb-close');
  const prevBtn = document.getElementById('lb-prev');
  const nextBtn = document.getElementById('lb-next');

  if (lightbox && lightboxImg && closeBtn && prevBtn && nextBtn) {
    let group: string[] = [];
    let index = 0;

    const show = () => {
      lightboxImg.src = group[index];
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.src = '';
      document.body.style.overflow = '';
    };
    const next = () => { index = (index + 1) % group.length; show(); };
    const prev = () => { index = (index - 1 + group.length) % group.length; show(); };

    document.querySelectorAll<HTMLImageElement>('.gallery-photo').forEach((img) => {
      img.addEventListener('click', () => {
        const container = img.closest('[data-gallery]');
        if (!container) return;
        const siblings = Array.from(container.querySelectorAll<HTMLImageElement>('.gallery-photo'));
        group = siblings.map((s) => s.src);
        index = siblings.indexOf(img);
        show();
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prev(); });
    nextBtn.addEventListener('click', (e) => { e.stopPropagation(); next(); });
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });
  }
</script>
