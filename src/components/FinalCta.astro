---
const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
---
<section id="contact" class="py-24 scroll-mt-20" data-reveal>
  <div class="max-w-[720px]">
    <h2 class="font-serif text-3xl md:text-[2.5rem] leading-[1.1]">
      Need someone who can turn messy market signals into usable AI workflows?
    </h2>
    <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[620px]">
      I'm exploring AI-adjacent GTM, recruiting intelligence, RevOps, solutions,
      implementation, and operator roles.
    </p>
    <div class="mt-10 flex flex-col gap-2.5">
      <a href={`mailto:${email}`} class="font-serif text-2xl md:text-3xl text-ink hover:text-accent underline decoration-rule decoration-1 underline-offset-[6px] hover:decoration-accent transition w-fit">
        {email}
      </a>
      <a href={linkedin} target="_blank" rel="noopener" class="font-serif text-lg md:text-xl text-ink/85 hover:text-accent underline decoration-rule decoration-1 underline-offset-[6px] hover:decoration-accent transition w-fit">
        linkedin.com/in/kylefindlay828
      </a>
    </div>
    <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">Available immediately</p>
  </div>
</section>
