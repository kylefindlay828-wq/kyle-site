---
const email = 'kylefindlay828@gmail.com';
const linkedin = 'https://www.linkedin.com/in/kylefindlay828';
---
<section id="contact" data-reveal class="py-20 md:py-24 border-t border-rule scroll-mt-16">
  <div class="max-w-[900px]">
    <p class="font-serif font-semibold leading-[1.2]" style="font-size:clamp(1.4rem,2.4vw,1.9rem);">
      “Kyle gets close to an unfinished operating problem, makes it work manually, finds the repeatable pattern, and helps turn it into a system or product.”
    </p>

    <div class="mt-12 flex flex-col gap-4 items-start">
      <button id="copy-email" type="button" data-email={email} aria-label="Copy email address"
        class="group inline-flex items-center gap-3 cursor-pointer text-left w-fit">
        <span class="ce-text font-serif text-ink group-hover:text-accent underline decoration-rule decoration-1 underline-offset-[6px] group-hover:decoration-accent transition" style="font-size:clamp(1.375rem,2.6vw,2rem);">
          {email}
        </span>
        <span class="font-mono text-ink/50 group-hover:text-accent transition" style="font-size:clamp(14px,1.1vw,16px);" aria-hidden="true">⧉ copy</span>
      </button>
      <a href={linkedin} target="_blank" rel="noopener"
        class="font-serif text-ink/85 hover:text-accent underline decoration-rule decoration-1 underline-offset-[6px] hover:decoration-accent transition w-fit" style="font-size:clamp(1.125rem,1.6vw,1.375rem);">
        linkedin.com/in/kylefindlay828
      </a>
    </div>
  </div>
</section>

<script>
  // "Copy email" — copies the address to the clipboard, briefly shows "Copied". No mailto.
  const btn = document.getElementById('copy-email');
  const label = btn?.querySelector('.ce-text');
  const original = label?.textContent?.trim() ?? '';
  btn?.addEventListener('click', async () => {
    const addr = btn.getAttribute('data-email') ?? '';
    try {
      await navigator.clipboard.writeText(addr);
    } catch {
      const t = document.createElement('textarea');
      t.value = addr; document.body.appendChild(t); t.select();
      document.execCommand('copy'); t.remove();
    }
    if (label) {
      label.textContent = 'Copied ✓';
      setTimeout(() => { label.textContent = original; }, 1800);
    }
  });
</script>
