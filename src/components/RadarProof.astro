---
import { watchlist, watchlistTotal } from '../content/watchlist';
import EditionsPicker from './EditionsPicker.astro';
import WatchlistTree from './WatchlistTree.astro';

const tiles = [
  { n: '6', label: 'sectors covered' },
  { n: '30–90d', label: 'scoring window' },
];

// 63 companies as a tally — six tens + a three — with an accent pulse sweeping
// left→right, so the count is unmistakable AND the tile feels alive.
const wlGroups = [10, 10, 10, 10, 10, 10, 3];
let _b = 0;
const wlTally = wlGroups.map((count) =>
  Array.from({ length: count }, () => ({ d: (_b++ * 0.035).toFixed(3) }))
);

// categorical palette — tokens defined in global.css, referenced by var()
const segColors = [
  'var(--color-cat-1)', 'var(--color-cat-2)', 'var(--color-cat-3)',
  'var(--color-cat-4)', 'var(--color-cat-5)', 'var(--color-cat-6)',
];
const sectors = watchlist.map((b, i) => ({
  label: b.label,
  count: b.companies.length,
  pct: (b.companies.length / watchlistTotal) * 100,
  color: segColors[i % segColors.length],
}));
---
<section id="gtm-radar" class="py-24 border-b border-rule scroll-mt-20">
  <p class="kicker">Proof of work · GTM Radar</p>
  <h2 class="font-serif text-4xl md:text-5xl leading-[1.06] mt-4 max-w-[720px]">A working intelligence system, not a slide.</h2>
  <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[680px]">
    It watches AI-adopting companies for the signals that precede a GTM hiring wave —
    funding, exec moves, layoffs, launches — and scores each for hiring likelihood in
    the next 30–90 days.
  </p>
  <p class="font-serif text-lg md:text-xl text-ink leading-snug mt-5 max-w-[680px] pl-4 border-l-2 border-accent">
    AI-reshaped GTM is the lens, not the limit — <span class="text-muted">the engine runs on any watchlist, AI or not.</span>
  </p>

  <!-- dashboard tiles -->
  <div class="tiles-grid grid grid-cols-2 md:grid-cols-4 gap-px bg-rule border border-rule rounded-lg overflow-visible mt-10">
    <EditionsPicker />
    <button id="wl-trigger" type="button" class="stat-tile ed-trigger" aria-expanded="false" aria-controls="wl-panel">
      <span class="tile-n">{watchlistTotal}</span>
      <span class="tile-l">companies tracked</span>
      <span class="wl-tally" aria-hidden="true">
        {wlTally.map((group) => (
          <span class="wl-tg">{group.map((b) => <i style={`animation-delay:${b.d}s`}></i>)}</span>
        ))}
      </span>
      <span class="wl-cue" aria-hidden="true">Explore companies →</span>
    </button>
    {tiles.map((t) => (
      <div class="bg-card px-5 py-6">
        <p class="font-serif text-3xl md:text-4xl text-ink">{t.n}</p>
        <p class="font-mono text-[11.5px] uppercase tracking-[0.05em] text-ink/60 mt-1.5">{t.label}</p>
      </div>
    ))}
  </div>

  <WatchlistTree />

  <!-- coverage bar -->
  <div class="mt-12">
    <p class="font-mono text-[12px] uppercase tracking-[0.06em] text-ink/65 mb-3">Watchlist coverage · {watchlistTotal} companies across 6 sectors</p>
    <div class="flex h-4 w-full rounded-full overflow-hidden border border-rule">
      {sectors.map((s) => (
        <div style={`width:${s.pct}%;background-color:${s.color}`} title={`${s.label}: ${s.count}`}></div>
      ))}
    </div>
    <ul class="flex flex-wrap gap-x-5 gap-y-2.5 mt-5">
      {sectors.map((s) => (
        <li class="flex items-center gap-2 font-mono text-[12.5px]">
          <span class="h-3 w-3 rounded" style={`background-color:${s.color}`}></span>
          <span class="text-ink/90 font-medium">{s.label}</span>
          <span class="text-ink/50">{s.count}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
