---
const loop = ['Watch the watchlist', 'Catch the signal', 'Score the intent', 'Draft the angle', 'Human review', 'Publish'];
const principles = [
  'Every call linked to a source',
  'Human on the loop, not in it',
  'Scored, not vibes',
  'Retargetable to any market',
];
---
<section id="how" class="py-24 border-b border-rule scroll-mt-20">
  <h2 class="font-serif text-4xl md:text-5xl leading-[1.06] max-w-[640px]">The loop, end to end.</h2>

  <!-- the loop -->
  <div class="flex flex-wrap items-center gap-x-2 gap-y-3 mt-8">
    {loop.map((step, i) => (
      <>
        {i > 0 && <span class="text-accent/50 font-mono text-lg" aria-hidden="true">→</span>}
        <span class="chip chip-mono">{step}</span>
      </>
    ))}
  </div>

  <p class="text-lg text-ink/75 leading-relaxed mt-8 max-w-[680px]">
    AI does the scanning and first-draft scoring; I make the judgment calls and edit
    every briefing. The rendering is a small Python script — the real product is the workflow.
  </p>

  <!-- principles -->
  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-8 max-w-[680px]">
    {principles.map((p) => (
      <li class="flex items-start gap-3 border-l-2 border-accent pl-4 py-1.5">
        <span class="text-[16px] text-ink/90">{p}</span>
      </li>
    ))}
  </ul>
</section>
