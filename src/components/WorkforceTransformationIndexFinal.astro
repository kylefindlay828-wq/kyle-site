    /* sources footer — where the data comes from */
    .wti-p-sources { margin-top: 26px; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 20px; }
    .wti-src-note { font-size: 13px; line-height: 1.55; color: #c6cdd6; margin: 0 0 12px; }
