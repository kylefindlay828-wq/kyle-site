---
// Workforce Transformation Index (/proofworks).
// Single work-cluster view. x = workflow urgency, y = development value,
// r = modeled commercial opportunity. Color = market status (4 categories).
// Clicking a bubble opens a workforce-decision panel. Industry filtering is a
// compact secondary control that highlights the relevant clusters.
import { clusters, notes, CROWD, PRIORITY_LABEL } from '../data/workforce-index-final.ts';
import { industries } from '../data/industry-filters.ts';

const VB = { w: 1000, h: 600 };
const M = { l: 96, r: 70, t: 96, b: 58 };
const P = { x0: M.l, x1: VB.w - M.r, y0: M.t, y1: VB.h - M.b };
const D = { xmin: 3, xmax: 10, ymin: 2, ymax: 10 };
const px = (x: number) => P.x0 + ((x - D.xmin) / (D.xmax - D.xmin)) * (P.x1 - P.x0);
const py = (y: number) => P.y1 - ((y - D.ymin) / (D.ymax - D.ymin)) * (P.y1 - P.y0);
const qx = +px(7).toFixed(1), qy = +py(7).toFixed(1);

const bset = clusters.map((c) => ({ ...c, color: CROWD[c.crowding].c, cx: +px(c.x).toFixed(1), cy: +py(c.y).toFixed(1), rr: +(c.r * 0.92).toFixed(1) }));

const pri = bset.filter((b) => b.priority);
const pz = {
  cx: +(((Math.min(...pri.map((b) => b.cx - b.rr)) + Math.max(...pri.map((b) => b.cx + b.rr))) / 2)).toFixed(1),
  cy: +(((Math.min(...pri.map((b) => b.cy - b.rr)) + Math.max(...pri.map((b) => b.cy + b.rr))) / 2)).toFixed(1),
  rx: +(((Math.max(...pri.map((b) => b.cx + b.rr)) - Math.min(...pri.map((b) => b.cx - b.rr))) / 2 + 20)).toFixed(1),
  ry: +(((Math.max(...pri.map((b) => b.cy + b.rr)) - Math.min(...pri.map((b) => b.cy - b.rr))) / 2 + 18)).toFixed(1),
};
const zoneHeadY = P.y0 - 44, zoneSubY1 = P.y0 - 28, zoneSubY2 = P.y0 - 14;
const zoneHeadX = +Math.min(pz.cx, P.x1 - 100).toFixed(1);

type Rect = { x: number; y: number; w: number; h: number };
const TH = 15;
function textRect(x: number, y: number, text: string, anchor: 'start' | 'end' | 'middle', cw = 7): Rect {
  const w = text.length * cw;
  const x0 = anchor === 'start' ? x : anchor === 'end' ? x - w : x - w / 2;
  return { x: x0 - 3, y: y - TH + 2, w: w + 6, h: TH + 4 };
}
const QUAD = { tl: 'DEVELOP SELECTIVELY', tr: 'BUILD BEFORE REPLACING', bl: "WATCH, DON'T LEAD", br: 'AUTOMATE OR REDESIGN' };
const quadPos = {
  tl: { x: P.x0 + 10, y: P.y0 + 18, a: 'start' as const },
  tr: { x: P.x1 - 10, y: P.y0 + 18, a: 'end' as const },
  bl: { x: P.x0 + 10, y: P.y1 - 30, a: 'start' as const },
  br: { x: P.x1 - 10, y: P.y1 - 30, a: 'end' as const },
};
const reserved: Rect[] = [
  textRect(quadPos.tl.x, quadPos.tl.y, QUAD.tl, 'start', 8),
  textRect(quadPos.tr.x, quadPos.tr.y, QUAD.tr, 'end', 8),
  textRect(quadPos.bl.x, quadPos.bl.y, QUAD.bl, 'start', 8),
  textRect(quadPos.br.x, quadPos.br.y, QUAD.br, 'end', 8),
  textRect(P.x0 + 2, P.y1 - 8, 'Lower urgency', 'start'),
  textRect(P.x1 - 2, P.y1 - 8, 'Higher urgency →', 'end'),
  textRect(zoneHeadX, zoneHeadY, 'PROOFWORKS PRIORITY ZONE', 'middle', 8),
  textRect(zoneHeadX, zoneSubY1, 'Urgent workflows • valuable domain knowledge', 'middle', 6),
  textRect(zoneHeadX, zoneSubY2, 'underserved implementation talent', 'middle', 6),
];

const VEC: Record<string, [number, number]> = {
  E: [1, 0], W: [-1, 0], N: [0, -1], S: [0, 1], NE: [.82, -.57], NW: [-.82, -.57], SE: [.82, .57], SW: [-.82, .57],
};
const CHARW = 6.9, LH = 16, PAD = 3;
const bnd = { x0: 6, y0: 6, x1: VB.w - 6, y1: VB.h - 6 };
const DIRS_ALL = ['E', 'W', 'N', 'S', 'NE', 'NW', 'SE', 'SW'];
const LEADS = [16, 26, 38, 52, 68, 86, 108, 132];
function candidate(cx: number, cy: number, rr: number, dir: string, lead: number, text: string) {
  const [ux, uy] = VEC[dir];
  const ax = cx + ux * (rr + lead), ay = cy + uy * (rr + lead);
  const w = text.length * CHARW;
  const anchor = ux > 0.25 ? 'start' : ux < -0.25 ? 'end' : 'middle';
  const x0 = anchor === 'start' ? ax : anchor === 'end' ? ax - w : ax - w / 2;
  const rect: Rect = { x: x0 - PAD, y: ay - LH / 2 - PAD, w: w + 2 * PAD, h: LH + 2 * PAD };
  return { ax, ay, anchor, rect, ex: cx + ux * rr, ey: cy + uy * rr };
}
const inBounds = (r: Rect) => r.x >= bnd.x0 && r.y >= bnd.y0 && r.x + r.w <= bnd.x1 && r.y + r.h <= bnd.y1;
const overlap = (a: Rect, b: Rect) => a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
function hitsBubble(r: Rect, selfId: string) {
  for (const b of bset) {
    if (b.id === selfId) continue;
    const nx = Math.max(r.x, Math.min(b.cx, r.x + r.w));
    const ny = Math.max(r.y, Math.min(b.cy, r.y + r.h));
    if (Math.hypot(b.cx - nx, b.cy - ny) < b.rr + 2) return true;
  }
  return false;
}
const crowd = (c: typeof bset[number]) =>
  bset.reduce((n, o) => n + (o.id !== c.id && Math.hypot(o.cx - c.cx, o.cy - c.cy) < 150 ? 1 : 0), 0);
const order = [...bset].sort((a, b) => crowd(b) - crowd(a));
const placed: Rect[] = [...reserved];
const posById: Record<string, ReturnType<typeof candidate>> = {};
for (const c of order) {
  const tries = [c.dir, ...DIRS_ALL.filter((d) => d !== c.dir)];
  let chosen: ReturnType<typeof candidate> | null = null;
  for (const lead of LEADS) {
    for (const dir of tries) {
      const cand = candidate(c.cx, c.cy, c.rr, dir, lead, c.label);
      if (!inBounds(cand.rect) || hitsBubble(cand.rect, c.id) || placed.some((r) => overlap(r, cand.rect))) continue;
      chosen = cand; break;
    }
    if (chosen) break;
  }
  if (!chosen) chosen = candidate(c.cx, c.cy, c.rr, c.dir, 40, c.label);
  placed.push(chosen.rect);
  posById[c.id] = chosen;
}
const bubbles = bset.map((c) => {
  const ch = posById[c.id];
  const showLead = Math.hypot(ch.ax - ch.ex, ch.ay - ch.ey) > 6;
  return { ...c, ...ch, showLead };
});
const legend = (['underserved', 'emerging', 'crowded', 'low-fit'] as const).map((k) => ({ ...CROWD[k], key: k }));
---
<section class="wti" id="index" aria-label="The Workforce Transformation Index">
  <div class="wti-col">
    <div class="wti-filterbar" data-reveal>
      <p class="wti-hint">Click a cluster for its workforce-decision detail.</p>
      <details class="wti-filter">
        <summary>Filter by industry</summary>
        <div class="wti-filter-menu">
          <button class="wti-fitem is-on" data-ind="all" type="button">All clusters</button>
          {industries.map((i) => (<button class="wti-fitem" data-ind={i.id} type="button">{i.label}</button>))}
        </div>
      </details>
    </div>

    <div class="wti-board" data-reveal>
      <p class="wti-ycap"><span class="wti-ax-ar">↑</span> How much value comes from developing the people doing the work</p>
      <div class="wti-chartwrap">
        <svg class="wti-svg" viewBox={`0 0 ${VB.w} ${VB.h}`} role="group" aria-label="Bubble chart of work clusters by workflow urgency and development value" preserveAspectRatio="xMidYMid meet">
          <rect x={P.x0} y={P.y0} width={P.x1 - P.x0} height={P.y1 - P.y0} fill="none" stroke="rgba(20,24,30,0.14)" />
          <line x1={qx} y1={P.y0} x2={qx} y2={P.y1} class="wti-div" />
          <line x1={P.x0} y1={qy} x2={P.x1} y2={qy} class="wti-div" />

          <text x={quadPos.tl.x} y={quadPos.tl.y} class="wti-quad">{QUAD.tl}</text>
          <text x={quadPos.tr.x} y={quadPos.tr.y} class="wti-quad wti-quad-build" text-anchor="end">{QUAD.tr}</text>
          <text x={quadPos.bl.x} y={quadPos.bl.y} class="wti-quad">{QUAD.bl}</text>
          <text x={quadPos.br.x} y={quadPos.br.y} class="wti-quad" text-anchor="end" fill="#c0603f">{QUAD.br}</text>

          <text x={P.x0 + 2} y={P.y1 - 8} text-anchor="start" class="wti-axis-end">Lower urgency</text>
          <text x={P.x1 - 2} y={P.y1 - 8} text-anchor="end" class="wti-axis-end">Higher urgency →</text>
          <text transform={`rotate(-90 20 ${P.y0 + 96})`} x="20" y={P.y0 + 96} text-anchor="middle" class="wti-axis-end">Higher value ↑</text>
          <text transform={`rotate(-90 20 ${P.y1 - 96})`} x="20" y={P.y1 - 96} text-anchor="middle" class="wti-axis-end">Lower value</text>

          <ellipse cx={pz.cx} cy={pz.cy} rx={pz.rx} ry={pz.ry} class="wti-zone" />
          <line x1={zoneHeadX} y1={zoneSubY2 + 5} x2={pz.cx} y2={+(pz.cy - pz.ry).toFixed(1)} class="wti-zone-tie" />
          <text x={zoneHeadX} y={zoneHeadY} text-anchor="middle" class="wti-zone-lbl">PROOFWORKS PRIORITY ZONE</text>
          <text x={zoneHeadX} y={zoneSubY1} text-anchor="middle" class="wti-zone-sub">Urgent workflows • valuable domain knowledge</text>
          <text x={zoneHeadX} y={zoneSubY2} text-anchor="middle" class="wti-zone-sub">underserved implementation talent</text>

          <g class="wti-leads">
            {bubbles.filter((b) => b.showLead).map((b) => (
              <line x1={+b.ex.toFixed(1)} y1={+b.ey.toFixed(1)} x2={+b.ax.toFixed(1)} y2={+b.ay.toFixed(1)} class="wti-lead" />
            ))}
          </g>
          <g class="wti-bubbles">
            {bubbles.map((b) => (
              <g class="wti-b" data-id={b.id} tabindex="0" role="button"
                 aria-label={`${b.label}. ${CROWD[b.crowding].label}. Press Enter for detail.`} style={`--c:${b.color}`}>
                <circle cx={b.cx} cy={b.cy} r={b.rr} class="wti-dot" />
                <text x={+b.ax.toFixed(1)} y={+b.ay.toFixed(1)} text-anchor={b.anchor} dominant-baseline="central" class="wti-lbl">{b.label}</text>
                <circle cx={b.cx} cy={b.cy} r={b.rr} class="wti-hit" fill="transparent" />
              </g>
            ))}
          </g>
        </svg>
        <div class="wti-tip" role="status" aria-live="polite" hidden></div>
      </div>
      <p class="wti-xcap"><span class="wti-ax-ar">→</span> How urgently the workflow needs to change</p>

      <div class="wti-legend">
        <div class="wti-leg-group" aria-label="Color legend — market status">
          <span class="wti-leg-t">Color · market status</span>
          {legend.map((l) => (<span class="wti-leg-i"><i class="wti-sw" style={`--c:${l.c}`}></i>{l.label}</span>))}
        </div>
        <div class="wti-leg-group">
          <span class="wti-leg-t">Size</span>
          <span class="wti-leg-i wti-leg-size" title={notes.bubbleSizeDetail}><i class="wti-sw-o"></i>Modeled commercial opportunity <b class="wti-info">?</b></span>
        </div>
      </div>
    </div>

    <p class="wti-note" data-reveal>{notes.methodologyStatus}</p>
  </div>

  <div class="wti-backdrop" hidden></div>
  <aside class="wti-panel" role="dialog" aria-modal="false" aria-labelledby="wti-panel-title" hidden tabindex="-1">
    <button class="wti-close" aria-label="Close details" type="button">✕</button>
    <div class="wti-panel-body"></div>
  </aside>

  <script type="application/json" id="wti-data" set:html={JSON.stringify(clusters)}></script>
  <script type="application/json" id="wti-ind" set:html={JSON.stringify(industries)}></script>
  <script type="application/json" id="wti-meta" set:html={JSON.stringify({ CROWD, PRIORITY_LABEL, spendModel: notes.spendModel, positionStatus: notes.positionStatus })}></script>

  <script>
    (() => {
      const root = document.querySelector('.wti'); if (!root) return;
      const CL = JSON.parse(root.querySelector('#wti-data').textContent || '[]');
      const IND = JSON.parse(root.querySelector('#wti-ind').textContent || '[]');
      const META = JSON.parse(root.querySelector('#wti-meta').textContent || '{}');
      const CROWD = META.CROWD, PRIORITY_LABEL = META.PRIORITY_LABEL;
      const byId = Object.fromEntries(CL.map((c) => [c.id, c]));
      const byInd = Object.fromEntries(IND.map((i) => [i.id, i]));
      const chartwrap = root.querySelector('.wti-chartwrap');
      const tip = root.querySelector('.wti-tip');
      const panel = root.querySelector('.wti-panel');
      const backdrop = root.querySelector('.wti-backdrop');
      const panelBody = root.querySelector('.wti-panel-body');
      const closeBtn = root.querySelector('.wti-close');
      const bubbles = [...root.querySelectorAll('.wti-b')];
      const fitems = [...root.querySelectorAll('.wti-fitem')];
      const filterEl = root.querySelector('.wti-filter');
      let lastFocus = null, activeInd = 'all', panelKind = null;

      const esc = (s) => String(s);
      const RANK = { Low: 1, Small: 1, Medium: 2, High: 3, Large: 3 };
      const pill = (v) => `<span class="wti-pill r${RANK[v] || 2}">${v}</span>`;
      const li = (a) => (a || []).map((t) => `<li>${t}</li>`).join('');
      const block = (t, sub, a) => a && a.length ? `<div class="wti-p-block"><p class="wti-p-lbl">${t}</p>${sub ? `<p class="wti-p-subl">${sub}</p>` : ''}<ul>${li(a)}</ul></div>` : '';

      function showTip(el) {
        const c = byId[el.dataset.id]; if (!c) return;
        tip.innerHTML =
          `<div class="wti-tip-name">${c.label}</div>` +
          `<div class="wti-tip-row"><span>Market</span><b style="color:${CROWD[c.crowding].c}">${CROWD[c.crowding].status}</b></div>` +
          `<div class="wti-tip-row"><span>Priority</span><b>${PRIORITY_LABEL[c.priorityStatus]}</b></div>` +
          `<div class="wti-tip-row"><span>Opportunity</span><b>${c.decision.commercialOpportunity}</b></div>`;
        const cr = el.querySelector('.wti-dot').getBoundingClientRect();
        const wr = chartwrap.getBoundingClientRect();
        tip.hidden = false;
        const tw = tip.offsetWidth, th = tip.offsetHeight;
        let left = Math.max(4, Math.min(cr.left - wr.left + cr.width / 2 - tw / 2, wr.width - tw - 4));
        let top = cr.top - wr.top - th - 12; if (top < 0) top = cr.top - wr.top + cr.height + 12;
        tip.style.left = left + 'px'; tip.style.top = top + 'px';
      }
      const hideTip = () => { tip.hidden = true; };
      const hoverOn = (el) => { if (!el.classList.contains('faded')) { bubbles.forEach((b) => b.classList.toggle('hl', b === el)); showTip(el); } };
      const hoverOff = () => { bubbles.forEach((b) => b.classList.remove('hl')); hideTip(); };

      function decisionGrid(d) {
        const rows = [
          ['Internal development', d.internalDevelopment], ['Role evolution', d.roleEvolution],
          ['Task automation', d.taskAutomation], ['External hiring demand', d.externalHiring],
          ['Displacement pressure', d.displacement], ['Commercial opportunity', d.commercialOpportunity],
          ['Evidence confidence', d.evidenceConfidence],
        ].map(([k, v]) => `<div class="wti-dec-row"><span>${k}</span>${pill(v)}</div>`).join('');
        return `<div class="wti-p-block"><p class="wti-p-lbl">Decision summary</p><div class="wti-dec">${rows}</div></div>`;
      }
      function whyHere(w) {
        const row = (k, v) => `<div class="wti-why-row"><span class="wti-why-k">${k}</span><p>${v}</p></div>`;
        return `<div class="wti-p-block"><p class="wti-p-lbl">Why it sits here</p>` +
          row('Workflow urgency', w.urgency) + row('Development value', w.developmentValue) +
          row('Market crowding', w.crowding) + row('Proofworks fit', w.fit) + `</div>`;
      }
      function evidenceSplit(c) {
        const sourced = ['BLS employment & wage (illustrative occupation)', 'O*NET tasks & work activities', 'Theoretical AI task exposure (Eloundou)', c.sourced.usage ? 'Observed AI usage (Anthropic Economic Index)' : null].filter(Boolean);
        const modeled = ['Development value', 'Employer urgency', 'Market crowding', 'Proofworks fit', 'External hiring demand', 'Commercial opportunity', 'Exact bubble coordinates', 'Bubble size'];
        return `<div class="wti-p-block"><p class="wti-p-lbl">Evidence</p>` +
          `<p class="wti-p-subl">Sourced indicators</p><ul class="wti-ev wti-ev-src">${li(sourced)}</ul>` +
          `<p class="wti-p-subl">Modeled Proofworks judgments</p><ul class="wti-ev wti-ev-mod">${li(modeled)}</ul>` +
          `<div class="wti-pos">Position status: <b>${META.positionStatus}</b></div></div>`;
      }
      function sourcedBlock(s) {
        const row = (k, v) => `<div class="wti-m-row"><span class="wti-m-k">${k}</span><span class="wti-m-v">${v}</span></div>`;
        return `<div class="wti-p-block"><p class="wti-p-lbl">Sourced indicators</p>` +
          `<p class="wti-p-subl">Illustrative occupation — this cluster spans several occupations; the figure below is not the cluster’s total size.</p>` +
          `<div class="wti-m-name">${s.occupationLabel} <span class="wti-soc">${s.occupationCode}</span></div>` +
          row(`National employment · ${s.employmentYear}`, s.employment) +
          row(`Median annual wage · ${s.wageYear}`, s.wage) +
          row('Theoretical AI task exposure', s.exposure) +
          (s.usage ? row('Observed AI usage', s.usage) : '') + `</div>`;
      }
      function commercialBlock(c) {
        const cm = c.commercial; const row = (k, v) => `<div class="wti-dec-row"><span>${k}</span>${pill(v)}</div>`;
        return `<div class="wti-p-block"><p class="wti-p-lbl">Commercial opportunity <b class="wti-info" title="${esc(META.spendModel)}">?</b></p><div class="wti-dec">` +
          row('Addressable workforce', cm.addressableWorkforce) + row('Employer urgency', cm.employerUrgency) +
          row('Employer spending capacity', cm.spendingCapacity) + row('Repeatability', cm.repeatability) +
          `<div class="wti-dec-row"><span>Market crowding</span><span class="wti-pill" style="background:${CROWD[cm.crowding].c}22;color:${CROWD[cm.crowding].c};border-color:${CROWD[cm.crowding].c}55">${CROWD[cm.crowding].status}</span></div>` +
          row('Modeled employer-spend opportunity', cm.modeledSpend) +
          `</div><p class="wti-p-foot">${esc(META.spendModel)}</p></div>`;
      }
      function sourcesBlock(s) {
        if (!s || !s.length) return '';
        const rows = s.map((x) => `<a class="wti-src-row" href="${x.url}" target="_blank" rel="noopener"><span class="wti-src-nm">${x.name}<em>${x.year}</em></span><span class="wti-src-sup">${x.supports} ↗</span></a>`).join('');
        return `<div class="wti-p-block"><p class="wti-p-lbl">Sources</p><div class="wti-src">${rows}</div></div>`;
      }

      function openCluster(id, focusEl) {
        const c = byId[id]; if (!c) return; lastFocus = focusEl || lastFocus; panelKind = 'cluster';
        let ex = '';
        if (c.marketExamples) ex = `<div class="wti-p-block"><p class="wti-p-lbl">Market examples</p><ul>${li(c.marketExamples)}</ul>${c.marketExamplesNote ? `<p class="wti-p-foot">${c.marketExamplesNote}</p>` : ''}</div>`;
        panelBody.innerHTML =
          `<div class="wti-p-head">` +
            `<h3 id="wti-panel-title">${c.label}</h3>` +
            `<div class="wti-p-status"><span class="wti-badge" style="--c:${CROWD[c.crowding].c}">${CROWD[c.crowding].label}</span>` +
            `<span class="wti-badge wti-badge-pri ps-${c.priorityStatus}">${PRIORITY_LABEL[c.priorityStatus]}</span></div>` +
            `<p class="wti-p-sum">${c.summary}</p>` +
          `</div>` +
          decisionGrid(c.decision) +
          block('Develop internally', 'People whose context is valuable and can be developed', c.outcomes.develop) +
          block('Redeploy or evolve', 'Movement into adjacent, higher-value work', c.outcomes.redeploy) +
          block('Automate or compress', 'Tasks likely to shrink or be substantially automated', c.outcomes.automate) +
          block('Hire externally', 'Capabilities unlikely to be built fast enough internally', c.outcomes.hire) +
          whyHere(c.whyHere) +
          commercialBlock(c) +
          sourcedBlock(c.sourced) +
          evidenceSplit(c) +
          ex +
          sourcesBlock(c.sources) +
          `<p class="wti-p-close">Proofworks develops the valuable people, redesigns the changing work, and identifies the capability that must be hired from outside.</p>`;
        showPanel(); setSelected(id);
      }

      function openIndustry(id, focusEl) {
        const ind = byInd[id]; if (!ind) return; lastFocus = focusEl || lastFocus; panelKind = 'industry';
        const rel = ind.clusterIds.map((cid) => byId[cid]).filter(Boolean);
        const rolePool = [...new Set(rel.flatMap((c) => c.outcomes.develop || []))].slice(0, 12);
        const rows = rel.map((c) => `<button class="wti-cl-row" data-open="${c.id}"><span class="wti-sw" style="--c:${CROWD[c.crowding].c}"></span>${c.label}<span class="wti-cl-arr">→</span></button>`).join('');
        panelBody.innerHTML =
          `<div class="wti-p-head"><h3 id="wti-panel-title">${ind.label}</h3>` +
          `<div class="wti-p-status"><span class="wti-badge" style="--c:#4c9dff">Industry filter</span></div>` +
          `<p class="wti-p-sum">${ind.summary}</p></div>` +
          `<div class="wti-p-block"><p class="wti-p-lbl">Relevant work clusters</p><div class="wti-cl-list">${rows}</div></div>` +
          block('Representative roles', '', rolePool) +
          block('Why these workflows are changing', '', ind.why) +
          block('Where internal development is plausible', '', ind.internal) +
          block('Where outside hiring may be required', '', ind.external) +
          `<p class="wti-p-foot">Industries aren’t single points — they draw on several clusters. Tap a cluster for its decision detail and sources.</p>`;
        showPanel();
        panelBody.querySelectorAll('.wti-cl-row').forEach((b) => b.addEventListener('click', () => openCluster(b.dataset.open)));
      }

      function showPanel() {
        panel.hidden = false; backdrop.hidden = false;
        requestAnimationFrame(() => { panel.classList.add('open'); backdrop.classList.add('open'); });
        panel.scrollTop = 0; panel.focus();
      }
      function closePanel() {
        panel.classList.remove('open'); backdrop.classList.remove('open');
        setTimeout(() => { panel.hidden = true; backdrop.hidden = true; }, 260);
        clearSelected(); panelKind = null;
        if (lastFocus) lastFocus.focus();
      }
      const setSelected = (id) => bubbles.forEach((b) => b.classList.toggle('selected', b.dataset.id === id));
      const clearSelected = () => bubbles.forEach((b) => b.classList.remove('selected'));

      function applyIndustry(id) {
        activeInd = id;
        fitems.forEach((f) => f.classList.toggle('is-on', f.dataset.ind === id));
        if (id === 'all') { bubbles.forEach((b) => b.classList.remove('faded', 'rel')); return; }
        const set = new Set((byInd[id]?.clusterIds) || []);
        bubbles.forEach((b) => { const on = set.has(b.dataset.id); b.classList.toggle('rel', on); b.classList.toggle('faded', !on); });
      }
      fitems.forEach((f) => f.addEventListener('click', () => {
        const id = f.dataset.ind; if (filterEl) filterEl.open = false;
        if (id === 'all') { applyIndustry('all'); if (panelKind === 'industry') closePanel(); return; }
        applyIndustry(id); openIndustry(id, f);
      }));

      bubbles.forEach((el) => {
        el.addEventListener('mouseenter', () => hoverOn(el));
        el.addEventListener('mouseleave', hoverOff);
        el.addEventListener('focus', () => hoverOn(el));
        el.addEventListener('blur', hoverOff);
        el.addEventListener('click', () => openCluster(el.dataset.id, el));
        el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCluster(el.dataset.id, el); } });
      });
      closeBtn.addEventListener('click', closePanel);
      backdrop.addEventListener('click', closePanel);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) closePanel(); });
    })();
