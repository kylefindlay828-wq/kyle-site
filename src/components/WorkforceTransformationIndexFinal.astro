      transition: border-color .18s ease, transform .15s ease, box-shadow .2s ease; }
    .wti-deep:hover { border-color: #2f6fd0; transform: translateY(-1px); box-shadow: 0 24px 50px -34px rgba(20,30,50,0.55); }
    .wti-deep:focus-visible { outline: 2px solid #1f5aa6; outline-offset: 3px; }
