    .wti-tip-row { display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; color: #a4aebb; margin: 4px 0; }
    .wti-tip-row b { color: #eef1f4; font-weight: 600; }
    .wti-tip-roles { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: #7f8894; margin-top: 8px; line-height: 1.5; }

    /* prominent "these are clickable" call-to-action */
    .wti-cta { display: flex; align-items: center; gap: 10px; font-family: 'Space Grotesk', sans-serif; font-weight: 600;
      font-size: clamp(13.5px, 1.5vw, 15.5px); letter-spacing: -0.005em; color: #1f5aa6; margin: 16px 2px 0; }
    .wti-cta-dot { width: 11px; height: 11px; border-radius: 50%; background: #4c9dff; flex-shrink: 0;
      box-shadow: 0 0 0 0 rgba(76,157,255,0.55); animation: wtiCtaPulse 2s ease-out infinite; }
    @keyframes wtiCtaPulse { 0% { box-shadow: 0 0 0 0 rgba(76,157,255,0.5); } 70% { box-shadow: 0 0 0 9px rgba(76,157,255,0); } 100% { box-shadow: 0 0 0 0 rgba(76,157,255,0); } }
    /* one-time staggered ripple across every bubble the moment the chart enters view,
