---
import { signals } from '../data/signals';
import SignalCard from './SignalCard.astro';
import SectionRubric from './SectionRubric.astro';
---
<section id="signals" class="py-16 scroll-mt-[var(--nav-h)]">
  <SectionRubric num="02" label="Signal examples" />
  <h2 class="font-serif text-3xl md:text-4xl mt-8 max-w-[640px]">Real signals, scored and turned into action.</h2>
  <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[680px]">
    Pulled from published editions. Each signal is classified, scored for near-term
    hiring, and translated into a specific GTM move — with the source attached.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
    {signals.map((signal) => <SignalCard signal={signal} />)}
  </div>

  <p class="font-mono text-[12.5px] text-ink/60 mt-6">
    Open any card for the analytical read, the roles it predicted, and the source edition.
  </p>
</section>
