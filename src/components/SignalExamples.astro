---
import { signals } from '../data/signals';
import SignalCard from './SignalCard.astro';
---
<section id="signals" class="py-16 scroll-mt-20">
  <h2 class="font-serif text-3xl md:text-4xl max-w-[640px]">Real signals, scored and turned into action.</h2>
  <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[680px]">
    Pulled from published editions. Each signal is classified, scored for near-term
    hiring, and translated into a specific GTM move — with the source attached.
  </p>

  <!-- sourcing credibility strip -->
  <div class="mt-7 border border-rule rounded-lg bg-card px-5 py-4 max-w-[680px]">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
      <span class="kicker">Sourcing</span>
      <span class="text-[13.5px] text-ink/75">Primary sources only — rumors are flagged, never scored as fact.</span>
    </div>
    <ul class="flex flex-wrap gap-2">
      <li class="chip chip-mono">Company newsrooms</li>
      <li class="chip chip-mono">BusinessWire</li>
      <li class="chip chip-mono">Official press releases</li>
      <li class="chip chip-mono">Trade press · flagged</li>
    </ul>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
    {signals.map((signal) => <SignalCard signal={signal} />)}
  </div>

  <p class="font-mono text-[12.5px] text-ink/60 mt-6">
    Open any card for the analytical read, the roles it predicted, and the source edition.
  </p>
</section>
