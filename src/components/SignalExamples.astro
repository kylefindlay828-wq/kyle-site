---
import { signals } from '../data/signals';
import SignalCard from './SignalCard.astro';
---
<section id="signals" class="py-16 scroll-mt-20">
  <h2 class="font-serif text-3xl md:text-4xl max-w-[640px]">Real signals, scored and turned into action.</h2>
  <p class="text-lg text-ink/75 leading-relaxed mt-5 max-w-[680px]">
    Pulled from published editions. Each signal is classified, scored for near-term
    hiring, and translated into a specific GTM move — with the source attached.
  </p>

  <!-- sourcing credibility strip -->
  <div class="mt-7 border border-rule rounded-lg bg-card px-6 py-5 max-w-[760px]">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-5">
      <span class="kicker">Sourcing</span>
      <span class="text-[13.5px] text-ink/75">Every signal traces to a primary source. Rumors are flagged, never scored as fact.</span>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-accent mb-2.5">Primary record</p>
        <ul class="flex flex-wrap gap-2">
          <li class="chip chip-mono">Company newsrooms &amp; blogs</li>
          <li class="chip chip-mono">Official press / BusinessWire</li>
          <li class="chip chip-mono">SEC / EDGAR filings</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-accent mb-2.5">Corroborating</p>
        <ul class="flex flex-wrap gap-2">
          <li class="chip chip-mono">Bloomberg · Reuters</li>
          <li class="chip chip-mono">TechCrunch · The Information</li>
        </ul>
      </div>
      <div>
        <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-muted mb-2.5">Flagged, not scored</p>
        <ul class="flex flex-wrap gap-2">
          <li class="chip chip-mono">Trade press — corroborated</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-10">
    {signals.map((signal) => <SignalCard signal={signal} />)}
  </div>

  <p class="font-mono text-[12.5px] text-ink/60 mt-6">
    Open any card for the analytical read, the roles it predicted, and the source edition.
  </p>
</section>
