---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';

const focusAreas = [
  'Marketplace growth and activation',
  'Go-to-market and pipeline development',
  'Strategic and product operations',
  'Customer implementation and delivery',
  'Recruiting and workforce infrastructure',
  'AI-enabled operational products',
];

const evidence = [
  { head: 'Complex program operations', body: 'Managed 20–30 concurrent national programs across more than 60,000 retail locations while directly owning a $3.1M+ annual portfolio.' },
  { head: 'High-stakes execution', body: 'Coordinated guests, partners, vendors, budgets, and changing logistics across international experiences and live events.' },
  { head: 'Built from ambiguity', body: 'Designed and shipped Proofworks and GTM Radar — working AI systems, including an autonomous market-intelligence agent — built end to end with Claude Code, no engineering team.' },
];

---
<!-- HERO -->
<section id="about" class="pt-16 md:pt-20 pb-16 scroll-mt-16">
  <div class="grid grid-cols-1 md:grid-cols-[1fr_280px] gap-10 md:gap-14 items-start">
    <div data-reveal class="max-w-[820px] space-y-6">
      <p class="font-mono uppercase tracking-[0.14em] text-accent" style="font-size:clamp(15px,1.1vw,16px);">Kyle Findlay</p>
      <h1 class="font-serif font-bold leading-[1.08]" style="font-size:clamp(1.9rem,3.5vw,3.1rem);">
        I want to build the systems behind how people work, adapt, and find opportunity.
      </h1>
      <p class="font-mono text-accent leading-relaxed" style="font-size:clamp(16px,1.4vw,20px);">
        Early-stage operations · Go-to-market · Marketplaces · Workforce infrastructure · AI-enabled products
      </p>
      <p class="font-mono text-accent/70 leading-relaxed" style="font-size:clamp(16px,1.4vw,20px);">
        Operator and AI systems builder · Open to roles, contracts, and founding conversations · San Francisco / California
      </p>
      <div class="space-y-4 text-ink/75 leading-relaxed max-w-[680px]" style="font-size:clamp(18px,1.4vw,21px);">
        <p>I'm an operator moving deeper into early-stage technology, marketplaces, and AI-enabled workforce systems.</p>
        <p>My background is in complex program delivery, live operations, stakeholder coordination, and turning ambiguous work into something people can actually run.</p>
      </div>
    </div>
    <div data-reveal class="flex flex-col gap-4 w-[220px] md:w-[280px] items-start md:justify-self-end">
      <div class="rounded-xl overflow-hidden border border-rule w-full h-[290px] md:h-[350px]">
        <Image src={headshot} alt="Kyle Findlay" width={600} height={750} class="w-full h-full object-cover object-top scale-[1.35] origin-top -translate-y-[12%]" />
      </div>
      <div class="flex flex-col gap-2 items-start">
        <a href="https://www.linkedin.com/in/kylefindlay828" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-serif text-accent hover:underline underline-offset-2" style="font-size:clamp(14px,1vw,15px);">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
          linkedin.com/in/kylefindlay828
        </a>
        <div class="flex items-center gap-1.5 font-serif text-accent" style="font-size:clamp(14px,1vw,15px);">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span class="select-all">kylefindlay828@gmail.com</span>
          <button type="button" class="email-copy inline-flex items-center justify-center rounded-md p-1 -my-1 text-accent/75 hover:text-accent hover:bg-accent/10 transition" data-email="kylefindlay828@gmail.com" aria-label="Copy email address">
            <svg class="ec-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="ec-done hidden" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
          <span class="ec-toast hidden text-xs text-accent/80">Copied!</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DIRECTION -->
<section data-reveal class="py-16 border-t border-rule scroll-mt-16">
  <h2 class="font-serif font-bold leading-[1.1] max-w-[860px]" style="font-size:clamp(2rem,4vw,3.75rem);">
    Put me where the playbook is still being written.
  </h2>
  <div class="mt-7 space-y-5 text-ink/75 leading-relaxed max-w-[720px]" style="font-size:clamp(18px,1.4vw,21px);">
    <p>I'm most useful close to the operating problem — customers, data, product — at companies rethinking how people are evaluated, matched with work, and made more capable. Not several layers removed from the outcome.</p>
  </div>
  <ul class="mt-10 flex flex-col gap-3 max-w-[760px]">
    {focusAreas.map((f) => (
      <li class="flex items-baseline gap-3 border-l-2 border-accent pl-4 text-ink/85" style="font-size:clamp(18px,1.5vw,22px);">
        <span>{f}</span>
      </li>
    ))}
  </ul>
</section>

<!-- THREE WAYS -->
<section data-reveal class="py-16 border-t border-rule scroll-mt-16">
  <h2 class="font-serif font-bold leading-[1.1] max-w-[860px]" style="font-size:clamp(2rem,4vw,3.75rem);">
    Three ways this goes.
  </h2>
  <div class="mt-9 grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-8 max-w-[980px]">
    <div class="border-l-2 border-accent pl-5">
      <h3 class="font-serif font-semibold leading-snug" style="font-size:clamp(1.5rem,2vw,1.75rem);">Operator seat</h3>
      <p class="text-ink/80 leading-relaxed mt-3" style="font-size:clamp(17px,1.2vw,19px);">GTM, RevOps, or implementation at an AI-native company — SDR-to-systems path included. I build pipeline and the machine behind it.</p>
    </div>
    <div class="border-l-2 border-accent pl-5">
      <h3 class="font-serif font-semibold leading-snug" style="font-size:clamp(1.5rem,2vw,1.75rem);">Talent &amp; market intelligence</h3>
      <p class="text-ink/80 leading-relaxed mt-3" style="font-size:clamp(17px,1.2vw,19px);">Recruiting and talent firms: placements, candidate-market research, and maps like the <a href="/gtm-migration" class="underline decoration-accent underline-offset-2 hover:text-accent transition">GTM Migration page</a> — run for your desk, your clients, your categories.</p>
    </div>
    <div class="border-l-2 border-accent pl-5">
      <h3 class="font-serif font-semibold leading-snug" style="font-size:clamp(1.5rem,2vw,1.75rem);">Early-stage building</h3>
      <p class="text-ink/80 leading-relaxed mt-3" style="font-size:clamp(17px,1.2vw,19px);">Workforce infrastructure from zero. <a href="/proofworks" class="underline decoration-accent underline-offset-2 hover:text-accent transition">Proofworks</a> is the working example.</p>
    </div>
  </div>
</section>

<!-- EVIDENCE -->
<section data-reveal class="py-16 border-t border-rule scroll-mt-16">
  <h2 class="font-serif font-bold leading-[1.1] mb-10" style="font-size:clamp(2rem,4vw,3.75rem);">
    What I have already proven
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10">
    {evidence.map((e) => (
      <div class="border-l-2 border-accent pl-5">
        <h3 class="font-serif font-semibold leading-snug" style="font-size:clamp(1.5rem,2vw,1.75rem);">{e.head}</h3>
        <p class="text-ink/70 leading-relaxed mt-3" style="font-size:clamp(17px,1.2vw,19px);">{e.body}</p>
      </div>
    ))}
  </div>
</section>

<!-- SELECTED WORK -->
<section id="work" data-reveal class="py-16 border-t border-rule scroll-mt-16">
  <p class="font-mono uppercase tracking-[0.12em] text-accent mb-10" style="font-size:clamp(15px,1vw,16px);">Selected work</p>
  <div class="flex flex-col gap-14">
    <article class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-start max-w-[900px]">
      <div>
        <h3 class="font-serif font-bold leading-[1.14]" style="font-size:clamp(1.75rem,3vw,2.375rem);">
          Proofworks
        </h3>
        <p class="text-ink/70 leading-relaxed mt-4 max-w-[680px]" style="font-size:clamp(18px,1.4vw,21px);">
          A capability layer for a changing job market. Interactive workforce index built on BLS data, plus the placement engine behind it.
        </p>
      </div>
      <a href="/proofworks" class="cta-pill inline-flex items-center gap-2 px-5 py-3 bg-accent font-mono font-semibold rounded-full hover:opacity-90 transition whitespace-nowrap md:justify-self-end" style="font-size:clamp(13px,1vw,14px);">
        View Proofworks <span aria-hidden="true">→</span>
      </a>
    </article>

    <article class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-6 md:gap-10 items-start max-w-[900px]">
      <div>
        <h3 class="font-serif font-bold leading-[1.14]" style="font-size:clamp(1.75rem,3vw,2.375rem);">
          GTM Migration
        </h3>
        <p class="text-ink/70 leading-relaxed mt-4 max-w-[680px]" style="font-size:clamp(18px,1.4vw,21px);">
          Where GTM work is going — a sourced, graded, three-wave map. Federal, university, and industry data · updated July 2026.
        </p>
      </div>
      <a href="/gtm-migration" class="cta-pill inline-flex items-center gap-2 px-5 py-3 bg-accent font-mono font-semibold rounded-full hover:opacity-90 transition whitespace-nowrap md:justify-self-end" style="font-size:clamp(13px,1vw,14px);">
        View GTM Migration <span aria-hidden="true">→</span>
      </a>
    </article>
  </div>
</section>

<!-- BEST-FIT -->
<section data-reveal class="py-16 border-t border-rule scroll-mt-16">
  <p class="text-ink/70 leading-relaxed max-w-[680px]" style="font-size:clamp(18px,1.4vw,21px);">
    Especially interested in ambitious, in-person teams building new categories in San Francisco.
  </p>
</section>

<span class="sr-only" aria-live="polite" data-copy-live></span>

<script>
  document.querySelectorAll('.email-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email; ta.setAttribute('readonly', '');
        ta.style.position = 'absolute'; ta.style.left = '-9999px';
        document.body.appendChild(ta); ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        ta.remove();
      }
      const copy = btn.querySelector('.ec-copy');
      const done = btn.querySelector('.ec-done');
      const toast = btn.parentElement?.querySelector('.ec-toast');
      const live = document.querySelector('[data-copy-live]');
      copy?.classList.add('hidden');
      done?.classList.remove('hidden');
      toast?.classList.remove('hidden');
      if (live) live.textContent = 'Email address copied to clipboard';
      window.clearTimeout(btn._t);
      btn._t = window.setTimeout(() => {
        copy?.classList.remove('hidden');
        done?.classList.add('hidden');
        toast?.classList.add('hidden');
      }, 1600);
    });
  });
</script>
