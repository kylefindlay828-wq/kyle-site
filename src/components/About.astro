---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';

const brings = [
  { head: '$3.1M+ directly owned annually', support: 'Supported a broader $5–6M portfolio across national brand programs — Beyond Meat, Hormel, FIJI, POM, GoodRx, Green Dot, Sapporo.' },
  { head: 'Builds AI-assisted workflows', support: 'Uses automation, structured outputs, and human review to move from concept to reliable execution.' },
  { head: 'Translator between builders and revenue', support: 'Gets good ideas heard by leadership — and shipped.' },
  { head: 'Designs the process, not just the interface', support: 'Owns the quality controls and human review across delivery, not only the demo.' },
];
const fits = [
  { label: 'Focus', body: 'AI delivery operations · Human-data operations · Implementation & workflow design · Cross-functional program execution.' },
  { label: 'Engagement', body: 'Full-time or contract, wherever the brief is still being written — pre-seed to Series C, AI-native or AI-adopting.' },
  { label: 'Background', body: 'Seven years of end-to-end execution on high-stakes programs: $3.1M+ directly owned within a $5–6M portfolio of national brand programs and live events at scale.' },
];
---
<section id="about" class="py-20 border-t border-b border-rule scroll-mt-20">
  <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 md:gap-10 items-start">
    <div class="flex flex-col gap-3 w-[220px] md:w-[280px] items-start">
      <div class="rounded-xl overflow-hidden border border-rule w-full h-[290px] md:h-[360px]">
        <Image src={headshot} alt="Kyle Findlay" width={600} height={750} class="w-full h-full object-cover object-top scale-[1.35] origin-top -translate-y-[12%]" />
      </div>
      <button id="copy-email" type="button" data-email="kylefindlay828@gmail.com" aria-label="Copy email address" class="cta-pill inline-flex items-center gap-2 px-4 py-2.5 bg-accent text-[12px] font-mono font-semibold rounded-full hover:opacity-90 transition cursor-pointer mt-1">
        <span class="ce-text">kylefindlay828@gmail.com</span>
        <span aria-hidden="true">⧉</span>
      </button>
      <a href="https://linkedin.com/in/kylefindlay828" target="_blank" rel="noopener" class="text-[14px] text-ink/70 hover:text-accent underline decoration-rule underline-offset-2 transition">
        LinkedIn ↗
      </a>
    </div>
    <div class="max-w-[760px] space-y-5">
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-accent">AI delivery operations · Workforce systems · Applied research</p>
      <h1 class="font-serif font-bold text-3xl md:text-[2.6rem] leading-tight">I turn ambiguous customer and workforce problems into structured systems that can be executed, measured, and improved.</h1>
      <p class="text-lg text-ink/75 leading-relaxed">My work combines complex program delivery, cross-functional operations, and practical AI-assisted workflows. I am particularly interested in how human expertise is sourced, evaluated, developed, and matched to the work emerging around AI.</p>
      <p class="text-[15px] text-ink/65 leading-relaxed border-l-2 border-accent pl-4">Proofworks and GTM Radar are independent projects showing how I approach changing labor demand, structured research, workflow design, and human-reviewed AI systems.</p>
    </div>
  </div>

  <!-- WHAT I BRING -->
  <div class="mt-14">
    <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-accent mb-7">What I bring</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-9">
      {brings.map((b) => (
        <div class="border-l-2 border-accent pl-5">
          <h3 class="font-serif text-2xl md:text-[1.6rem] leading-snug text-ink">{b.head}</h3>
          <p class="text-[15px] text-ink/70 leading-relaxed mt-2.5">{b.support}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-14">
    {fits.map((f) => (
      <div class="border-l-2 border-accent pl-4">
        <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-accent mb-2">{f.label}</p>
        <p class="text-[15px] text-ink/85 leading-relaxed">{f.body}</p>
      </div>
    ))}
  </div>
</section>

<script>
  // "Copy email" button — copies the address to the clipboard, no mail app needed
  const btn = document.getElementById('copy-email');
  const label = btn?.querySelector('.ce-text');
  const original = label?.textContent ?? '';
  btn?.addEventListener('click', async () => {
    const email = btn.getAttribute('data-email') ?? '';
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      const t = document.createElement('textarea');
      t.value = email; document.body.appendChild(t); t.select();
      document.execCommand('copy'); t.remove();
    }
    if (label) {
      label.textContent = 'Copied ✓';
      setTimeout(() => { label.textContent = original; }, 1800);
    }
  });
</script>
