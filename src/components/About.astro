---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.jpg';

const chips = [
  '$3M+/yr CPG accounts (Beyond Meat · Hormel · FIJI · POM · Wonderful Pistachios)',
  'AI workflow builder',
  'Comfortable as the human in the loop',
];
const fits = [
  { label: 'Stage', body: 'Pre-seed to Series C, AI-native or AI-adopting — full-time or contract, wherever the operator layer is still being built and the brief is still being written.' },
  { label: 'Roles', body: 'AI workflow builder · GTM intelligence · Recruiting intelligence · Implementation · Founder-led special projects' },
  { label: 'Profile', body: 'Seven years owning customer experience end-to-end on high-stakes programs — CPG accounts and live event production at scale.' },
];
---
<section id="about" class="py-20 border-t border-b border-rule scroll-mt-20">
  <div class="grid grid-cols-1 md:grid-cols-[160px_1fr] gap-8 md:gap-10 items-start">
    <Image src={headshot} alt="Kyle Findlay" width={320} height={320} class="rounded-xl w-[140px] h-[140px] md:w-[160px] md:h-[160px] object-cover border border-rule" />
    <div>
      <h2 class="font-serif text-2xl md:text-3xl leading-tight max-w-[640px]">
        Seven years owning the operator layer behind high-stakes programs — now building AI
        workflows that turn messy signals into systems a GTM team can use.
      </h2>
      <ul class="flex flex-wrap gap-2.5 mt-6">
        {chips.map((c) => (
          <li class="chip">{c}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-10">
    {fits.map((f) => (
      <div class="border-l-2 border-accent pl-4">
        <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-accent mb-2">{f.label}</p>
        <p class="text-[15px] text-ink/85 leading-relaxed">{f.body}</p>
      </div>
    ))}
  </div>
</section>
