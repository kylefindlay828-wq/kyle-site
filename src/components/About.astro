---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot.png';

const brings = [
  { head: '$8M+/yr CPG book of business', support: '$3M+ owned outright, $5–6M supported · FIJI · Hormel · Wonderful · Beyond Meat' },
  { head: 'Ships autonomous workflows', support: 'Owns the judgment calls, not just the demo' },
  { head: 'Translator between builders and revenue', support: 'Gets good ideas heard by leadership — and shipped' },
  { head: 'Builds at the application layer', support: 'Agentic systems inside your existing stack — your data stays yours' },
];
const fits = [
  { label: 'Stage', body: 'Pre-seed to Series C, AI-native or AI-adopting — full-time or contract, wherever the application layer is still being built and the brief is still being written.' },
  { label: 'Roles', body: 'Enablement & GTM systems · Agentic workflow builder · Recruiting intelligence' },
  { label: 'Profile', body: 'Seven years running customer experience end-to-end on high-stakes programs — CPG accounts and live event production at scale. Now building agentic systems at the application layer.' },
];
---
<section id="about" class="py-20 border-t border-b border-rule scroll-mt-20">
  <div class="grid grid-cols-1 md:grid-cols-[280px_1fr] gap-8 md:gap-10 items-start">
    <div class="rounded-xl overflow-hidden border border-rule w-[220px] h-[290px] md:w-[280px] md:h-[360px]">
      <Image src={headshot} alt="Kyle Findlay" width={600} height={750} class="w-full h-full object-cover object-top scale-[1.35] origin-top -translate-y-[12%]" />
    </div>
    <div class="max-w-[720px]">
      <h2 class="font-serif text-2xl md:text-3xl leading-tight">
        Models are becoming commodity cognition. The durable value is the application layer —
        AI deployed into real workflows, inside your stack, where your data stays yours.
      </h2>
      <p class="font-serif text-2xl md:text-3xl leading-tight mt-4">
        Seven years owning the operator layer behind high-stakes programs taught me how the
        work actually gets done.
      </p>
      <p class="font-serif text-2xl md:text-3xl leading-tight mt-4 text-ink">
        Now I build that layer.
      </p>
    </div>
  </div>

  <!-- WHAT I BRING -->
  <div class="mt-14">
    <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-accent mb-7">What I bring</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-9">
      {brings.map((b) => (
        <div class="border-l-2 border-accent pl-5">
          <h3 class="font-serif text-2xl md:text-[1.6rem] leading-snug text-ink">{b.head}</h3>
          <p class="text-[15px] text-ink/70 leading-relaxed mt-2.5">{b.support}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-14">
    {fits.map((f) => (
      <div class="border-l-2 border-accent pl-4">
        <p class="font-mono text-[12px] uppercase tracking-[0.07em] text-accent mb-2">{f.label}</p>
        <p class="text-[15px] text-ink/85 leading-relaxed">{f.body}</p>
      </div>
    ))}
  </div>
</section>
